{
  "$schema": "../../node_modules/wrangler/config-schema.json",

  // A real Cloudflare Worker, deployed separately from the flockoffmn Pages
  // project (top-level wrangler.jsonc). It exists only because a Cron
  // Trigger needs a Worker `main` — Pages Functions have no background
  // invocation, they only run on an inbound HTTP request. See index.mjs's
  // header comment and docs/DEPLOYMENT.md's "Flight sighting log (the
  // second exception)" section for the full rationale.
  //
  // This is the ONLY place in the whole project with a D1 write binding.
  // The top-level wrangler.jsonc has a read-only D1 binding for
  // functions/api/flight-log/* — this Worker is the other half.
  "name": "flockoffmn-flight-sightings-cron",
  "main": "index.mjs",
  "compatibility_date": "2026-07-30",

  "triggers": {
    "crons": ["*/10 * * * *"]
  },

  "d1_databases": [
    {
      "binding": "FLIGHT_SIGHTINGS_DB",
      "database_name": "flockoffmn-flight-sightings",
      "database_id": "90f43a8b-be4e-437c-ae31-097f1fc88a2b"
    }
  ]
}
