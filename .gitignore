# build output
dist/
# generated types
.astro/

# dependencies
node_modules/

# Cached upstream responses. The corridor build keeps the road tiles it fetched
# so a re-run does not ask a volunteer-run Overpass mirror for them again; they
# are reproducible from the ingest and are not part of the published data.
data/raw/

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# environment variables
.env
.env.production

# macOS-specific files
.DS_Store

# jetbrains setting folder
.idea/

# wrangler's local dev-server cache (created by `wrangler pages dev`)
.wrangler/

# NOTE: public/data/ is intentionally committed. The generated GeoJSON and CSV
# files are the published open datasets — they are the product, they make the
# repository reproducible without a network round trip, and committing them is
# what lets a fork or mirror serve the site immediately.
