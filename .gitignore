# build output
dist/
# generated types
.astro/

# dependencies
node_modules/

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# environment variables
.env
.env.production

# macOS-specific files
.DS_Store

# jetbrains setting folder
.idea/

# wrangler's local dev-server cache (created by `wrangler pages dev`)
.wrangler/

# NOTE: public/data/ is intentionally committed. The generated GeoJSON and CSV
# files are the published open datasets — they are the product, they make the
# repository reproducible without a network round trip, and committing them is
# what lets a fork or mirror serve the site immediately.

# Tile build scratch space (scripts/tiles/build-basemap.mjs): the downloaded
# OSM extract, planetiler itself, and the built .pmtiles archive. The archive
# ships to R2, not to git — see scripts/tiles/build-basemap.mjs's header.
.tiles-build/

# Ingest scratch space: raw upstream responses cached so a re-run doesn't
# re-ask volunteer-run infrastructure for data it already has (currently the
# per-agency Overpass road extracts alpr-reported.mjs geocodes against, which
# run to a few hundred megabytes). Reproducible from the network by deleting
# it and re-running the ingest; the *outputs* in public/data/ are what ships.
data/raw/
