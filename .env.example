# Base map tiles.
#
# The default points at OpenStreetMap's standard tile servers, which is fine
# for local development but NOT for production traffic — they are volunteer
# infrastructure and their usage policy asks apps not to rely on them at scale.
# Set your own before launch. See docs/DEPLOYMENT.md.
#
# Must be prefixed PUBLIC_ to reach the browser.
PUBLIC_TILE_URL=
PUBLIC_TILE_ATTRIBUTION=

# Ingest scope (optional, read by scripts/ingest/*).
# Defaults target Minnesota. The geocoding keys on Census identifiers, so
# changing these is most of what a different state needs.
#   STATE_FIPS=27
#   STATE_USPS=MN
#   STATE_ISO=US-MN
#   STATE_NAME=MINNESOTA
#   SCOPE=national   # ingest every state instead of one
