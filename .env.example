# Base map tiles.
#
# Optional. mapStyle.ts already defaults to this project's self-hosted
# PMTiles archive, so leaving this unset works out of the box for both
# `npm run dev` and a production build — there's no key to obtain, unlike
# the MapTiler setup this replaced. Set it only if you're running a fork
# against your own R2 bucket; see docs/DEPLOYMENT.md § Base map tiles for
# the build-and-upload runbook.
#
# Must be prefixed PUBLIC_ to reach the browser.
PUBLIC_TILES_URL=

# Ingest scope (optional, read by scripts/ingest/*).
# Defaults target Minnesota. The geocoding keys on Census identifiers, so
# changing these is most of what a different state needs.
#   STATE_FIPS=27
#   STATE_USPS=MN
#   STATE_ISO=US-MN
#   STATE_NAME=MINNESOTA
#   SCOPE=national   # ingest every state instead of one

# Census Bureau API key — the one exception to this project's "no keys"
# ingest promise. Required only by scripts/ingest/demographics.mjs (Black
# and Latinx population share, poverty rate); every other ingest script
# still runs key-free. Free, no cost, just an email address:
# https://api.census.gov/data/key_signup.html
CENSUS_API_KEY=
