---
import { Map, LocateFixed, Network, Megaphone, Database, BookOpen, Info, Ghost, Radar, Siren, BookLock } from 'lucide-astro';
import type { Locale } from '~/layers/types';
import { useTranslations, localePath, stripLocale, LOCALES, LOCALE_NAMES } from '~/lib/i18n';

interface Props {
  locale: Locale;
  /** See this component's own comment on the bottom-bar `<nav>` below. */
  fullBleed?: boolean;
}
const { locale, fullBleed = false } = Astro.props;
const t = useTranslations(locale);

const here = stripLocale(Astro.url.pathname);

/*
 * `spookyIcon` is optional and only set where a swap keeps the icon
 * recognizable at a glance — not a straight reskin of all seven. Both
 * icons render statically (see the markup below): which one is visible is
 * a pure CSS rule keyed on `[data-theme='halloween']` (global.css's
 * `.nav-icon-*` rules), the same "no client JS needed" approach the rest
 * of this component already uses for theme-band styling. That also means
 * it stays correct through the October-night auto-theme (theme.ts) and any
 * live theme switch, with nothing here needing to know about either.
 */
const links = [
  { href: '/', label: t('navMap'), shortLabel: t('navMapShort'), icon: Map, spookyIcon: Ghost },
  { href: '/near-me', label: t('navNearMe'), shortLabel: t('navNearMeShort'), icon: LocateFixed, spookyIcon: Radar },
  { href: '/explainer', label: t('navExplainer'), shortLabel: t('navExplainerShort'), icon: Network },
  { href: '/act', label: t('navAct'), shortLabel: t('navActShort'), icon: Megaphone, spookyIcon: Siren },
  { href: '/data', label: t('navData'), shortLabel: t('navDataShort'), icon: Database },
  { href: '/sources', label: t('navSources'), shortLabel: t('navSourcesShort'), icon: BookOpen, spookyIcon: BookLock },
  { href: '/about', label: t('navAbout'), shortLabel: t('navAboutShort'), icon: Info },
];

const isActive = (href: string) => (href === '/' ? here === '/' : here.startsWith(href));
---

{/*
  `nav-band` (both here and on the bottom icon bar below) is a light-mode-
  only ink-token override in global.css — the 2024 Minnesota flag's Night
  Sky Blue / Water Blue, matching wealldobettermn.org's own `.band`
  treatment of its header and mobile nav. Dark mode ignores the class
  entirely and stays the ordinary ink-900/ink-800 neutral.
*/}
<header class="nav-band relative z-30 border-b border-ink-800 bg-ink-900">
  <div class="mx-auto flex max-w-[1600px] flex-wrap items-center gap-x-4 gap-y-2 px-4 py-2.5">
    <a
      href={localePath(locale, '/')}
      class="flex shrink-0 items-center gap-2 font-semibold tracking-tight text-ink-100"
    >
      <svg viewBox="0 0 24 24" class="h-5 w-5 text-accent" aria-hidden="true" fill="none">
        <circle cx="12" cy="12" r="3.25" stroke="currentColor" stroke-width="1.75" />
        <path
          d="M12 2.5v3M12 18.5v3M2.5 12h3M18.5 12h3"
          stroke="currentColor"
          stroke-width="1.75"
          stroke-linecap="round"
        />
        <circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.25" opacity=".45" />
      </svg>
      <span>{t('siteName')}</span>
    </a>

    {/*
      Below `lg` this becomes the bottom icon bar (see the second <nav>
      below this header) instead — the scrolling row was reachable but
      nothing on a 320px phone signalled that seven links continued past
      the edge, and it cost the map real height on top of that (see
      #controls' own comment in MapView.astro for the same trade). At `lg`
      it's back to the row it's always been: the link list scrolls sideways
      rather than wrapping, so a label sliced mid-word at the right edge
      reads as a layout bug, not as an invitation, and the fades below mark
      whichever side still has links on it.
    */}
    <nav
      aria-label="Primary"
      data-nav-overflow="none"
      class="relative order-3 hidden w-full lg:order-0 lg:block lg:w-auto lg:flex-1"
    >
      <ul data-nav-scroller class="scroll-slim flex items-center gap-0.5 overflow-x-auto text-sm">
        {
          links.map((link) => (
            <li class="shrink-0">
              <a
                href={localePath(locale, link.href)}
                aria-current={isActive(link.href) ? 'page' : undefined}
                class:list={[
                  'block rounded px-2.5 py-1.5 transition-colors',
                  isActive(link.href)
                    ? 'bg-ink-800 text-ink-100'
                    : 'text-ink-300 hover:bg-ink-850 hover:text-ink-100',
                ]}
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="ml-auto flex shrink-0 items-center gap-1 text-sm">
      {
        LOCALES.map((code) => (
          <a
            href={localePath(code, here)}
            hreflang={code}
            lang={code}
            aria-current={code === locale ? 'true' : undefined}
            class:list={[
              'rounded px-2 py-1 transition-colors',
              code === locale
                ? 'bg-ink-800 text-ink-100'
                : 'text-ink-400 hover:bg-ink-850 hover:text-ink-100',
            ]}
          >
            {LOCALE_NAMES[code]}
          </a>
        ))
      }
    </div>
  </div>
</header>

{/*
  Below `lg`, the seven destination links move down here as icons rather
  than staying a second row of text at the top — a phone's thumb reach is
  the bottom of the screen, not the top, and an icon a reader already
  recognises (the map, a book) costs less width than its own label would,
  which is what makes room for a label under it instead of losing the
  label entirely to icon-only.

  Two different ways to sit at the bottom, matched to whether the page
  under it scrolls. The map page (`fullBleed`) manages its own
  non-scrolling layout already — see #controls' own comment in
  MapView.astro — so this reorders into the tail of that same flex column,
  landing directly beneath the search row for free, no coordinate math
  required. Every other page scrolls normally, so this has to be `fixed`
  to stay reachable regardless of scroll position; Base.astro's own
  padding-bottom is what keeps that page's last content, footer included,
  from ending up underneath it.
*/}
<nav
  aria-label="Primary"
  class:list={[
    'nav-band border-t border-ink-800 bg-ink-900 pb-[env(safe-area-inset-bottom)] lg:hidden',
    fullBleed ? 'order-last shrink-0' : 'fixed inset-x-0 bottom-0 z-40',
  ]}
>
  <ul class="flex items-stretch">
    {
      links.map((link) => (
        <li class="flex-1">
          <a
            href={localePath(locale, link.href)}
            aria-current={isActive(link.href) ? 'page' : undefined}
            class:list={[
              'flex flex-col items-center gap-0.5 px-1 py-2 text-center transition-colors',
              isActive(link.href) ? 'text-accent' : 'text-ink-300 hover:text-ink-100',
            ]}
          >
            <link.icon
              class:list={['h-5 w-5 shrink-0', link.spookyIcon && 'nav-icon-default']}
              aria-hidden="true"
              stroke-width={2}
            />
            {
              link.spookyIcon && (
                <link.spookyIcon class="nav-icon-halloween h-5 w-5 shrink-0" aria-hidden="true" stroke-width={2} />
              )
            }
            <span class="w-full truncate text-center text-[10px] leading-tight font-medium tracking-wide">
              {link.shortLabel}
            </span>
          </a>
        </li>
      ))
    }
  </ul>
</nav>

<script>
  /*
   * Which side of the primary nav still has links on it, as an attribute the
   * stylesheet can hang a fade on.
   *
   * A scroll listener rather than a scroll-driven animation: the CSS version
   * needs `scroll-timeline` and `timeline-scope`, which Firefox still does
   * not ship, and it would be the one piece of the site whose affordance
   * quietly went missing in a whole browser. This is a handful of lines that
   * work everywhere and will keep working.
   */
  for (const nav of document.querySelectorAll<HTMLElement>('[data-nav-overflow]')) {
    const scroller = nav.querySelector<HTMLElement>('[data-nav-scroller]');
    if (!scroller) continue;

    const sync = () => {
      // A pixel of slack: fractional layout leaves scrollLeft a hair short of
      // the true end on a fair number of zoom levels and device ratios, which
      // would otherwise pin the trailing fade on permanently.
      const atStart = scroller.scrollLeft <= 1;
      const atEnd = scroller.scrollLeft >= scroller.scrollWidth - scroller.clientWidth - 1;
      nav.dataset.navOverflow = atStart && atEnd ? 'none' : atStart ? 'end' : atEnd ? 'start' : 'both';
    };

    sync();
    scroller.addEventListener('scroll', sync, { passive: true });
    // Not a window resize listener: the row this sits in rewraps at `sm`, and
    // the labels themselves change length when the reader switches locale, so
    // the box being watched has to be the scroller itself.
    new ResizeObserver(sync).observe(scroller);
  }
</script>

