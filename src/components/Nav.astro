---
import type { Locale } from '~/layers/types';
import { useTranslations, localePath, stripLocale, LOCALES, LOCALE_NAMES } from '~/lib/i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useTranslations(locale);

const here = stripLocale(Astro.url.pathname);

const links = [
  { href: '/', label: t('navMap') },
  { href: '/near-me', label: t('navNearMe') },
  { href: '/explainer', label: t('navExplainer') },
  { href: '/flight-log', label: t('navFlightLog') },
  { href: '/act', label: t('navAct') },
  { href: '/data', label: t('navData') },
  { href: '/sources', label: t('navSources') },
  { href: '/about', label: t('navAbout') },
];

const isActive = (href: string) => (href === '/' ? here === '/' : here.startsWith(href));
---

<header class="relative z-30 border-b border-ink-800 bg-ink-900">
  <div class="mx-auto flex max-w-[1600px] flex-wrap items-center gap-x-4 gap-y-2 px-4 py-2.5">
    <a
      href={localePath(locale, '/')}
      class="flex shrink-0 items-center gap-2 font-semibold tracking-tight text-ink-100"
    >
      <svg viewBox="0 0 24 24" class="h-5 w-5 text-accent" aria-hidden="true" fill="none">
        <circle cx="12" cy="12" r="3.25" stroke="currentColor" stroke-width="1.75" />
        <path
          d="M12 2.5v3M12 18.5v3M2.5 12h3M18.5 12h3"
          stroke="currentColor"
          stroke-width="1.75"
          stroke-linecap="round"
        />
        <circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.25" opacity=".45" />
      </svg>
      <span>{t('siteName')}</span>
    </a>

    <nav aria-label="Primary" class="order-3 w-full sm:order-0 sm:w-auto sm:flex-1">
      <ul class="scroll-slim flex items-center gap-0.5 overflow-x-auto text-sm">
        {
          links.map((link) => (
            <li class="shrink-0">
              <a
                href={localePath(locale, link.href)}
                aria-current={isActive(link.href) ? 'page' : undefined}
                class:list={[
                  'block rounded px-2.5 py-1.5 transition-colors',
                  isActive(link.href)
                    ? 'bg-ink-800 text-ink-100'
                    : 'text-ink-300 hover:bg-ink-850 hover:text-ink-100',
                ]}
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="ml-auto flex shrink-0 items-center gap-1 text-sm">
      <!--
        Site-theme control for pages with no map to also theme (About,
        Sources, Flight log, …) — the map page's equivalent lives inside the
        map itself as a MapLibre corner control (src/lib/themeControl.ts),
        stacked with an in-map "Map theme" picker there. Same underlying
        popover section (src/lib/themeControlUI.ts's buildSiteThemeSection)
        either way, just a different host element, since only one of the two
        pages has a map to put a MapLibre control on. Built client-side by
        theme-control-nav.ts rather than server-rendered, matching how the
        map control is built — both use the same Lucide icon and the same
        `.theme-control-*` CSS, so this reads as "the same control,"
        wherever it appears, not two different ones.
      -->
      <div
        data-theme-control
        id="header-theme-control"
        class="relative mr-1 border-l border-ink-800 pl-2"
      >
      </div>

      {
        LOCALES.map((code) => (
          <a
            href={localePath(code, here)}
            hreflang={code}
            lang={code}
            aria-current={code === locale ? 'true' : undefined}
            class:list={[
              'rounded px-2 py-1 transition-colors',
              code === locale
                ? 'bg-ink-800 text-ink-100'
                : 'text-ink-400 hover:bg-ink-850 hover:text-ink-100',
            ]}
          >
            {LOCALE_NAMES[code]}
          </a>
        ))
      }
    </div>
  </div>
</header>

<script
  is:inline
  type="application/json"
  id="theme-toggle-strings"
  set:html={JSON.stringify({
    buttonLabel: t('themeButtonLabel'),
    sectionLabel: t('themeToggleGroupLabel'),
    light: t('themeLight'),
    dark: t('themeDark'),
  })}
/>

<script>
  /*
   * Site-theme control for pages with no map (see the comment on
   * #header-theme-control above). Builds the same icon-button-that-opens-a-
   * popover shape as the map's ThemeControl (src/lib/themeControl.ts),
   * using the same shared section builder (src/lib/themeControlUI.ts) —
   * just without a "Map theme" section, and hosted in a plain header div
   * instead of a MapLibre IControl container. State lives in
   * `document.documentElement.dataset.theme` and
   * `localStorage['flockoff:theme']` (src/lib/theme.ts) — nothing here
   * touches the map, `#detail-panel`, the record list, or `#map-status`
   * (spec: accessibility sync is off limits to this control).
   *
   * Imports from real modules on purpose, not just for reuse: a `<script>`
   * with no imports gets inlined directly into the HTML by Astro's
   * bundler, and this site's CSP (`script-src 'self'`, no `unsafe-inline`)
   * silently blocks that — the button would render but do nothing, with
   * only a console CSP violation to explain why.
   */
  import { createElement, Layers, type IconNode } from 'lucide';
  import { currentTheme, onThemeChange } from '~/lib/theme';
  import { buildSiteThemeSection, DEFAULT_SITE_THEME_STRINGS } from '~/lib/themeControlUI';

  const stringsEl = document.getElementById('theme-toggle-strings');
  const strings = stringsEl?.textContent
    ? (JSON.parse(stringsEl.textContent) as { buttonLabel: string; sectionLabel: string; light: string; dark: string })
    : { buttonLabel: 'Theme', ...DEFAULT_SITE_THEME_STRINGS };

  const host = document.getElementById('header-theme-control');
  if (host) {
    const button = document.createElement('button');
    button.type = 'button';
    button.setAttribute('class', 'rounded p-1.5 text-ink-400 transition-colors hover:bg-ink-850 hover:text-ink-100');
    button.setAttribute('aria-label', strings.buttonLabel);
    button.setAttribute('aria-haspopup', 'true');
    button.setAttribute('aria-expanded', 'false');
    button.appendChild(createElement(Layers as IconNode, { width: 18, height: 18 }));

    const panel = document.createElement('div');
    panel.setAttribute('class', 'theme-control-panel');
    panel.hidden = true;
    const siteTheme = buildSiteThemeSection(strings);
    panel.appendChild(siteTheme.el);

    function setOpen(open: boolean) {
      panel.hidden = !open;
      button.setAttribute('aria-expanded', String(open));
    }
    button.addEventListener('click', (e) => {
      e.stopPropagation();
      setOpen(panel.hidden !== false);
    });
    document.addEventListener('click', (e) => {
      if (!host.contains(e.target as Node)) setOpen(false);
    });

    host.appendChild(button);
    host.appendChild(panel);

    siteTheme.reflect(currentTheme());
    onThemeChange((theme) => siteTheme.reflect(theme));
  }
</script>
