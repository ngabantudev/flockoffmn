---
import type { NewsItem } from '~/lib/news';

interface Props {
  item: NewsItem;
  topicLabel: string;
  /** Already-formatted publication date. See NewsFeed.astro's `dateLabel`. */
  dateLabel: string;
  /** Rail uses smaller type than the archive. */
  compact: boolean;
}
const { item, topicLabel, dateLabel, compact } = Astro.props;
---

<li
  data-news-item
  data-published={item.published}
  data-topic={item.topic}
  class="border-b border-ink-850 py-3"
>
  {/*
    Source above headline, in accent caps — the source project's shape, and it
    is the right one: the outlet is how a reader decides whether to trust a
    headline before reading it, so it belongs before rather than after.
  */}
  <span class="mb-1 block text-[9px] font-bold tracking-wider text-accent uppercase">
    {item.source}
  </span>
  <h3 class:list={[compact ? 'text-xs' : 'text-sm', 'leading-snug font-medium']}>
    <a
      href={item.url}
      target="_blank"
      rel="noopener noreferrer nofollow"
      class="text-ink-100 hover:text-accent"
    >
      {item.title}
    </a>
  </h3>
  <span class="mt-1.5 flex flex-wrap items-center gap-x-2 text-[10px] font-medium text-ink-400">
    <span class="rounded border border-ink-700 px-1 py-px text-ink-300">{topicLabel}</span>
    <time datetime={item.published}>{dateLabel}</time>
  </span>
</li>
