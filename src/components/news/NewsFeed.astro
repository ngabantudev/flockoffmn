---
import { Newspaper } from 'lucide-astro';
import type { Locale } from '~/layers/types';
import { loadNews, groupByMonth, screenedTotal, type NewsTopic } from '~/lib/news';
import NewsItemRow from '~/components/news/NewsItemRow.astro';
import { useTranslations, localePath } from '~/lib/i18n';

interface Props {
  locale: Locale;
  /**
   * `rail` is the map page's right column; `full` is the /news archive.
   *
   * One component at two densities rather than two components, because the
   * only real differences are how many items are rendered and how much
   * explanatory copy surrounds them. Two implementations of the same list is
   * how the rail and the page end up disagreeing about what a story is.
   */
  density: 'rail' | 'full';
}
const { locale, density } = Astro.props;
const t = useTranslations(locale);
const rail = density === 'rail';

const archive = await loadNews();
const all = archive?.items ?? [];

/*
 * The rail renders a bounded slice; the archive renders everything.
 *
 * RAIL_LIMIT is a runaway guard, not the shape of the slice — the window logic
 * below decides that. It exists so a source that suddenly floods the feed can't
 * push an unbounded payload to phones that never render the rail.
 *
 * It was 60, which was too close to the working volume to be a guard. The
 * 30-day window held 61 stories on 2026-08-22, the cap bit by exactly one row,
 * `railSpanDays` floored to 26, and the 30D chip disappeared — the rail fell
 * back to a 7-day window and three weeks of coverage vanished to save one
 * headline. The degradation was designed and it fired correctly; the number was
 * simply set below the thing it was guarding.
 *
 * 200 is a real ceiling: roughly three times the current 30-day volume, and
 * measured at ~230 B gzipped per row, a full 200-row rail costs about 46 KB
 * against the map page's ~889 KB transfer. If it ever does bite, the same
 * honest fallback still happens — chips narrow to what the slice backs.
 */
const RAIL_LIMIT = 200;

/**
 * The longest window the rail offers.
 *
 * Thirty days. It was briefly seven, on a payload argument that used the wrong
 * denominator, and the correction is worth writing down because the reasoning
 * looked rigorous while being wrong.
 *
 * The rail is `xl`-only, so everything it renders ships to phones that never
 * display it, and that cost is real: measured gzipped on the map page, a
 * 30-day window is 9,755 B against 3,829 B for seven days. The mistake was
 * comparing that against the HTML document alone (~52 KB) and concluding a
 * 30-day rail added "roughly a fifth" to what a phone downloads.
 *
 * It does not. Measured on a 390px viewport against the deployed site, the map
 * page transfers about 889 KB — 466 KB of JavaScript and 375 KB of map data
 * before a single headline. The extra six kilobytes is 0.7% of that. §0.7 asks
 * that the reader on an old phone comes first, and it still does; it does not
 * ask for a 0.7% saving paid for by cutting three weeks of coverage out of the
 * panel.
 *
 * The window still has to land on a chip boundary — the chips below are
 * filtered to what the slice can actually back, so a 14-day window would render
 * a second week that no control could reach. Thirty is a boundary; fourteen is
 * not.
 */
const RAIL_WINDOW_DAYS = 30;

/*
 * The rail slices by WINDOW, then caps for payload. It used to slice by count,
 * and that was wrong in a way that would only have shown up later.
 *
 * A count-based slice makes every range chip a claim the slice cannot back: the
 * rail took the sixty most recent stories *regardless of date*, then offered a
 * "30D" chip that filtered those sixty and presented the result as a month. At
 * this feed's current volume the two coincide — sixty stories currently span
 * 245 days — which is exactly what makes it dangerous. At three stories a day
 * sixty items span twenty days, and "30D" silently starts showing two thirds of
 * what it promises, with nothing in the UI changing to say so.
 *
 * Slicing by window inverts that: the rail holds what the longest chip claims,
 * and the cap can only ever remove the *oldest* of those. `railSpanDays` then
 * reports what is genuinely covered, and the chips below are filtered to it, so
 * a chip can never outrun its data even if this feed becomes ten times busier.
 */
const windowCutoff = Date.now() - RAIL_WINDOW_DAYS * 86_400_000;
const inWindow = all.filter((i) => new Date(i.published).getTime() >= windowCutoff);
const cappedItems = inWindow.slice(0, RAIL_LIMIT);
const railCapped = inWindow.length > RAIL_LIMIT;

/**
 * Days the rail's rendered slice actually covers.
 *
 * The full window when the cap did not bite. When it did, the age of the oldest
 * story that survived it — which is the only period the rail can honestly
 * answer questions about.
 */
const railSpanDays = railCapped && cappedItems.length > 0
  ? Math.floor((Date.now() - new Date(cappedItems[cappedItems.length - 1].published).getTime()) / 86_400_000)
  : RAIL_WINDOW_DAYS;

/*
 * The archive groups by month; the rail does not.
 *
 * Grouping was in the first version of this page and was lost when the page and
 * the rail were merged into one component — leaving a flat list whose rows read
 * "Jan 27" across an archive spanning two Januaries. The heading is what
 * carries the year, and it is also the cheapest time axis on the page: §0.5
 * wants the shape over time visible, and an undifferentiated scroll of several
 * hundred headlines hides exactly that.
 *
 * A 24rem rail is the wrong place for it — headings every few rows in a narrow
 * column are noise — so the rail prints the year on the row instead, via
 * NewsItemRow's `showYear`.
 */
// Grouped once and used twice. `items === all` on the archive, so computing
// this separately for the headings and for the curve below read as if the two
// might describe different sets — they cannot, but only via that aliasing.
const byMonth = groupByMonth(all);
const monthGroups = rail ? [] : byMonth;
const currentYear = new Date().getUTCFullYear();

/*
 * Range options, matching the source project's chips.
 *
 * `0` means everything, and it is new here. mndatacenter tops out at 1Y
 * because a KV mirror only ever holds what the last fetch returned, so there
 * is no "all" for it to offer. This archive is cumulative and committed, so
 * "all" is a real answer and is the one that shows the curve.
 */
const ALL_RANGES = [
  { label: t('newsRange24h'), days: 1 },
  { label: t('newsRange7d'), days: 7 },
  { label: t('newsRange30d'), days: 30 },
  { label: t('newsRange1y'), days: 365 },
  { label: t('newsRangeAll'), days: 0 },
];

/*
 * The rail offers only the chips its rendered slice can actually back.
 *
 * Derived from `railSpanDays` rather than from a constant, so this stays true
 * without anyone remembering to revisit it: if the feed gets busy enough that
 * the payload cap starts biting into the 30-day window, the "30D" chip
 * disappears on its own rather than quietly under-reporting. The 24H chip is
 * always kept — with fewer than a day of stories the rail is nearly empty
 * anyway, and a control group with nothing in it is worse than one that says
 * zero.
 */
const RANGE_OPTIONS = rail
  ? ALL_RANGES.filter((o) => o.days === 1 || (o.days > 0 && o.days <= railSpanDays))
  : ALL_RANGES;

/*
 * Must be a range the chips actually offer, or the initial pressed state
 * matches no button and the rail opens with every chip unpressed while showing
 * a filter the reader cannot see or undo.
 */
const DEFAULT_DAYS = rail ? (RANGE_OPTIONS[RANGE_OPTIONS.length - 1]?.days ?? 1) : 0;

/*
 * The rendered slice is trimmed to the widest chip on offer, not just to the
 * payload cap.
 *
 * Filtering the chips to `railSpanDays` on its own left a gap the whole
 * arrangement exists to close. With more than RAIL_LIMIT stories in the window
 * and an oldest survivor 3.5 days old, `railSpanDays` floors to 3, no chip
 * above 24H qualifies, and two and a half days of rows are rendered, shipped,
 * and unreachable by any control — the count-based slice's failure with an
 * extra step in front of it.
 *
 * Trimming here makes the invariant hold in both directions: every rendered row
 * is reachable from some chip, and every chip is backed by rendered rows.
 */
const railCutoff = DEFAULT_DAYS > 0 ? Date.now() - DEFAULT_DAYS * 86_400_000 : -Infinity;
const railItems = cappedItems.filter((i) => new Date(i.published).getTime() >= railCutoff);

const items = rail ? railItems : all;

const TOPIC_LABELS: Record<NewsTopic, string> = {
  alpr: t('newsTopicAlpr'),
  surveillance: t('newsTopicSurveillance'),
  'immigration-enforcement': t('newsTopicImmigration'),
  detention: t('newsTopicDetention'),
  other: t('newsTopicOther'),
};

// Only offer a topic chip for a topic that actually has stories behind it. An
// empty facet is a dead control, and a dead control reads as a broken page.
const presentTopics = [...new Set(items.map((i) => i.topic))].sort(
  (a, b) => TOPIC_LABELS[a].localeCompare(TOPIC_LABELS[b]),
);

/*
 * The curve. §0.5's whole argument in one element.
 *
 * "It's only a few cameras" is answered with a curve, and this is the cheapest
 * honest one available: stories per month across the archive. It is coverage
 * volume, not deployment volume — the caption says so, because conflating the
 * two would be exactly the inferred claim §1c forbids.
 *
 * Server-rendered inline SVG with no script and no library: it cannot fail to
 * load, it prints, and it costs nothing on a phone.
 */
/*
 * Months with no coverage are drawn as zero rather than left out.
 *
 * `groupByMonth` only emits months that contain something, and the bars are
 * evenly spaced, so an omitted month is not a gap in the curve — it is invisible
 * and the months either side of it become neighbours. The committed archive
 * runs Sep 2024, Jan 2025, Mar 2025, Jul 2025, Oct 2025 …: fourteen groups
 * across a twenty-four-month span, drawn as fourteen adjacent bars under a
 * caption reading "September 2024 – August 2026". That is a smooth month-by-
 * month ramp asserted over four multi-month holes.
 *
 * §0.5 puts the curve on the page to show change over time, and §1c forbids
 * implying what the documents do not say. A month where this feed found nothing
 * is a real observation and belongs on the axis at zero.
 */
function monthsBetween(firstKey: string, lastKey: string): string[] {
  const [fy, fm] = firstKey.split('-').map(Number);
  const [ly, lm] = lastKey.split('-').map(Number);
  const keys: string[] = [];
  for (let y = fy, m = fm; y < ly || (y === ly && m <= lm); ) {
    keys.push(`${y}-${String(m).padStart(2, '0')}`);
    if (m === 12) { y += 1; m = 1; } else m += 1;
  }
  return keys;
}

const counts = new Map(byMonth.map((group) => [group.key, group.items.length]));
// byMonth is newest-first; a curve reads left to right.
const oldestKey = byMonth[byMonth.length - 1]?.key;
const newestKey = byMonth[0]?.key;
const series =
  oldestKey && newestKey
    ? monthsBetween(oldestKey, newestKey).map((key) => ({ key, count: counts.get(key) ?? 0 }))
    : [];
const peak = Math.max(1, ...series.map((s) => s.count));

/*
 * A zero month draws nothing. The 0.5 floor exists so a one-story month stays
 * visible against a busy peak; applying it to zero would render "none" as "a
 * little", which is the misreading the zero-filling above is here to prevent.
 */
const barHeight = (count: number) => (count === 0 ? 0 : Math.max(0.5, (count / peak) * SPARK_H));

const SPARK_W = 100;
const SPARK_H = 24;
const barGap = 1;
const barW = series.length > 0 ? Math.max(1, SPARK_W / series.length - barGap) : 0;

const monthFormatter = new Intl.DateTimeFormat(locale, {
  month: 'long',
  year: 'numeric',
  timeZone: 'UTC',
});
/*
 * Two row formatters, built once for the whole page.
 *
 * NewsItemRow used to construct an Intl.DateTimeFormat in its own frontmatter,
 * which runs per rendered row. Measured: constructing and formatting is ~125x
 * the cost of formatting on a reused instance, so a full archive build was
 * paying for hundreds of constructions to produce two distinct formats.
 *
 * `withYear` exists because the rail has no month headings to carry the year,
 * so a row from a previous year has to say so — see the `showYear` reasoning
 * that moved here with it.
 */
const rowDate = {
  bare: new Intl.DateTimeFormat(locale, { month: 'short', day: 'numeric', timeZone: 'UTC' }),
  withYear: new Intl.DateTimeFormat(locale, {
    month: 'short',
    day: 'numeric',
    year: 'numeric',
    timeZone: 'UTC',
  }),
};

/** Row date label: the archive's month headings carry the year, the rail's rows do not. */
function dateLabel(published: string, showYear: boolean): string {
  const at = new Date(published);
  return (showYear ? rowDate.withYear : rowDate.bare).format(at);
}

function monthLabel(key: string): string {
  const [year, month] = key.split('-').map(Number);
  return monthFormatter.format(new Date(Date.UTC(year, month - 1, 1)));
}

/*
 * Year ticks for the curve's axis.
 *
 * The caption states the span, which tells a reader the curve covers two years
 * but not which bar is which — with two dozen evenly spaced bars and no axis,
 * "when did this start climbing" has no answer you can read off. A label at
 * each year boundary gives every bar a rough date at a glance.
 *
 * Positioned as a percentage rather than drawn in the SVG because that SVG is
 * `preserveAspectRatio="none"` — it stretches to whatever width it is given, so
 * any text inside it stretches with it. HTML underneath stays the size it says
 * it is. The maths lines up exactly: a bar starts at `i * (barW + barGap)` out
 * of SPARK_W, and `barW + barGap` is `SPARK_W / series.length`, so bar `i`
 * begins at `i / series.length` of the width either way you compute it.
 */
const yearMarks = series
  .map((point, index) => ({ index, year: point.key.slice(0, 4) }))
  .filter((mark, i, all) => i === 0 || mark.year !== all[i - 1].year)
  .map((mark) => ({
    ...mark,
    pct: (mark.index / series.length) * 100,
  }));

const sparkCaption =
  series.length > 1
    ? `${t('newsCurveCaption')} ${monthLabel(series[0].key)} – ${monthLabel(series[series.length - 1].key)}`
    : '';

const screened = archive ? screenedTotal(archive) : 0;
---

<section
  id={rail ? 'news-rail' : 'news-archive'}
  data-news-feed
  data-default-days={DEFAULT_DAYS}
  aria-label={t('newsTitle')}
  class:list={[
    'flex min-h-0 flex-col',
    rail ? 'h-full overflow-hidden' : '',
  ]}
>
  {/* ------------------------------ Header ------------------------------ */}
  <div
    class:list={[
      'flex shrink-0 items-center gap-2.5',
      // `nav-band` is the site header's own light-mode flag treatment (Night
      // Sky Blue, light-mode only, dark untouched). The rail masthead is the
      // same kind of surface and mndatacenter heads its panel identically, so
      // it reuses the class rather than restating the colours.
      rail ? 'nav-band border-b border-ink-800 bg-ink-900 px-4 py-3' : 'pb-1',
    ]}
  >
    <span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-lg bg-ink-800">
      <Newspaper size={14} stroke-width={2} class="text-accent" />
    </span>
    <div class="min-w-0 flex-1">
      {
        rail ? (
          <h2 class="text-[10px] leading-none font-bold tracking-wider text-ink-100 uppercase">
            {t('newsRailTitle')}
          </h2>
        ) : (
          <h1 class="text-2xl font-semibold tracking-tight text-ink-100 sm:text-3xl">
            {t('newsTitle')}
          </h1>
        )
      }
    </div>
  </div>

  {!rail && <p class="prose-civic mt-3">{t('newsIntro')}</p>}

  {/*
    ------------------------------ Filters ------------------------------
    Directly under the masthead, and the range chips get a band of their own.

    They used to sit below the Tier 4 notice and the curve, which buried the
    one control most readers reach for and made the top of the rail read as
    three stacked paragraphs. mndatacenter puts its range selector in a
    distinct strip immediately under the panel header — chrome, visibly not the
    first article — and that is the right shape: the chips are how you drive
    the panel, so they belong where a toolbar belongs.

    The topic facet gets a section of its own below it, on the panel surface
    rather than in the charcoal strip. Two control groups sharing one band read
    as one long row of pills where nothing says which axis a given pill belongs
    to — the range is time, the facet is subject, and mixing them makes both
    harder to scan. Putting the facet on the panel also means its active pill
    picks up the panel's own accent rather than the strip's Water Blue, so each
    group is coloured by the surface it sits on.

    Still hidden until the script reveals them, which is the progressive-
    enhancement contract: with no JS the reader gets every story in the archive
    and no controls that do nothing.
  */}
  <div
    data-news-controls
    hidden
    class:list={['shrink-0', rail ? '' : 'mt-6']}
  >
    {/*
      The band. `bg-ink-950` against the rail's own `bg-ink-900` is the third
      surface that makes this read as chrome rather than as content — the same
      job mndatacenter's `.band-sub` does between its navy header and its
      off-white list.
    */}
    <div
      role="group"
      aria-label={t('newsRangeLabel')}
      class:list={[
        'flex flex-wrap items-center gap-1.5',
        rail ? 'news-band-sub border-b border-ink-800 bg-ink-950 px-4 py-2.5' : '',
      ]}
    >
      {
        RANGE_OPTIONS.map((opt) => (
          <button
            type="button"
            data-news-range
            data-days={opt.days}
            aria-pressed={opt.days === DEFAULT_DAYS ? 'true' : 'false'}
            class="inline-flex min-h-6 items-center rounded-full border border-ink-700 px-3 py-1 text-[9px] font-bold tracking-wider text-ink-400 uppercase transition-colors hover:text-ink-100"
          >
            {opt.label}
          </button>
        ))
      }
      {/*
        `data-news-label` rather than the script building the phrase: this is
        the one string here that has to be translated, and a live region that
        announced a bare "60" told a screen-reader user a number with no noun
        attached to it.
      */}
      <span
        data-news-status
        data-news-label={t('newsShownSuffix')}
        role="status"
        aria-live="polite"
        class="ml-auto text-[9px] tracking-wider text-ink-400 uppercase"
      />
    </div>

    {
      presentTopics.length > 1 && (
        <div
          role="group"
          aria-label={t('newsTopicLabel')}
          class:list={[
            'flex flex-wrap items-center gap-1.5',
            rail ? 'border-b border-ink-800 bg-ink-900 px-4 py-2.5' : 'mt-3',
          ]}
        >
          <button
            type="button"
            data-news-topic
            data-topic="all"
            aria-pressed="true"
            class="inline-flex min-h-6 items-center rounded-full border border-ink-700 px-2.5 py-1 text-[9px] font-medium tracking-wide text-ink-400 transition-colors hover:text-ink-100"
          >
            {t('newsTopicAll')}
          </button>
          {presentTopics.map((topic) => (
            <button
              type="button"
              data-news-topic
              data-topic={topic}
              aria-pressed="false"
              class="inline-flex min-h-6 items-center rounded-full border border-ink-700 px-2.5 py-1 text-[9px] font-medium tracking-wide text-ink-400 transition-colors hover:text-ink-100"
            >
              {TOPIC_LABELS[topic]}
            </button>
          ))}
        </div>
      )
    }
  </div>


  {/*
    The Tier 4 notice, archive only, and not dismissible there.

    §3 makes journalism a lead list and never the sole basis of a feature, and
    the archive page is where that gets said properly — a heading, the reason,
    and links to the map and the sources page.

    The rail used to carry a one-line version too. It is gone because it
    restated what the rail already shows: the masthead says "Related MN
    coverage", every row leads with its outlet in accent caps, and the foot of
    the panel links to the archive where the full notice lives. Tier 4 is also
    stamped per item in news.json, named on the Open data card, and explained
    in its own section on Sources. A caveat repeated in a sixth place beside
    eight headlines is one a reader learns to skip, which costs more than it
    buys — and it was taking vertical space from the stories themselves.
  */}
  {
    !rail && (
      <aside class="news-notice mt-6 shrink-0 rounded-lg border p-4" role="note">
        <h2 class="news-notice-strong text-sm font-semibold">{t('newsTierTitle')}</h2>
        <p class="mt-1.5 text-sm leading-relaxed text-ink-200">{t('newsTierWarning')}</p>
        <p class="mt-2 text-sm leading-relaxed text-ink-300">
          {t('newsTierPointer')}{' '}
          <a class="text-accent underline underline-offset-2" href={localePath(locale, '/')}>
            {t('navMap')}
          </a>{' '}
          {t('newsTierPointerAnd')}{' '}
          <a class="text-accent underline underline-offset-2" href={localePath(locale, '/sources')}>
            {t('navSources')}
          </a>.
        </p>
      </aside>
    )
  }

  {/*
    The curve. Rail gets it too — it is 24px tall and it is the one thing here
    the map cannot already show.
  */}
  {
    series.length > 1 && (
      <figure
        class:list={['shrink-0', rail ? 'border-b border-ink-800 px-4 py-2.5' : 'mt-6']}
      >
        <svg
          viewBox={`0 0 ${SPARK_W} ${SPARK_H}`}
          preserveAspectRatio="none"
          class:list={['w-full', rail ? 'h-6' : 'h-16']}
          role="img"
          aria-label={`${t('newsCurveAlt')} ${series.map((s) => `${monthLabel(s.key)}: ${s.count}`).join(', ')}`}
        >
          {series.map((point, i) => (
            <rect
              x={i * (barW + barGap)}
              y={SPARK_H - (point.count / peak) * SPARK_H}
              width={barW}
              height={barHeight(point.count)}
              class="fill-accent/70"
            />
          ))}
        </svg>
        {/*
          The axis. `aria-hidden` because the SVG's own aria-label already reads
          every month and its count in order — a screen reader that has heard
          "September 2024: 0, October 2024: 1 …" does not also need three loose
          years, and the ticks carry no information that list does not.

          A mark in the last eighth of the width is anchored to the right edge
          instead, so a series that happens to start a new year in its final
          months prints "2027" inside the panel rather than off it.
        */}
        <div
          class:list={['relative', rail ? 'mt-0.5 h-3' : 'mt-1 h-4']}
          aria-hidden="true"
        >
          {yearMarks.map((mark) => (
            <span
              class:list={[
                'absolute top-0 tabular-nums text-ink-400',
                rail ? 'text-[8px]' : 'text-[10px]',
              ]}
              style={mark.pct > 87.5 ? 'right: 0' : `left: ${mark.pct}%`}
            >
              {mark.year}
            </span>
          ))}
        </div>

        <figcaption
          class:list={[
            'text-ink-400',
            rail ? 'mt-0.5 text-[9px] leading-snug' : 'mt-1 text-xs leading-relaxed',
          ]}
        >
          {sparkCaption}
        </figcaption>
      </figure>
    )
  }

  {/* ------------------------------- List ------------------------------- */}
  <div
    class:list={[
      rail ? 'scroll-slim min-h-0 flex-1 overflow-y-auto px-4 py-3' : 'mt-6',
    ]}
  >
    {
      !archive && (
        <p class="rounded-lg border border-ink-700 bg-ink-900 p-4 text-sm text-ink-300">
          {t('newsEmpty')}
        </p>
      )
    }

    {/*
      A rail with nothing in its window is a real state now that the slice is
      time-bounded rather than count-bounded — a quiet month empties it. Said
      here rather than left to the script, which bails before rendering
      anything when there are no rows to filter, leaving a header and a chip
      group above blank space.
    */}
    {
      rail && archive && items.length === 0 && (
        <p class="py-6 text-center text-xs leading-relaxed text-ink-400">
          {t('newsNoneRecent')}
        </p>
      )
    }

    {
      rail ? (
        <ol class="space-y-0">
          {items.map((item) => (
            <NewsItemRow
              item={item}
                          topicLabel={TOPIC_LABELS[item.topic]}
              dateLabel={dateLabel(item.published, new Date(item.published).getUTCFullYear() !== currentYear)}
              compact={true}
            />
          ))}
        </ol>
      ) : (
        monthGroups.map((group) => (
          <section data-news-month class="mt-8 first:mt-0">
            <h2 class="border-b border-ink-800 pb-1.5 text-lg font-semibold text-ink-100">
              {monthLabel(group.key)}
            </h2>
            <ol class="mt-1 space-y-0">
              {group.items.map((item) => (
                <NewsItemRow
                  item={item}
                                  topicLabel={TOPIC_LABELS[item.topic]}
                  dateLabel={dateLabel(item.published, false)}
                  compact={false}
                />
              ))}
            </ol>
          </section>
        ))
      )
    }

    <p
      data-news-none
      hidden
      class="py-6 text-center text-xs text-ink-400"
    >
      {t('newsNoneInRange')}
    </p>
  </div>

  {/*
    §3 coverage honesty at the rail's own scale: when the payload cap trims the
    window, the rail is showing less than its longest chip claims and has to say
    so rather than let the reader assume they have seen the month.
  */}
  {
    rail && railCapped && (
      <p class="shrink-0 border-t border-ink-800 px-4 py-2 text-[9px] leading-snug text-ink-400">
        {t('newsRailCapped')}
      </p>
    )
  }

  {
    rail && (
      <a
        href={localePath(locale, '/news')}
        class="shrink-0 border-t border-ink-800 px-4 py-2.5 text-center text-[10px] font-semibold tracking-wider text-ink-300 uppercase transition-colors hover:text-accent"
      >
        {t('newsOpenArchive')}
      </a>
    )
  }

  {/* ------------------------- Coverage honesty ------------------------- */}
  {
    !rail && archive && (
      <section class="mt-12 rounded-lg border border-ink-700 bg-ink-900 p-5">
        <h2 class="text-lg font-semibold text-ink-100">{t('newsCoverageTitle')}</h2>
        <ul class="prose-civic mt-3 list-disc space-y-2 pl-5 text-sm">
          {archive.coverage.map((line) => (
            <li>{line}</li>
          ))}
          {archive.knownGaps.map((line) => (
            <li>{line}</li>
          ))}
        </ul>
        <p class="mt-4 border-t border-ink-800 pt-4 text-sm leading-relaxed text-ink-300">
          {t('newsScreenedPrefix')} <strong class="text-ink-100">{screened}</strong>{' '}
          {t('newsScreenedSuffix')}
        </p>
        <p class="mt-3 text-xs leading-relaxed text-ink-400">{archive.metadata.license}</p>
      </section>
    )
  }
</section>

<script>
  /*
   * Range and topic filtering, entirely in the document.
   *
   * THE ONE DESIGN DECISION HERE, and the reason this is ~70 lines where the
   * project it was ported from needs ~600: there is no fetch. The whole archive
   * is already in the page, so switching range is a class toggle rather than a
   * network round trip. Everything the original needs to manage — a loading
   * skeleton, an outage panel, a stale-copy banner with an age, a retry button,
   * a partial-range notice, a session pool of items accumulated across fetches
   * so re-sorting doesn't lose earlier results — describes states that cannot
   * occur here. Porting them would ship code that can never run, and a "showing
   * saved headlines from 3 hours ago" banner over a build-time snapshot would
   * be false rather than merely dead.
   *
   * Consequences worth stating, because they are the argument for doing it this
   * way: switching range is instant rather than seconds, it works offline, and
   * it cannot fail. The controls are revealed by this script, so with no
   * JavaScript the reader gets the complete list and no controls that do
   * nothing — which the original cannot offer, its list being a fetch result.
   */
  const PILL_ON = ['text-accent', 'border-accent/30', 'bg-accent/10'];
  const PILL_OFF = ['text-ink-400', 'border-ink-700'];

  function setPressed(btn: HTMLElement, on: boolean): void {
    btn.setAttribute('aria-pressed', String(on));
    btn.classList.add(...(on ? PILL_ON : PILL_OFF));
    btn.classList.remove(...(on ? PILL_OFF : PILL_ON));
  }

  for (const root of document.querySelectorAll<HTMLElement>('[data-news-feed]')) {
    const controls = root.querySelector<HTMLElement>('[data-news-controls]');
    const status = root.querySelector<HTMLElement>('[data-news-status]');
    const none = root.querySelector<HTMLElement>('[data-news-none]');
    const items = [...root.querySelectorAll<HTMLElement>('[data-news-item]')];
    const months = [...root.querySelectorAll<HTMLElement>('[data-news-month]')];
    if (!controls || items.length === 0) continue;

    // Revealed only now: before this line the controls are `hidden`, so a
    // reader with no JavaScript never sees a chip that would not respond.
    controls.hidden = false;

    let days = Number(root.dataset.defaultDays ?? 0);
    let topic = 'all';

    const apply = () => {
      // Computed once per apply rather than per item — 700 `Date.now()` calls
      // to answer one question is the kind of thing that shows up on the phone
      // this page is built for.
      const cutoff = days > 0 ? Date.now() - days * 86_400_000 : -Infinity;

      for (const item of items) {
        const at = new Date(item.dataset.published ?? '').getTime();
        const inRange = !Number.isFinite(at) || at >= cutoff;
        const inTopic = topic === 'all' || item.dataset.topic === topic;
        const visible = inRange && inTopic;
        item.hidden = !visible;
      }

      // A month heading with every row beneath it filtered away is a heading
      // for nothing, and on the archive that reads as a gap in the record
      // rather than as a filter doing its job.
      for (const section of months) {
        const anyVisible = [...section.querySelectorAll<HTMLElement>('[data-news-item]')].some(
          (item) => !item.hidden,
        );
        section.hidden = !anyVisible;
      }

      /*
       * `first:`/`last:` are compile-time positions and know nothing about
       * `hidden`, so after a filter the first visible row kept its top padding
       * and the last kept its bottom rule — a stray divider under the final
       * story. Applied here instead, against what is actually on screen.
       */
      const visible = items.filter((item) => !item.hidden);
      const shown = visible.length;
      for (const item of items) item.classList.remove('pt-0', 'border-b-0');
      visible[0]?.classList.add('pt-0');
      visible[visible.length - 1]?.classList.add('border-b-0');

      if (none) none.hidden = shown > 0;
      // Announced politely rather than silently, because the list it describes
      // changes with no other cue a screen reader would pick up.
      if (status) {
        const suffix = status.dataset.newsLabel ?? '';
        status.textContent = suffix ? `${shown} ${suffix}` : String(shown);
      }
    };

    controls.addEventListener('click', (event) => {
      const btn = (event.target as HTMLElement).closest<HTMLElement>(
        '[data-news-range], [data-news-topic]',
      );
      if (!btn) return;

      const group = btn.hasAttribute('data-news-range') ? 'data-news-range' : 'data-news-topic';
      for (const sibling of controls.querySelectorAll<HTMLElement>(`[${group}]`)) {
        setPressed(sibling, sibling === btn);
      }

      if (group === 'data-news-range') days = Number(btn.dataset.days ?? 0);
      else topic = btn.dataset.topic ?? 'all';

      apply();
    });

    // Paint the initial pressed state through the same path that handles a
    // click, so the two can't style the same state differently.
    for (const btn of controls.querySelectorAll<HTMLElement>('[data-news-range]')) {
      setPressed(btn, Number(btn.dataset.days) === days);
    }
    for (const btn of controls.querySelectorAll<HTMLElement>('[data-news-topic]')) {
      setPressed(btn, (btn.dataset.topic ?? 'all') === topic);
    }
    apply();
  }
</script>
