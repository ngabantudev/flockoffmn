---
import type { Locale } from '~/layers/types';
import { useTranslations, localePath } from '~/lib/i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useTranslations(locale);

// Client-side labels, keyed exactly like the `agency` attribute values in
// agency-aircraft.geojson — see src/layers/registry.ts's categoryColors.
const agencyLabels = {
  state_patrol: t('agencyLabelStatePatrol'),
  dnr_enforcement: t('agencyLabelDnrEnforcement'),
  ice_air: t('agencyLabelIceAir'),
  bca: t('agencyLabelBca'),
  county_sheriff: t('agencyLabelCountySheriff'),
  cbp: t('agencyLabelCbp'),
  mn_army_national_guard: t('agencyLabelMnArmyNationalGuard'),
};
---

<!--
  A sitewide, always-visible counter — not just a map-panel filter — because
  the whole point is a reader on any page sees it without having to know the
  map exists. It never says "deportation flight": ice_air only ever proves an
  aircraft belongs to a company under an ICE Air charter contract, not that a
  given flight is an active mission (see agency_aircraft's limitations). The
  caveat stays visible text, not a hover-only tooltip, so it reaches keyboard,
  touch and screen-reader readers the same as anyone else.
-->
<div
  id="live-aircraft-banner"
  class="border-b border-ink-800 bg-ink-950 px-4 py-1.5 text-xs text-ink-300"
  aria-live="polite"
>
  <a
    href={localePath(locale, '/')}
    class="mx-auto flex max-w-[1600px] flex-wrap items-center gap-x-2 gap-y-0.5 hover:text-ink-100"
  >
    <span class="inline-flex items-center gap-1.5 font-semibold text-ink-100">
      <span class="h-1.5 w-1.5 shrink-0 rounded-full bg-emerald-400" aria-hidden="true"></span>
      <span data-role="count">{t('liveBannerLoading')}</span>
    </span>
    <span data-role="caveat" class="text-ink-500"></span>
  </a>
</div>

<script is:inline define:vars={{ agencyLabels, countTemplate: t('liveBannerCount'), caveatText: t('liveBannerCaveat'), unavailable: t('liveBannerUnavailable') }}>
  const el = document.getElementById('live-aircraft-banner');
  const countEl = el?.querySelector('[data-role="count"]');
  const caveatEl = el?.querySelector('[data-role="caveat"]');

  async function updateBanner() {
    if (!countEl) return;
    try {
      const res = await fetch('/data/agency-aircraft.geojson', { cache: 'no-store' });
      if (!res.ok) throw new Error(String(res.status));
      const data = await res.json();
      const inMn = (data.features ?? []).filter((f) => f.properties?.attributes?.inMinnesota === true);

      const counts = {};
      for (const f of inMn) {
        const agency = f.properties.attributes.agency;
        counts[agency] = (counts[agency] ?? 0) + 1;
      }
      const breakdown = Object.entries(counts)
        .filter(([, n]) => n > 0)
        .map(([agency, n]) => `${n} ${agencyLabels[agency] ?? agency}`)
        .join(', ');

      countEl.textContent = countTemplate.replace('{count}', String(inMn.length)) + (breakdown ? ` (${breakdown})` : '');
      if (caveatEl) caveatEl.textContent = caveatText;
    } catch {
      // Fails open to a plain, honest "unavailable" line rather than a stale
      // or blank count that could read as "zero confirmed".
      countEl.textContent = unavailable;
      if (caveatEl) caveatEl.textContent = '';
    }
  }

  updateBanner();
  // The underlying data only refreshes hourly server-side; polling more
  // often than this would just re-read the same file without learning
  // anything new, so this exists to catch a long-open tab, not to chase
  // freshness the source doesn't have.
  setInterval(updateBanner, 5 * 60 * 1000);
</script>
