---
/**
 * One layer's row in the panel — the checkbox, label, feature count, the
 * cross-listed/near-miss legend rows, and the filters disclosure.
 *
 * Extracted out of MapView.astro's layerGroups.map() unchanged (same markup,
 * same data- attributes every client-side selector already targets) so it
 * can be called more than once: a flat category renders it once per layer
 * directly under its `<ul>`, same as before; a category with subgroups (see
 * LAYER_CATEGORIES' own comment on that field) renders it once per layer
 * inside each subgroup's own nested `<details>` instead. No client-side
 * script needed to know the difference — `[data-layer-toggle]`,
 * `[data-filter-layer]` etc. are found by attribute regardless of how deep
 * they're nested, which is what let this split out with zero changes to
 * mapController.ts or MapView.astro's own inline script.
 */
import type { Locale } from '~/layers/types';
import { useTranslations } from '~/lib/i18n';
import type { ClientLayer } from '~/lib/mapController';

interface Props {
  layer: ClientLayer & { featureCount: number };
  locale: Locale;
}
const { layer, locale } = Astro.props;
const t = useTranslations(locale);
---

<li class="rounded-lg border border-ink-800 bg-ink-850">
  <div class="flex items-start gap-2.5 p-2.5">
    <input
      type="checkbox"
      id={`layer-${layer.id}`}
      data-layer-toggle={layer.id}
      checked={layer.defaultOn}
      class="mt-0.5 h-4 w-4 shrink-0 accent-current"
      style={`color:var(--layer-color-${layer.id})`}
    />
    <div class="min-w-0 flex-1">
      <label for={`layer-${layer.id}`} class="flex cursor-pointer items-center gap-2 text-sm font-medium text-ink-100">
        <span
          class="h-2.5 w-2.5 shrink-0 rounded-full"
          style={`background:var(--layer-color-${layer.id})`}
          aria-hidden="true"
        />
        <span class="min-w-0">{layer.label}</span>
      </label>
      <p class="mt-1 text-xs leading-snug text-ink-400">{layer.summary}</p>
      <p class="mt-1 font-mono text-[11px] text-ink-400">
        <span data-count={layer.id}>0</span>
        <span> {t('ofTotal')} </span>
        <span>{layer.featureCount}</span>
      </p>
    </div>
  </div>

  {/*
    "Cross-listed corner" static legend row (§4 of the spec this shipped
    from). Not a FilterDefinition — nothing here is checkable or wired into
    the filter system, it only explains what the brass ring on some of this
    layer's points means. Real DOM text, not an aria-hidden canvas
    decoration, so it's reachable by a screen reader on its own.
  */}
  {layer.crossSource && (
    <div class="flex items-start gap-2 border-t border-ink-800 px-2.5 py-2">
      <span
        class="mt-0.5 h-2.5 w-2.5 shrink-0 rounded-full border-2 border-cross-source-ring bg-ink-700"
        aria-hidden="true"
      />
      <p class="text-[11px] leading-snug text-ink-400">{layer.crossSource.legend}</p>
    </div>
  )}

  {/*
    "Near miss" static legend row — a second, subordinate swatch, thinner
    ring at half opacity, same brass hue as the match ring above rather than
    a new colour. Only rendered where the registry names copy for it (today,
    alpr_reported only — see LayerDefinition.crossSource.nearMiss's own
    comment on why the OSM side has no use for this key).
  */}
  {layer.crossSource?.nearMiss && (
    <div class="flex items-start gap-2 border-t border-ink-800 px-2.5 py-2">
      <span
        class="mt-0.5 h-2.5 w-2.5 shrink-0 rounded-full border border-cross-source-ring bg-ink-700 opacity-55"
        aria-hidden="true"
      />
      <p class="text-[11px] leading-snug text-ink-400">{t('crossListedNearMissLegend')}</p>
    </div>
  )}

  {layer.filters.length > 0 && (
    <details class="border-t border-ink-800">
      <summary class="cursor-pointer px-2.5 py-1.5 text-xs text-ink-400 hover:text-ink-100">{t('filters')}</summary>
      <div class="space-y-2.5 px-2.5 pb-2.5">
        {layer.filters.map((filter) => (
          <fieldset>
            <legend class="mb-1 text-[11px] font-semibold tracking-wide text-ink-400 uppercase">{filter.label}</legend>
            <div class="space-y-1">
              {filter.values.map((value) => (
                <label class="flex cursor-pointer items-start gap-2 text-xs text-ink-200">
                  <input
                    type="checkbox"
                    data-filter-layer={layer.id}
                    data-filter-key={filter.key}
                    value={value}
                    checked={!filter.defaultExcluded!.includes(value)}
                    class="mt-0.5 h-3.5 w-3.5 shrink-0"
                  />
                  {/*
                    Where this filter is the same attribute the map colours
                    by, each value carries its ground colour, so the toggle
                    and the fill read as one system.
                  */}
                  {layer.categoryColors?.key === filter.key && (
                    <span
                      class="mt-1 h-2 w-2 shrink-0 rounded-sm"
                      style={`background:${
                        layer.categoryColors.colors.find((c) => c.value === value)?.color ?? layer.categoryColors.fallback
                      }`}
                      aria-hidden="true"
                    />
                  )}
                  <span class="min-w-0">
                    {value}
                    {filter.valueDescriptions?.[value] && (
                      <span class="block text-[10px] leading-snug text-ink-400">{filter.valueDescriptions[value]}</span>
                    )}
                  </span>
                </label>
              ))}
            </div>
          </fieldset>
        ))}
      </div>
    </details>
  )}
</li>
