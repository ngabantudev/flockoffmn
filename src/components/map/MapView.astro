---
import type { Locale } from '~/layers/types';
import { loadAllLayers, distinctValues } from '~/layers/data';
import { LAYER_CATEGORIES } from '~/layers/registry';
import { useTranslations, pick, localePath } from '~/lib/i18n';
import { labelForDetailField } from '~/lib/detailFields';
import { FILTER_INPUT_THRESHOLD } from '~/lib/filterQuery.mjs';
import { fillTemplate as fillStatic } from '~/lib/template.mjs';
import CompareView from '~/components/map/CompareView.astro';
import NewsFeed from '~/components/news/NewsFeed.astro';
import type { ClientLayer } from '~/lib/mapController';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useTranslations(locale);

const loaded = await loadAllLayers();

/**
 * A `nearMe.list.detail` key must also be a `detailFields` entry, so its
 * label is written once — the same guard NearMe.astro's own `labelFor`
 * applies to this identical registry block, shared via labelForDetailField
 * (see that function's own comment) rather than reimplemented, so a
 * registry typo fails the build with identical wording from either surface
 * instead of a near-me list row silently rendering "undefined: 3".
 */
function labelForNearMeDetail(d: (typeof loaded)[number]['definition'], key: string): string {
  return labelForDetailField(d, key, 'nearMe.list.detail', locale);
}

// Serialise only what the browser needs. Filter values are computed at build
// time from the real data, so the controls can never offer a value that no
// record has.
//
// Checked against ClientLayer (plus the featureCount this template and the
// browser both read straight off these objects, but which isn't part of
// ClientLayer itself — see the read-site cast below) via `satisfies` rather
// than a `: ClientLayer[]` annotation, so a field mismatch here — including
// an I18nString slipping through unflattened — is a type error, without
// losing the extra properties (`featureCount`, and anything a future layer
// adds) that a direct annotation's excess-property check would reject.
const clientLayers = loaded.map(({ definition: d, collection }) => ({
  id: d.id,
  category: d.category,
  defaultOn: d.defaultOn ?? false,
  label: pick(d.label, locale),
  summary: pick(d.summary, locale),
  whatThisMeans: pick(d.whatThisMeans, locale),
  geometryNote: d.geometryNote ? pick(d.geometryNote, locale) : undefined,
  limitations: d.limitations.map((l) => pick(l, locale)),
  impactSpheres: d.impactSpheres?.map((s) => ({
    icon: s.icon,
    title: pick(s.title, locale),
    color: s.color,
    body: pick(s.body, locale),
    citation: s.citation,
    // The registry cannot know the locale, so an internal citation is written
    // as a sentinel there and resolved to a real, locale-correct path here —
    // the one place in the pipeline that has both.
    citationUrl: s.citationUrl === 'internal:sources' ? localePath(locale, '/sources') : s.citationUrl,
    citation2: s.citation2,
    citation2Url: s.citation2Url,
  })),
  color: d.color,
  colorLight: d.colorLight,
  pointStrokeColor: d.pointStrokeColor,
  geometry: d.geometry,
  // The panel's order is the draw order. Reading it off LAYER_CATEGORIES here
  // means a category can be moved, renamed or inserted in one place and the
  // map restacks itself to match, instead of the two drifting apart silently.
  stackRank: LAYER_CATEGORIES.findIndex((c) => c.id === d.category),
  bearingKey: d.bearingKey,
  scale: d.scale,
  blockAggregate: d.blockAggregate,
  levelOfDetail: d.levelOfDetail,
  categoryColors: d.categoryColors
    ? {
        key: d.categoryColors.key,
        label: pick(d.categoryColors.label, locale),
        colors: d.categoryColors.colors,
        fallback: d.categoryColors.fallback,
        showOnMapKey: d.categoryColors.showOnMapKey,
      }
    : undefined,
  labelBy: d.labelBy,
  polygonClick: d.polygonClick,
  selectedEmphasis: d.selectedEmphasis,
  markerIcon: d.markerIcon,
  hoverCard: d.hoverCard
    ? {
        fields: d.hoverCard.fields,
        // Every field listed explicitly, not spread-then-overridden: a new
        // I18nString added to LayerDefinition.hoverCard.related now has to be
        // named here to compile at all, rather than passing through a spread
        // as an unflattened `{ en, es }` object. Same style as crossSource
        // below, which never had the spread in the first place.
        related: d.hoverCard.related
          ? {
              layerId: d.hoverCard.related.layerId,
              fromKey: d.hoverCard.related.fromKey,
              joinKey: d.hoverCard.related.joinKey,
              labelKey: d.hoverCard.related.labelKey,
              linkKey: d.hoverCard.related.linkKey,
              linkLabel: pick(d.hoverCard.related.linkLabel, locale),
              moreLabel: pick(d.hoverCard.related.moreLabel, locale),
              title: pick(d.hoverCard.related.title, locale),
              empty: pick(d.hoverCard.related.empty, locale),
              max: d.hoverCard.related.max,
            }
          : undefined,
        note: d.hoverCard.note ? pick(d.hoverCard.note, locale) : undefined,
      }
    : undefined,
  crossSource: d.crossSource
    ? {
        legend: pick(d.crossSource.legend, locale),
        hoverNote: pick(d.crossSource.hoverNote, locale),
        matched: pick(d.crossSource.matched, locale),
        unmatched: pick(d.crossSource.unmatched, locale),
        nearMiss: d.crossSource.nearMiss ? pick(d.crossSource.nearMiss, locale) : undefined,
        contested: pick(d.crossSource.contested, locale),
        ambiguousAnchor: pick(d.crossSource.ambiguousAnchor, locale),
        glossary: pick(d.crossSource.glossary, locale),
        searchSuffix: pick(d.crossSource.searchSuffix, locale),
        nearMissSearchSuffix: d.crossSource.nearMissSearchSuffix
          ? pick(d.crossSource.nearMissSearchSuffix, locale)
          : undefined,
      }
    : undefined,
  relation: d.relation,
  tintWhenRelated: d.tintWhenRelated,
  // Only for layers /near-me already enumerates individually (`nearMe.list`)
  // — the homepage map's own "what's near me" control searches exactly
  // those layers, at exactly the radius near-me promises. See
  // ClientLayer.nearMeRadiusMi's own comment in mapController.ts.
  nearMeRadiusMi: d.nearMe?.mode === 'radius' && d.nearMe.list ? d.nearMe.radii?.[0] : undefined,
  // The DOM record list a "near me" lookup renders for this layer — see
  // ClientLayer.nearMeList's own comment in mapController.ts. Present under
  // the exact same condition as nearMeRadiusMi above (a radius-mode layer
  // naming a list), so the two can never disagree about which layers the
  // homepage map's own near-me sheet covers.
  nearMeList:
    d.nearMe?.mode === 'radius' && d.nearMe.list
      ? {
          entityKey: d.nearMe.list.entityKey ?? null,
          detail: (d.nearMe.list.detail ?? []).map((key) => ({
            key,
            label: labelForNearMeDetail(d, key),
          })),
          caveat: d.nearMe.caveat ? pick(d.nearMe.caveat, locale) : null,
          unattributedLabel: d.nearMe.list.unattributedLabel ? pick(d.nearMe.list.unattributedLabel, locale) : null,
          showCoordsWhenUnattributed: d.nearMe.list.showCoordsWhenUnattributed ?? false,
        }
      : undefined,
  weightBy: d.weightBy
    ? { key: d.weightBy.key, label: pick(d.weightBy.label, locale), stops: d.weightBy.stops }
    : undefined,
  opacity: d.opacity,
  dataPath: d.dataPath,
  // `enum` renders as a checkbox group; `dateRange` renders as a from/to
  // date control (see the `#layer-drawer` markup below). Both kinds were
  // previously narrowed to `enum` right here, which silently dropped every
  // `dateRange` filter the registry declared — agency_287g's `signed` date
  // filter existed in the registry and was never rendered. `values` is
  // reused for a `dateRange` filter too: `distinctValues` already returns
  // the observed values sorted with `localeCompare`, which for ISO date
  // strings is chronological order, so `values[0]`/`values[values.length -
  // 1]` are exactly the min/max bounds the date control needs.
  filters: d.filters
    .map((f) => {
      const values = distinctValues(collection, f.key);
      return {
        key: f.key,
        label: pick(f.label, locale),
        kind: f.kind,
        values,
        valueDescriptions: f.valueDescriptions
          ? Object.fromEntries(
              Object.entries(f.valueDescriptions).map(([v, text]) => [v, pick(text, locale)]),
            )
          : undefined,
        // Only the excluded values this layer actually has. A registry entry that
        // names a value the data no longer contains must not leave the filter
        // opening pre-ticked against nothing. `dateRange` filters have no
        // concept of a default-excluded value.
        defaultExcluded: (f.defaultExcluded ?? []).filter((v) => values.includes(v)),
      };
    })
    .filter((f) => (f.kind === 'dateRange' ? f.values.length > 0 : f.values.length > 1)),
  detailFields: d.detailFields.map((f) => ({
    key: f.key,
    label: pick(f.label, locale),
    format: f.format,
    pillLabels: f.pillLabels
      ? Object.fromEntries(Object.entries(f.pillLabels).map(([v, text]) => [v, pick(text, locale)]))
      : undefined,
  })),
  action: d.action
    ? {
        requestType: d.action.requestType,
        label: pick(d.action.label, locale),
        bodyKey: d.action.bodyKey,
        fallbackBody: d.action.fallbackBody,
      }
    : undefined,
  source: collection?.metadata.source ?? d.provenance.source,
  sourceUrl: collection?.metadata.sourceUrl ?? d.provenance.sourceUrl,
  license: collection?.metadata.license ?? d.provenance.license,
  featureCount: collection?.metadata.featureCount ?? 0,
})) satisfies (ClientLayer & { featureCount: number })[];

/*
  The panel, one shelf per kind of subject.

  Ordering inside a section stays the order the registry declares its entries
  in, because that ordering is already an argument about what to read first;
  the sections only decide which layers stand next to which. A layer naming a
  category this file has never heard of would otherwise vanish out of the panel
  while remaining on the map, which is exactly the silent kind of wrong the
  registry is meant to prevent — so it stops the build instead.
*/
const known = new Set(LAYER_CATEGORIES.map((c) => c.id));
const orphan = clientLayers.find((l) => !known.has(l.category));
if (orphan) {
  throw new Error(
    `Layer "${orphan.id}" has category "${orphan.category}", which is not in LAYER_CATEGORIES.`,
  );
}

const layerGroups = LAYER_CATEGORIES.map((category) => ({
  id: category.id,
  label: pick(category.label, locale),
  summary: pick(category.summary, locale),
  layers: clientLayers.filter((l) => l.category === category.id),
})).filter((group) => group.layers.length > 0);

const strings = {
  loading: t('loading'),
  layerLoadError: t('layerLoadError'),
  noResults: t('noResults'),
  limitations: t('limitations'),
  source: t('source'),
  license: t('license'),
  confidence: t('confidence'),
  viewRecord: t('viewRecord'),
  closePanel: t('closePanel'),
  confidenceConfirmed: t('confidenceConfirmed'),
  confidenceReported: t('confidenceReported'),
  confidenceProbabilistic: t('confidenceProbabilistic'),
  ofTotal: t('ofTotal'),
  actionAddressed: t('actionAddressed'),
  actionUnknownOperator: t('actionUnknownOperator'),
  actionPickBody: t('actionPickBody'),
  clearFilters: t('clearFilters'),
  filtersCleared: t('filtersCleared'),
  resetView: t('resetView'),
  categoryLayersShown: t('categoryLayersShown'),
  filterNone: t('filterNone'),
  filterAll: t('filterAll'),
  filterCategoryToggleLabel: t('filterCategoryToggleLabel'),
  filterLayerToggleLabel: t('filterLayerToggleLabel'),
  filterResetToDefault: t('filterResetToDefault'),
  filterSearchValuesLabel: t('filterSearchValuesLabel'),
  filterSearchValuesPlaceholder: t('filterSearchValuesPlaceholder'),
  filterSearchValuesEmpty: t('filterSearchValuesEmpty'),
  filterSearchLayersLabel: t('filterSearchLayersLabel'),
  filterSearchLayersPlaceholder: t('filterSearchLayersPlaceholder'),
  filterSearchLayersEmpty: t('filterSearchLayersEmpty'),
  filterDateFrom: t('filterDateFrom'),
  filterDateTo: t('filterDateTo'),
  recordSelected: t('recordSelected'),
  crossListedCorner: t('crossListedCorner'),
  crossListedNearMissLegend: t('crossListedNearMissLegend'),
  crossSourceJumpToMatch: t('crossSourceJumpToMatch'),
  mapNearMe: t('mapNearMe'),
  mapNearMeFound: t('mapNearMeFound'),
  mapNearMeNone: t('mapNearMeNone'),
  mapNearMeRadiusLabel: t('mapNearMeRadiusLabel'),
  mapNearMeRadiusValue: t('mapNearMeRadiusValue'),
  locationDenied: t('locationDenied'),
  locationUnavailable: t('locationUnavailable'),
  locationTimedOut: t('locationTimedOut'),
  mapNearMeListSummary: t('mapNearMeListSummary'),
  mapNearMeBack: t('mapNearMeBack'),
  mapNearMeCrossListed: t('mapNearMeCrossListed'),
  mapNearMeLoading: t('mapNearMeLoading'),
  mapNearMeLayerError: t('mapNearMeLayerError'),
  mapNearMeListTabSuffix: t('mapNearMeListTabSuffix'),
  entityUnattributed: t('entityUnattributed'),
  lowAccuracy: t('lowAccuracy'),
};
---

{/*
  One CSS custom property per layer, dark value as the default and a light
  override under two selectors — the same pair global.css's whole ink ramp
  uses, and both are required, not redundant: :root[data-theme='light'] is
  an explicit choice (the site theme toggle sets that attribute), while
  @media (prefers-color-scheme: light) : root:not([data-theme]) covers a
  visitor who has never touched the toggle and is just following their OS
  setting live via CSS, with no data-theme attribute for the first selector
  to match at all. Missing this second block was a real bug caught by
  actually loading the page with the OS set to light rather than trusting
  the pattern was copied correctly: every layer's panel swatch stayed on
  its dark value for exactly this (the far more common, toggle-never-
  touched) case. Only layers whose colour actually fails WCAG 3:1 on a
  light background carry a colorLight (see LayerDefinition's own comment in
  layers/types.ts); the rest just repeat `color`, which already clears the
  floor in both themes.

  This governs *panel/UI* colour and tracks *site* theme specifically. The
  map's own paint (dots, lines, fills) is a separate, independent question
  answered in mapController.ts by this.layerColor(), keyed to the current
  *basemap*'s dark/light state instead — the two aren't the same theme, see
  lib/theme.ts, and conflating them here would make a panel swatch that's
  right for the sidebar but wrong for what's actually drawn on the map, or
  the other way around.
*/}
<style set:html={`
  :root {
    ${clientLayers.map((l) => `--layer-color-${l.id}: ${l.color};`).join('\n    ')}
  }
  @media (prefers-color-scheme: light) {
    :root:not([data-theme]) {
      ${clientLayers.map((l) => `--layer-color-${l.id}: ${l.colorLight ?? l.color};`).join('\n      ')}
    }
  }
  :root[data-theme='light'] {
    ${clientLayers.map((l) => `--layer-color-${l.id}: ${l.colorLight ?? l.color};`).join('\n    ')}
  }
`} />

<div class="relative flex h-full min-h-0 flex-col lg:flex-row">
  {/*
    ---------------------------- Controls ----------------------------
    At `lg` this is the full-height sidebar it has always been. Below `lg`
    only the search row stays in the flow, docked to the bottom of the
    screen within thumb reach; the layers list drops out of it into
    #layer-drawer, an overlay hung above the search row. `order-last` moves
    it there without touching source order, so tab order stays the search
    row first regardless of viewport — the same predictable order this panel
    has always had at `lg`, not a mobile-only reversal a keyboard user has to
    relearn.

    It was costing the map too much to keep. In the flow the list never
    compressed below about 256px — a search box and five group rows is what
    it is — so on a 320x568 phone the nav and this panel took 61% of the
    screen before the map was dealt in, leaving 223px of map. Landscape was
    worse: 162px. The map is the page, and it was the only region yielding.
  */}
  <aside
    id="controls"
    aria-label={t('layers')}
    class="scroll-slim relative z-30 order-last flex shrink-0 flex-col border-t border-ink-800 bg-ink-900 shadow-[0_-8px_24px_rgb(0_0_0/0.35)] lg:order-0 lg:overflow-x-hidden lg:overflow-y-auto lg:border-t-0 lg:border-r lg:shadow-none"
  >
    {/*
      Anti-flash: reads the persisted collapse state and stamps
      data-collapsed on this element before first paint — see that file's
      own comment for why it has to be the aside's first child rather than
      a preceding sibling. Mirrors theme-init.js's mechanism exactly (same
      localStorage try/catch, same is:inline external-file requirement per
      this site's CSP).
    */}
    <script is:inline src="/panels-init.js"></script>
    <div class="relative border-b border-ink-800 p-3">
      <div class="flex items-center gap-2">
        <label for="map-search" class="sr-only">{t('searchLabel')}</label>
        <input
          id="map-search"
          type="search"
          autocomplete="off"
          placeholder={t('searchPlaceholder')}
          class="min-w-0 flex-1 rounded-md border border-ink-700 bg-ink-850 px-3 py-2 text-sm text-ink-100 placeholder:text-ink-400 focus:border-accent focus:outline-none"
        />
        <button
          id="layers-toggle"
          type="button"
          aria-expanded="false"
          aria-controls="layer-drawer"
          class="flex shrink-0 items-center gap-1.5 rounded-md border border-ink-700 bg-ink-850 px-2.5 py-2 text-sm text-ink-200 hover:text-ink-100 lg:hidden"
        >
          {t('layers')}
        </button>
      </div>
      {/*
        Below `lg` the row it belongs to is now the bottom-most thing on
        screen, so there is no room under it to open into — it opens upward
        instead, absolutely positioned against the relative row above rather
        than pushed downward in the flow.
      */}
      <ul
        id="search-results"
        class="absolute inset-x-3 bottom-full mb-1.5 hidden max-h-56 overflow-y-auto rounded-md border border-ink-700 bg-ink-850 text-sm shadow-[0_-4px_16px_rgb(0_0_0/0.35)] lg:static lg:inset-x-auto lg:bottom-auto lg:mb-0 lg:mt-1.5 lg:shadow-none"
        role="listbox"
      >
      </ul>
    </div>

    {/*
      Anchored to the search row's own edge, not the viewport's — below `lg`
      that row is now at the bottom of the screen, so the drawer has to open
      upward into the map to have anywhere to go at all.
    */}
    <div
      id="layer-drawer"
      class="scroll-slim absolute inset-x-0 bottom-full z-30 max-h-[70dvh] overflow-y-auto border-t border-ink-800 bg-ink-900 p-3 shadow-[0_-8px_24px_rgb(0_0_0/0.35)] lg:static lg:max-h-none lg:overflow-visible lg:border-t-0 lg:shadow-none"
    >
      <div class="mb-2 flex items-baseline justify-between">
        <h2 class="text-xs font-semibold tracking-wider text-ink-400 uppercase">{t('layers')}</h2>
        {/*
          Relabelled from "Clear filters": one click also switches off every
          layer toggle, clears the search box, and drops the jurisdiction
          boundary outline (see this button's own click handler below) — the
          old label undersold what it does.
        */}
        <button
          id="clear-filters"
          type="button"
          class="text-xs text-ink-400 underline underline-offset-2 hover:text-ink-100"
        >
          {strings.clearFilters}
        </button>
      </div>

      {/*
        Every section ships closed, so the panel opens as a short list of
        subjects rather than a wall of seven cards nobody scrolls to the end
        of. A closed section still has to report itself: the coloured dots are
        the layers it holds, lit when that layer is drawn, and the count beside
        them says how many. Otherwise the map opens with cameras on the screen
        and no visible control claiming responsibility for them.

        `<details>` rather than a scripted accordion. A closed section is
        genuinely closed — its checkboxes leave the tab order, keyboard and
        screen-reader behaviour is the platform's, and the sections still open
        if the script never arrives.
      */}
      <ul class="space-y-1.5">
        {
          layerGroups.map((group) => (
            <li>
              <details
                class="layer-group rounded-lg border border-ink-800 bg-ink-900"
                data-layer-group={group.id}
              >
                <summary class="flex cursor-pointer items-center gap-2 rounded-lg px-2.5 py-2 hover:bg-ink-850">
                  <svg
                    class="layer-group-chevron h-3 w-3 shrink-0 text-ink-400"
                    viewBox="0 0 24 24"
                    fill="none"
                    aria-hidden="true"
                  >
                    <path
                      d="m6 9 6 6 6-6"
                      stroke="currentColor"
                      stroke-width="2.5"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    />
                  </svg>

                  {/*
                    `min-w-0 flex-1` on this group is what pins the switch to
                    a fixed right-hand column: without it, a long category
                    name pushes the row wider instead of yielding, so the
                    switch lands at a different offset (or off-screen) per
                    category instead of lining up down the list. This group
                    is deliberately NOT itself a flex row — the name and
                    count are plain inline text so they can wrap onto a
                    second line together on a narrow phone instead of either
                    forcing the row wider or truncating a name like
                    "Surveillance Apparatus" into an unreadable fragment.
                  */}
                  <span class="min-w-0 flex-1">
                    <span data-category-label class="text-[11px] font-semibold tracking-wider text-ink-200 uppercase">
                      {group.label}
                    </span>{' '}
                    {/*
                      "(n/m)" sits right next to the category name it counts
                      — a plain-language sentence for a screen reader
                      instead, since a bare fraction in parentheses reads as
                      noise without the word "shown". tabular-nums keeps the
                      digits from reflowing as the count changes;
                      whitespace-nowrap keeps the fraction itself from
                      splitting across a wrap.
                    */}
                    <span
                      class="font-mono text-[10px] whitespace-nowrap tabular-nums text-ink-400"
                      aria-hidden="true"
                    >
                      (<span data-group-on={group.id}>0</span>/<span>{group.layers.length}</span>)
                    </span>
                    <span class="sr-only" data-group-sr={group.id}>
                      {fillStatic(strings.categoryLayersShown, { n: 0, m: group.layers.length })}
                    </span>
                  </span>

                  {/*
                    Category-level bulk switch (level 1) — lives in the
                    always-visible summary row now, not just the expanded
                    body, so it's reachable without opening the category.
                    Scoped to this one category's layers only. Never a
                    control that turns on every layer in every category:
                    each of these only ever touches `group.layers`. Mixed
                    state (some on, some off) collapses to visually "off";
                    the script's own comment on data-category-switch
                    explains the click semantics that follow from that. The
                    click handler calls stopPropagation so activating the
                    switch doesn't also toggle the <details> open/closed —
                    it's a descendant of <summary> now. `shrink-0` (not
                    ml-auto) is what holds this at the same fixed right-hand
                    position across every category, since the label group
                    above it now absorbs all the row's give.
                  */}
                  {/*
                    "None"/"All" are purely decorative (aria-hidden — the
                    switch already carries its full meaning in aria-label),
                    so they're the first thing to give up room. Hidden below
                    `sm` where every pixel is fought over by the category
                    name: without this, a name like "Environment & Health"
                    or "Surveillance Apparatus" was truncating to
                    unreadable fragments on an actual phone width.
                  */}
                  <span class="flex shrink-0 items-center gap-1.5">
                    <span class="hidden text-[10px] text-ink-400 sm:inline" aria-hidden="true">
                      {strings.filterNone}
                    </span>
                    <button
                      type="button"
                      role="switch"
                      aria-checked="false"
                      aria-label={fillStatic(strings.filterCategoryToggleLabel, { category: group.label })}
                      class="switch"
                      data-category-switch={group.id}
                    />
                    <span class="hidden text-[10px] text-ink-400 sm:inline" aria-hidden="true">
                      {strings.filterAll}
                    </span>
                  </span>
                </summary>

                <div class="border-t border-ink-800">
                  <div class="p-2.5 pb-2">
                    <p class="mb-2 text-[11px] leading-snug text-ink-400">{group.summary}</p>

                    {/*
                      Search-within-layer-names (level 2) — same mechanism as
                      the value search below, only above the cardinality
                      threshold where a search box has something to do.
                      Ships `hidden`: a no-JS visitor gets no dead control,
                      the init script below removes `hidden` once it can
                      actually wire the input up.
                    */}
                    {group.layers.length > FILTER_INPUT_THRESHOLD && (
                      <div class="mb-2">
                        <label class="sr-only" for={`layer-search-${group.id}`}>
                          {fillStatic(strings.filterSearchLayersLabel, { category: group.label })}
                        </label>
                        <input
                          hidden
                          type="search"
                          id={`layer-search-${group.id}`}
                          data-layer-search={group.id}
                          aria-label={fillStatic(strings.filterSearchLayersLabel, { category: group.label })}
                          placeholder={strings.filterSearchLayersPlaceholder}
                          class="w-full rounded border border-ink-700 bg-ink-900 px-2 py-1 text-xs text-ink-100 placeholder:text-ink-400"
                        />
                      </div>
                    )}
                    <p
                      hidden
                      data-layer-search-empty={group.id}
                      class="mb-2 text-[11px] leading-snug text-ink-400"
                    />
                  </div>

                  {/*
                    Flat divided list, not a card inside a card: `divide-y` +
                    one leading `border-t` (the container's own convention,
                    see the search results list in this file's script) rather
                    than a `rounded-lg border` per row. Full-bleed hover reads
                    off the row's own edges since the `<ul>` carries no
                    horizontal padding — only each `<li>`'s inner div does.
                  */}
                  <ul class="divide-y divide-ink-800 border-t border-ink-800" data-layer-list={group.id}>
                    {group.layers.map((layer) => (
                        <li data-layer-row={layer.id} data-layer-name={layer.label.toLowerCase()}>
                          {/*
                            A <label>, not a <div>: the checkbox itself is
                            only ~16px, well under the 44px a thumb needs on a
                            phone (§0.7 — old phones are the audience this
                            builds for, not an edge case). Wrapping the whole
                            row in the checkbox's own label makes the entire
                            name/description area tappable, not just the box,
                            without changing how small the box looks.
                          */}
                          <label class="flex min-h-11 cursor-pointer items-start gap-2.5 px-2.5 py-2.5 hover:bg-ink-850">
                            {/*
                              Layer-level control (level 2) is a checkbox, not
                              a switch — the switch language is reserved for
                              the parent category's bulk control above. A
                              plain checked/unchecked box reads as one item in
                              a list rather than a device state, which fits a
                              row that's one of many rather than the single
                              bulk decision a category switch represents.
                            */}
                            <input
                              type="checkbox"
                              checked={layer.defaultOn}
                              aria-label={fillStatic(strings.filterLayerToggleLabel, { layer: layer.label })}
                              class="mt-1 h-4 w-4 shrink-0 accent-current"
                              style={`color:var(--layer-color-${layer.id})`}
                              data-layer-switch={layer.id}
                            />
                            <div class="min-w-0 flex-1">
                              <p class="flex items-center gap-2 text-sm font-medium text-ink-100">
                                <span
                                  class="h-2.5 w-2.5 shrink-0 rounded-full"
                                  style={`background:var(--layer-color-${layer.id})`}
                                  aria-hidden="true"
                                />
                                <span class="min-w-0">{layer.label}</span>
                              </p>
                              <p class="mt-1 text-xs leading-snug text-ink-400" data-layer-summary={layer.id}>{layer.summary}</p>
                              <p class="mt-1 font-mono text-[11px] text-ink-400">
                                <span data-count={layer.id}>0</span>
                                <span> {strings.ofTotal} </span>
                                <span>{layer.featureCount}</span>
                              </p>
                            </div>
                          </label>

                          {/*
                            "Cross-listed corner" static legend row (§4 of
                            the spec this shipped from). Not a FilterDefinition
                            — nothing here is checkable or wired into the
                            filter system, it only explains what the brass
                            ring on some of this layer's points means. Real
                            DOM text, not an aria-hidden canvas decoration, so
                            it's reachable by a screen reader on its own.
                          */}
                          {layer.crossSource && (
                            <div class="flex items-start gap-2 border-t border-ink-800 px-2.5 py-2">
                              <span
                                class="mt-0.5 h-2.5 w-2.5 shrink-0 rounded-full border-2 border-cross-source-ring bg-ink-700"
                                aria-hidden="true"
                              />
                              <p class="text-[11px] leading-snug text-ink-400">{layer.crossSource.legend}</p>
                            </div>
                          )}

                          {/*
                            "Near miss" static legend row — a second,
                            subordinate swatch, thinner ring at half opacity,
                            same brass hue as the match ring above rather
                            than a new colour. Only rendered where the
                            registry names copy for it (today, alpr_reported
                            only — see LayerDefinition.crossSource.nearMiss's
                            own comment on why the OSM side has no use for
                            this key).
                          */}
                          {layer.crossSource?.nearMiss && (
                            <div class="flex items-start gap-2 border-t border-ink-800 px-2.5 py-2">
                              <span
                                class="mt-0.5 h-2.5 w-2.5 shrink-0 rounded-full border border-cross-source-ring bg-ink-700 opacity-55"
                                aria-hidden="true"
                              />
                              <p class="text-[11px] leading-snug text-ink-400">
                                {strings.crossListedNearMissLegend}
                              </p>
                            </div>
                          )}

                          {layer.filters.length > 0 && (
                            <details class="border-t border-ink-800">
                              <summary class="cursor-pointer px-2.5 py-1.5 text-xs text-ink-400 hover:text-ink-100">
                                {t('filters')}
                              </summary>
                              <div class="space-y-2.5 px-2.5 pb-2.5">
                                {layer.filters.map((filter) =>
                                  filter.kind === 'dateRange' ? (
                                    /*
                                      dateRange (level 3, date-bounded rather
                                      than value-bounded) — a plain from/to
                                      date control. `min`/`max` come straight
                                      off the observed values (already sorted
                                      chronologically — see clientLayers'
                                      own comment on why distinctValues'
                                      localeCompare sort works for ISO
                                      dates), so the control can never be
                                      set outside what the data actually
                                      covers.
                                    */
                                    <fieldset data-filter-daterange={layer.id} data-filter-key={filter.key}>
                                      <legend class="mb-1 text-[11px] font-semibold tracking-wide text-ink-400 uppercase">
                                        {filter.label}
                                      </legend>
                                      <div class="flex items-end gap-2">
                                        <label class="flex flex-1 flex-col gap-0.5 text-[10px] text-ink-400">
                                          {strings.filterDateFrom}
                                          <input
                                            type="date"
                                            data-filter-layer={layer.id}
                                            data-filter-key={filter.key}
                                            data-date-bound="from"
                                            min={filter.values[0]}
                                            max={filter.values[filter.values.length - 1]}
                                            class="rounded border border-ink-700 bg-ink-900 px-1.5 py-1 text-xs text-ink-100"
                                          />
                                        </label>
                                        <label class="flex flex-1 flex-col gap-0.5 text-[10px] text-ink-400">
                                          {strings.filterDateTo}
                                          <input
                                            type="date"
                                            data-filter-layer={layer.id}
                                            data-filter-key={filter.key}
                                            data-date-bound="to"
                                            min={filter.values[0]}
                                            max={filter.values[filter.values.length - 1]}
                                            class="rounded border border-ink-700 bg-ink-900 px-1.5 py-1 text-xs text-ink-100"
                                          />
                                        </label>
                                      </div>
                                    </fieldset>
                                  ) : (
                                    <fieldset>
                                      <div class="mb-1 flex items-center justify-between gap-2">
                                        <legend class="text-[11px] font-semibold tracking-wide text-ink-400 uppercase">
                                          {filter.label}
                                        </legend>
                                        {/*
                                          Restores each value's own
                                          `defaultExcluded`-driven default —
                                          not a blanket "select all". See
                                          this button's click handler.
                                        */}
                                        <button
                                          type="button"
                                          data-filter-reset={layer.id}
                                          data-filter-reset-key={filter.key}
                                          class="shrink-0 text-[10px] text-ink-400 underline underline-offset-2 hover:text-ink-100"
                                        >
                                          {strings.filterResetToDefault}
                                        </button>
                                      </div>
                                      {filter.values.length > FILTER_INPUT_THRESHOLD && (
                                        <div class="mb-1.5">
                                          <label class="sr-only" for={`filter-search-${layer.id}-${filter.key}`}>
                                            {fillStatic(strings.filterSearchValuesLabel, { filter: filter.label })}
                                          </label>
                                          <input
                                            hidden
                                            type="search"
                                            id={`filter-search-${layer.id}-${filter.key}`}
                                            data-filter-value-search={layer.id}
                                            data-filter-value-search-key={filter.key}
                                            aria-label={fillStatic(strings.filterSearchValuesLabel, {
                                              filter: filter.label,
                                            })}
                                            placeholder={strings.filterSearchValuesPlaceholder}
                                            class="w-full rounded border border-ink-700 bg-ink-900 px-2 py-1 text-xs text-ink-100 placeholder:text-ink-400"
                                          />
                                        </div>
                                      )}
                                      <p
                                        hidden
                                        data-filter-value-empty={`${layer.id}:${filter.key}`}
                                        class="text-[11px] leading-snug text-ink-400"
                                      />
                                      <div
                                        class="space-y-1"
                                        data-filter-value-list={`${layer.id}:${filter.key}`}
                                      >
                                        {filter.values.map((value) => (
                                          <label
                                            class="flex cursor-pointer items-start gap-2 text-xs text-ink-200"
                                            data-filter-value-row
                                            data-filter-value-text={value.toLowerCase()}
                                          >
                                            <input
                                              type="checkbox"
                                              data-filter-layer={layer.id}
                                              data-filter-key={filter.key}
                                              value={value}
                                              checked={!filter.defaultExcluded!.includes(value)}
                                              class="mt-0.5 h-3.5 w-3.5 shrink-0"
                                            />
                                            {/*
                                              Where this filter is the same attribute the map colours
                                              by, each value carries its ground colour, so the toggle
                                              and the fill read as one system.
                                            */}
                                            {layer.categoryColors?.key === filter.key && (
                                              <span
                                                class="mt-1 h-2 w-2 shrink-0 rounded-sm"
                                                style={`background:${
                                                  layer.categoryColors.colors.find((c) => c.value === value)
                                                    ?.color ?? layer.categoryColors.fallback
                                                }`}
                                                aria-hidden="true"
                                              />
                                            )}
                                            <span class="min-w-0 flex-1">
                                              {value}
                                              {filter.valueDescriptions?.[value] && (
                                                <span class="block text-[10px] leading-snug text-ink-400">
                                                  {filter.valueDescriptions[value]}
                                                </span>
                                              )}
                                            </span>
                                            {/*
                                              Live count — recalculated from
                                              MapController's own filtering
                                              machinery on every filter
                                              change (see refreshFilterCounts
                                              in the module script), not
                                              computed once at build time,
                                              so it always reflects the
                                              other filters currently active
                                              on this same layer.
                                            */}
                                            <span
                                              class="shrink-0 font-mono text-[10px] tabular-nums text-ink-400"
                                              data-filter-value-count={`${layer.id}:${filter.key}:${value}`}
                                            >
                                              0
                                            </span>
                                          </label>
                                        ))}
                                      </div>
                                    </fieldset>
                                  ),
                                )}
                              </div>
                            </details>
                          )}
                        </li>
                    ))}
                  </ul>
                </div>
              </details>
            </li>
          ))
        }
      </ul>

      {/*
        Third inclusion of panels-init.js — see that file's own header
        comment on why it runs more than once. This one stamps `open` on
        whichever `[data-layer-group]` categories a reader previously left
        open, and has to sit after the `<ul>` above so the parser has
        actually created them by the time it runs.
      */}
      <script is:inline src="/panels-init.js"></script>
    </div>
  </aside>

  {/*
    ------------------------------ Map ------------------------------
    Map and detail panel share a box, so that below `lg` the panel can be
    sized and positioned against the map rather than against the viewport.
    A sheet capped at 55dvh is taller than the whole map area once the layer
    panel above has taken its share, which is not a sheet — it is a cover.
  */}
  <div id="map-shell" class="relative flex min-h-0 flex-1 flex-col xl:flex-row">
    <div class="relative min-h-0 flex-1">
      <div id="map" class="absolute inset-0" role="application" aria-label={t('mapLabel')}></div>

      <div
        id="map-status"
        role="status"
        aria-live="polite"
        class="pointer-events-none absolute top-2 left-1/2 -translate-x-1/2 rounded-full bg-ink-900/90 px-3 py-1 text-xs text-ink-200 opacity-0 transition-opacity"
      >
      </div>

      {/*
        Pull tabs for the two collapsible side panels — #controls (left)
        and #detail-panel (right). Deliberately mounted here, inside the
        map wrapper, rather than inside either panel: this box's edges are
        the map's own current edges, so each tab is always drawn exactly
        where the panel it controls currently meets the map, with no
        transform math needed as either panel resizes. Both ship a bare
        `hidden` attribute for a no-JS visitor (see the inline module
        script's start-up section, which is what removes it) — undoing that
        pre-emptively would show a dead button with nothing behind it to
        wire up. Visual styling is Tailwind utilities in the markup; see
        global.css's `.panel-tab` rules for the one thing utilities can't
        express (the light-mode shadow swap) plus the chevron rotation.

        Bare arrows, no visible label or count — matching wealldobettermn's
        own pull tabs. Each still carries a real accessible name via a
        visually-hidden (not aria-hidden) span, since the chevron itself is
        aria-hidden and a button needs *some* text content to announce.

        One template, not two hand-copied buttons — the two only ever
        differed in which edge/panel/breakpoint they belong to, and
        `data-side` (read by global.css's `.panel-tab[data-side=...]` rules)
        is what lets the chevron-rotation CSS stay one pair of rules instead
        of four hardcoded per-id ones.
      */}
      {
        [
          {
            id: 'layers-tab',
            side: 'left' as const,
            controls: 'controls',
            edge: 'left-0',
            shape: 'rounded-r-lg border-l-0',
            dock: 'lg:flex',
            label: t('layers'),
          },
          {
            id: 'detail-tab',
            side: 'right' as const,
            controls: 'detail-panel',
            edge: 'right-0',
            shape: 'rounded-l-lg border-r-0',
            dock: 'xl:flex',
            label: t('recordPanel'),
          },
          // Same edge and breakpoint as #detail-tab, which is safe because the
          // two are mutually exclusive — see the `:has(#detail-panel...)` rule
          // in global.css that hides this one whenever a record is open.
          {
            id: 'news-tab',
            side: 'right' as const,
            controls: 'news-dock',
            edge: 'right-0',
            shape: 'rounded-l-lg border-r-0',
            dock: 'xl:flex',
            label: t('newsRailTitle'),
          },
        ].map((tab) => (
          <button
            id={tab.id}
            type="button"
            hidden
            aria-expanded="true"
            aria-controls={tab.controls}
            data-side={tab.side}
            class={`panel-tab absolute top-1/2 ${tab.edge} z-20 hidden h-12 w-6 -translate-y-1/2 items-center justify-center ${tab.shape} border border-ink-700 bg-ink-850 text-ink-300 shadow-[0_10px_30px_rgba(0,0,0,.5)] hover:border-ink-600 hover:bg-ink-800 hover:text-ink-100 active:bg-ink-800 ${tab.dock}`}
          >
            <svg class="panel-tab-chevron h-4 w-4 shrink-0" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path
                d="m6 9 6 6 6-6"
                stroke="currentColor"
                stroke-width="2.5"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
            </svg>
            <span class="sr-only">{tab.label}</span>
            {tab.id === 'detail-tab' && (
              // Populated in renderDetail with the selected record's name, so a
              // screen reader's announcement of this button effectively reads
              // "Record, {name}" rather than a bare "Record" no matter which
              // record is open.
              <span data-detail-tab-name class="sr-only" />
            )}
          </button>
        ))
      }

      {/*
        One wrapper for everything that lives in the map's bottom-right
        corner — matching wealldobettermn.org's own #map-corner-controls
        exactly (see its WardMap.tsx): the theme toggle, the reset-view
        button, MapLibre's zoom buttons, and its attribution badge, mounted
        as ordinary flex children of a div this markup owns rather than
        handed to MapLibre's own separately-positioned corner container via
        map.addControl(). That's what makes `gap` alone keep all four
        evenly spaced regardless of any one control's actual rendered
        width — no per-control offset tuning. mapController.ts's map-setup
        does the actual mounting (control.onAdd(map) → appendChild) into
        this empty div; nothing is rendered here.
      */}
      <div id="map-corner-controls"></div>

      {/*
        A second, visual-only way to look at the two demographic layers
        already on the main map (see the Environment section of the layer
        panel) — poverty rate and Black population share, side by side with a
        draggable divider, instead of toggled one at a time. Lives in the same
        map-only container as reset-view above so its own absolute
        positioning is scoped to the map canvas, not the layer panel beside
        it. The overlay it opens is not built until first opened — see
        CompareView.astro's start()/IntersectionObserver.

        bottom-left, not bottom-right: #map-corner-controls (theme toggle,
        reset, near-me, zoom buttons, attribution) already owns the
        bottom-right corner at every breakpoint — a first pass put this
        button there instead and it overlapped the attribution control badly
        enough that a scripted click on a 375px-wide viewport landed on
        attribution instead of the button. Bottom-left has nothing else on it
        at `>=xl`, where #detail-panel docks as a static sidebar rather than
        overlaying the map. Below `xl`, an open sheet (#detail-panel,
        `absolute inset-x-0 bottom-0`) does cover this corner while it's
        open — no explicit z-index needed to resolve that: the sheet's own
        z-20 already wins the stack over this button's default z-index, so
        it's simply hidden underneath rather than floating awkwardly on top
        of sheet content.
      */}
      <button
        id="open-compare"
        type="button"
        title={t('compareOpenButton')}
        class="absolute bottom-2 left-2 max-w-[75vw] rounded-full border border-ink-700 bg-ink-900/90 px-3 py-1.5 text-xs font-medium text-ink-100 hover:bg-ink-800"
      >
        {t('compareOpenButton')}
      </button>

      <div id="compare-overlay" hidden class="absolute inset-0 z-30 bg-ink-950">
        <button
          id="close-compare"
          type="button"
          aria-label={t('compareClose')}
          title={t('compareClose')}
          class="absolute top-3 right-3 z-40 flex h-8 w-8 items-center justify-center rounded-md border border-ink-700 bg-ink-900/90 text-lg leading-none text-ink-200 hover:text-ink-100"
        >
          ×
        </button>
        <CompareView locale={locale} />
      </div>

      {/*
        On-map keys for colour-coded layers, one bar per visible layer that
        declares categoryColors. Rebuilt from the layer toggles on every change, so a key can never
        outlive the layer it explains. aria-hidden because the same table
        already exists accessibly in the layer panel beside the map — this is
        the glanceable duplicate, not the record.
      */}
      <div
        id="map-keys"
        style="bottom: calc(2rem + var(--map-sheet-h, 0px))"
        class="pointer-events-none absolute left-2 z-10 flex w-56 max-w-[70vw] flex-col gap-1.5 motion-safe:transition-[bottom]"
        aria-hidden="true"
      >
      </div>
    </div>

    {/*
      ---------------------------- News rail -----------------------------
      Shares the right column with the detail panel below rather than adding a
      third one, and that is geometry rather than taste. `--controls-w` is
      21rem and `--detail-w` is 24rem, so the docked chrome already costs 720px
      at the 1280px breakpoint where both appear — a third 24rem column would
      leave a 176px map. The detail panel's own comment records the same
      arithmetic being what kept it from docking at `lg`.

      Sharing works because the column is empty most of the time: #detail-panel
      is `hidden` until a record is selected. So the column shows coverage by
      default and the record when there is one, which is also the better
      reading of what that space is for — it answers "what else is going on"
      until the reader asks about something specific.

      The swap is a CSS rule in global.css keyed on
      `#map-shell:has(#detail-panel:not([hidden]))`, matching the `:has()`
      pattern #map-keys already uses. No script, so it cannot desynchronise
      from whatever opened the panel.

      `xl` only, and it does not become a sheet below that. The bottom nav is
      already eight icons and the detail sheet already claims 45% of the map on
      a phone; a third surface competing for that space is what the near-me
      rebuild just finished reclaiming. Below `xl` the archive page is the
      whole feature, and the nav links straight to it.
    */}
    <aside
      id="news-dock"
      aria-label={t('newsRailTitle')}
      class="hidden shrink-0 border-l border-ink-800 bg-ink-900 xl:flex"
    >
      {/*
        Second copy of the anti-flash init, and it has to be here rather than
        only inside #controls: that one runs while the parser is still hundreds
        of lines above this element, so it cannot see the dock. See the file's
        own header for why running it twice is idempotent.
      */}
      <script is:inline src="/panels-init.js"></script>
      <NewsFeed locale={locale} density="rail" />
    </aside>

    {/*
      --------------------------- Detail panel ---------------------------
      Two shapes from one element. At `xl` it is a plain flex sibling to the
      right of the map: the map's own box shrinks to make room, so a fit
      computed after map.resize() already lands inside what the reader sees.

      Below `xl` it is a sheet drawn over the bottom of the map instead. It
      has to be. Stacked in the flow it was a `shrink-0` sibling of a `flex-1`
      map, and with the layer panel above already claiming up to 45dvh, it
      left the map exactly nothing: tapping a jurisdiction on a phone
      collapsed the map to zero height and fitted the record to a canvas that
      was no longer on screen. Floating it keeps the map at full height, and
      the controller reserves the sheet's measured height as fit padding
      (setOverlay/fitPadding in mapController.ts) so a record lands in the
      strip above the sheet rather than behind it.

      `xl` and not `lg`, unlike the layer drawer beside it, because these two
      panels cost the map different things. The layer sidebar can afford to
      arrive at 1024px; a second fixed 24rem column at that width cannot —
      336px of layers plus 384px of detail left a 304px map on a 1024px
      screen, which is a sliver, not a map. Between 1024 and 1280 the layers
      dock and the detail still floats.

      The cap is a share of the map, not of the viewport: 55dvh is taller than
      the whole map area once the layer panel has taken its share, and a sheet
      taller than what it floats over is not a sheet. 45% is what leaves a
      strip the fit can actually use — above that, fitPadding's own clamp
      starts refusing to reserve the whole sheet and the record creeps back
      under its top edge.
    */}
    {/*
      recordPanel ("Record"), not whatThisMeans — this panel now also
      renders the near-me record list and its own header (renderNearMeList),
      never just the "What this means" explainer that name described; that
      section was removed from the record view entirely (see renderDetail).
      recordPanel is already this same panel's own name everywhere else —
      #detail-tab (the pull tab that controls it, just below) uses the
      identical string, so the tab and the region it controls now agree.
    */}
    <aside
      id="detail-panel"
      aria-label={t('recordPanel')}
      hidden
      class="scroll-slim absolute inset-x-0 bottom-0 z-20 max-h-[45%] shrink-0 overflow-x-hidden overflow-y-auto rounded-t-xl border-t border-ink-800 bg-ink-900 shadow-[0_-8px_24px_rgb(0_0_0/0.35)] xl:static xl:max-h-none xl:rounded-none xl:border-t-0 xl:border-l xl:shadow-none"
    >
    </aside>
  </div>
</div>

<script is:inline type="application/json" id="layer-config" set:html={JSON.stringify(clientLayers)} />
<script is:inline type="application/json" id="ui-strings" set:html={JSON.stringify(strings)} />
<script is:inline type="application/json" id="act-path" set:html={JSON.stringify(localePath(locale, '/act'))} />

<script>
  import { MapController, REDUCED_MOTION, type ClientLayer, type LoadedFeature } from '~/lib/mapController';
  import { formatValue, isUnattributedValue } from '~/lib/detailFields';
  import { displayName } from '~/lib/authority.mjs';
  import { metersToMiles, formatMiles, formatCoords, LOW_ACCURACY_MILES } from '~/lib/geo.mjs';
  import { matchesQuery } from '~/lib/filterQuery.mjs';
  import { fillTemplate } from '~/lib/template.mjs';

  type Jurisdiction = {
    geoid: string;
    name: string;
    kind: 'city' | 'township' | 'unorganized';
    governed: boolean;
    county: string;
    countyFips: string;
    lat: number;
    lng: number;
  };

  const layers = JSON.parse(document.getElementById('layer-config')!.textContent!) as (ClientLayer & {
    featureCount: number;
  })[];
  const S = JSON.parse(document.getElementById('ui-strings')!.textContent!) as Record<string, string>;
  const ACT_PATH = JSON.parse(document.getElementById('act-path')!.textContent!) as string;

  const mapEl = document.getElementById('map')!;
  const controlsEl = document.getElementById('controls')!;
  const detailEl = document.getElementById('detail-panel')!;
  const statusEl = document.getElementById('map-status')!;
  const layersTabEl = document.getElementById('layers-tab')!;
  const detailTabEl = document.getElementById('detail-tab')!;
  // Queried defensively, unlike the two above: those are structural to the map
  // and their absence is a bug worth throwing on, whereas the news dock is a
  // feature that could reasonably be removed from this page later. A `!` here
  // would take the whole map script down with it.
  const newsDockEl = document.getElementById('news-dock');
  const newsTabEl = document.getElementById('news-tab');
  // Static descendant of detailTabEl, populated per-selection in
  // renderDetail — scoped/cached here instead of a fresh
  // document.querySelector on every single record selection.
  const detailTabNameEl = detailTabEl.querySelector('[data-detail-tab-name]')!;

  // Keyed by plain string: lookups come from DOM datasets and event payloads,
  // which are untyped by definition.
  const layerById = new Map<string, (typeof layers)[number]>(layers.map((l) => [l.id, l]));

  function status(message: string, holdMs = 1800) {
    statusEl.textContent = message;
    statusEl.style.opacity = '1';
    if (holdMs) window.setTimeout(() => (statusEl.style.opacity = '0'), holdMs);
  }

  /**
   * Busy/error feedback on one layer row — see mapController.ts's
   * `onLoadStart` and this file's own `onLoadStart`/`onLayerReady`/`onError`
   * wiring below. `aria-busy` on the row itself (not just a visual change) so
   * a screen reader on the row picks up the same "still loading" state a
   * sighted reader gets from the summary line swapping to S.loading.
   *
   * The layer name and record-count line are untouched by any of this —
   * only `[data-layer-summary]`, the one-line description under the name,
   * ever changes text, so a busy or failed row never reflows the rest of
   * the panel.
   */
  function setLayerRowBusy(layerId: string, busy: boolean) {
    const row = document.querySelector<HTMLElement>(`[data-layer-row="${layerId}"]`);
    if (!row) return;
    // aria-busy is a tri-state ARIA attribute, not a boolean HTML one —
    // `toggleAttribute` would leave a truthy `aria-busy=""` behind instead of
    // removing it, so the value is set/removed explicitly.
    if (busy) row.setAttribute('aria-busy', 'true');
    else row.removeAttribute('aria-busy');
  }

  /** Swap a layer row's summary line to `text`, or back to the layer's own summary when `text` is null. */
  function setLayerRowSummary(layerId: string, text: string | null) {
    const el = document.querySelector<HTMLElement>(`[data-layer-summary="${layerId}"]`);
    if (!el) return;
    el.textContent = text ?? layerById.get(layerId)?.summary ?? '';
  }

  // Short alias for the shared substitution function (see template.mjs) —
  // every call site below spells it `fill(...)`, and that stays true whether
  // the underlying function lives here or in a shared module. An import is
  // hoisted regardless of where the `import` statement sits in this script,
  // so — unlike the old local `const fill = ...` this replaces — nothing
  // about NearMeRadiusControl.onAdd calling formatNearMeRadiusValue
  // synchronously inside MapController's own constructor just below requires
  // this alias to be declared in any particular position; it's only here,
  // this early, because that's a natural place to introduce it.
  const fill = fillTemplate;

  const controller = new MapController(mapEl, layers, {
    resetViewLabel: S.resetView,
    nearMeLabel: S.mapNearMe,
    nearMeRadiusLabel: S.mapNearMeRadiusLabel,
    formatNearMeRadiusValue: (miles) => fill(S.mapNearMeRadiusValue, { mi: miles }),
    locationDeniedLabel: S.locationDenied,
    locationUnavailableLabel: S.locationUnavailable,
    locationTimedOutLabel: S.locationTimedOut,
    onNearMeError: (message) => status(message, 6000),
    onNearMeResult: (totalFound, shown, accuracyM, announce) => {
      // Always updates state — a sighted reader dragging the radius slider
      // watches this same number in the sheet's summary line (renderNearMeList),
      // fed live by onNearMeRecords below on every tick; leaving nearMeFound
      // stale until `announce` (commit-only) produced a self-contradictory
      // "2 found, 9 shown" mid-drag, shown exceeding found. Only the actual
      // screen-reader narration stays gated on `announce` — see
      // mapController.ts's onNearMeResult comment for why that's still a
      // "don't narrate every mile" gate and not a "don't update yet" one.
      nearMeFound = totalFound;
      nearMeAccuracyM = accuracyM;
      nearMeLoading = false;
      if (announce) {
        status(totalFound ? fill(S.mapNearMeFound, { count: totalFound, shown }) : S.mapNearMeNone, 6000);
      }
    },
    // The DOM equivalent of the throw lines above — see NearMeRecord's own
    // comment in mapController.ts. Re-renders the list only while it's
    // actually the visible sheet state; while a record is open it just
    // checks whether that record fell out of the newly-drawn set (see
    // handleSelect's own comment on how the back affordance is decided).
    onNearMeRecords: (records) => {
      nearMeRecords = records;
      if (sheetMode === 'list') renderNearMeList();
      else if (sheetMode === 'record' && openRecord) {
        const stillIn = records.some(
          (r) => r.layerId === openRecord!.layerId && r.featureId === openRecord!.featureId,
        );
        if (!stillIn) detailEl.querySelector('[data-nearme-back]')?.remove();
      }
    },
    onNearMeLayerError: (layerId, message) => {
      nearMeLayerErrors.set(layerId, message);
      if (sheetMode === 'list') renderNearMeList();
    },
    // setNearMeLayerMode is declared further down, alongside the rest of the
    // layer-toggle wiring it shares state with — safe to reference here
    // despite that: this callback only ever fires later, from a click, long
    // after the whole script (including that declaration) has already run.
    // showNearMeList/closeSheet are declared later too, in the near-me DOM
    // list section, for the same reason.
    onNearMeModeChange: (active) => {
      nearMeActive = active;
      setNearMeLayerMode(active);
      // The desktop radius popover aligns to the near-me button's own
      // vertical centre (syncNearMeRadiusPlacement), computed from that
      // button's offsetTop within the corner-controls column — which shifts
      // by one slot the instant resetViewControl hides/shows alongside this
      // same mode change (mapController.ts's toggleNearMe/clearNearMe).
      // Recomputed here, not left to the load/breakpoint-change triggers
      // syncNearMeRadiusPlacement's own comment describes, since neither of
      // those fires from a plain near-me toggle.
      syncNearMeRadiusPlacement();
      if (active) {
        // A fresh lookup — clear whatever the previous one left behind
        // before its own onNearMeRecords/onNearMeResult have a chance to
        // arrive, so the sheet shows a clean loading state rather than a
        // flash of the last lookup's counts.
        nearMeLoading = true;
        nearMeRecords = [];
        nearMeFound = 0;
        nearMeAccuracyM = 0;
        nearMeLayerErrors.clear();
        openRecord = null;
        showNearMeList();
      } else {
        nearMeLoading = false;
        nearMeRecords = [];
        // A record reached from the list loses its back affordance (there
        // is no longer a list behind it) but stays open — only the list
        // itself, with nothing left to show, closes outright.
        if (sheetMode === 'list') closeSheet();
        else detailEl.querySelector('[data-nearme-back]')?.remove();
      }
    },
    onSelect: (feature, layer) => handleSelect(feature, layer),
    onCounts: (counts) => {
      for (const [id, { shown }] of Object.entries(counts)) {
        const el = document.querySelector(`[data-count="${id}"]`);
        if (el) el.textContent = String(shown);
      }
      // The per-value counts beside each filter checkbox track the same
      // underlying data this loop already reads — refreshed here so they
      // stay live the moment a layer's data (or its filters) change,
      // without a second event to wire up. `refreshFilterCounts` is a
      // hoisted function declaration further down this same script.
      refreshFilterCounts();
    },
    onLoadStart: (id) => {
      setLayerRowBusy(id, true);
      setLayerRowSummary(id, S.loading);
    },
    onLayerReady: (id) => {
      setLayerRowBusy(id, false);
      setLayerRowSummary(id, null);
      status(`${layerById.get(id)?.label ?? id} ✓`);
    },
    onError: (id, message) => {
      setLayerRowBusy(id, false);
      setLayerRowSummary(id, fill(S.layerLoadError, { message }));
      // The layer never actually loaded, so the checkbox showing it checked
      // is a lie about what's on the map — see mapController.ts's own
      // onError comment. Both halves of "off" happen here: the visible
      // control (the checkbox) and the controller's own `visible` state
      // (setLayerVisible), so a reader who re-checks it immediately after
      // gets a real retry rather than loadLayer's "already loaded" early
      // return doing nothing.
      const box = document.querySelector<HTMLInputElement>(`[data-layer-switch="${id}"]`);
      if (box) box.checked = false;
      const layer = layerById.get(id);
      if (layer) controller.setLayerVisible(layer, false);
      status(`${layerById.get(id)?.label ?? id}: ${message}`, 6000);
    },
  });

  // Below `lg` the detail panel is a sheet over the map rather than a sibling
  // beside it, so the map's own box no longer describes what the reader can
  // see. This is what lets a fit land above the sheet instead of behind it —
  // see setOverlay in mapController.ts.
  controller.setOverlay(detailEl);

  /*
   * Deep link from /near-me's "show on map" — ?lat=&lng=&zoom=. This flies
   * to the point only; it does not select or open a specific record, because
   * matching a URL coordinate back to one rendered feature (and simulating
   * the click) is real machinery this project doesn't have yet, and a
   * slightly-off match would be worse than none. Centring the map on the
   * right spot, at a zoom where the record is the obvious dot, is the honest
   * version of this link today.
   *
   * Deferred to the map's own 'load' rather than fired immediately: the
   * constructor's 'load' handler above fits METRO_BOUNDS the moment the
   * style finishes loading, which — fired after this ran eagerly — undid
   * the fly and silently stranded every deep link on the metro default.
   * `map.once('load', …)` queues behind that handler instead of racing it,
   * so this runs after the reset, not before it.
   */
  const deepLink = new URLSearchParams(window.location.search);
  const dLat = Number(deepLink.get('lat'));
  const dLng = Number(deepLink.get('lng'));
  if (Number.isFinite(dLat) && Number.isFinite(dLng) && dLat && dLng) {
    const dZoom = Number(deepLink.get('zoom'));
    const goToDeepLink = () => controller.flyTo([dLng, dLat], Number.isFinite(dZoom) && dZoom ? dZoom : 16);
    if (controller.map.loaded()) goToDeepLink();
    else controller.map.once('load', goToDeepLink);
  }

  /* ----------------------------- Detail panel ---------------------------- */

  const CONFIDENCE_TEXT: Record<string, string> = {
    confirmed: S.confidenceConfirmed,
    reported: S.confidenceReported,
    probabilistic: S.confidenceProbabilistic,
  };

  function el(tag: string, className?: string, text?: string) {
    const node = document.createElement(tag);
    if (className) node.className = className;
    if (text != null) node.textContent = text;
    return node;
  }

  /* ------------------------- Collapsible side panels ----------------------
     #controls (docks >=1024px) and #detail-panel (docks >=1280px, only
     while a record is selected) are independent, push-content panels — see
     global.css for the geometry these attributes drive, and
     mapController.ts's containerResize for what keeps the map's canvas in
     sync with the reflow toggling either one causes. */

  const MAP_LAYERS_COLLAPSED_KEY = 'mapLayersCollapsed';
  const MAP_NEWS_COLLAPSED_KEY = 'mapNewsCollapsed';

  /**
   * Collapse/expand one panel and its pull tab together. Mirrors
   * lib/theme.ts's localStorage try/catch pattern for the one persisted
   * key this feature has — #controls only; see setDetailOpen's callers and
   * the PERSISTENCE note below for why #detail-panel's own collapse state
   * is deliberately never written to storage.
   */
  function setPanelCollapsed(
    panelEl: HTMLElement,
    tabEl: HTMLElement,
    collapsed: boolean,
    storageKey?: string,
  ) {
    // Under reduced motion there is no width transition, so `transitionend`
    // for `width` never fires — setting data-animating here would leave it
    // stuck forever. Skipping it also means visibility flips in the same
    // frame as width instead of 200ms later (see global.css), which is
    // what keeps this to one resize instead of one per would-be frame.
    if (!REDUCED_MOTION) panelEl.setAttribute('data-animating', '');
    panelEl.toggleAttribute('data-collapsed', collapsed);
    tabEl.setAttribute('aria-expanded', String(!collapsed));
    // Move focus off whatever's inside the panel before `inert` is applied
    // — order matters: `inert` on an element that contains
    // document.activeElement can strand focus with nowhere to go.
    if (collapsed && panelEl.contains(document.activeElement)) tabEl.focus();
    panelEl.inert = collapsed;
    if (storageKey) {
      try {
        window.localStorage.setItem(storageKey, collapsed ? '1' : '0');
      } catch {
        // Storage can throw (e.g. Safari private browsing) — the toggle
        // above still takes effect for this page view, it just won't
        // persist.
      }
    }
  }

  // Attached once per panel, not once per toggle — clears data-animating
  // only when the *width* transition (not some unrelated property) is what
  // actually finished.
  function clearAnimatingOnWidthEnd(panelEl: HTMLElement) {
    panelEl.addEventListener('transitionend', (e) => {
      if (e.propertyName === 'width') panelEl.removeAttribute('data-animating');
    });
  }
  clearAnimatingOnWidthEnd(controlsEl);
  clearAnimatingOnWidthEnd(detailEl);
  if (newsDockEl) clearAnimatingOnWidthEnd(newsDockEl);

  // Both tabs wire up the same way — click toggles the panel's current
  // collapsed state — differing only in whether the state persists.
  function wireTab(panelEl: HTMLElement, tabEl: HTMLElement, storageKey?: string) {
    tabEl.addEventListener('click', () => {
      setPanelCollapsed(panelEl, tabEl, !panelEl.hasAttribute('data-collapsed'), storageKey);
    });
  }
  wireTab(controlsEl, layersTabEl, MAP_LAYERS_COLLAPSED_KEY);
  // No storageKey: #detail-panel's collapse state is intentionally
  // in-memory only. It is hidden-until-selected, and every explicit
  // selection force-expands it (see renderDetail below) — a persisted flag
  // could never be observed by anyone, so there is deliberately only the
  // one storage key, on #controls.
  wireTab(detailEl, detailTabEl);
  // Persisted, like #controls and unlike #detail-panel: how much chrome you
  // want standing beside the map is a preference, not a per-selection state.
  if (newsDockEl && newsTabEl) wireTab(newsDockEl, newsTabEl, MAP_NEWS_COLLAPSED_KEY);

  /**
   * The single place that shows/hides #detail-panel and its pull tab
   * together — routes every place that used to touch `detailEl.hidden`
   * directly (the no-selection branch of renderDetail, its own end, the
   * header close button, and the Escape key handler) through one function
   * so the tab can never end up visible over a hidden panel or vice versa.
   */
  function setDetailOpen(open: boolean) {
    detailEl.hidden = !open;
    detailTabEl.hidden = !open;
  }

  /*
   * `inert` has no breakpoint awareness, so it has to be kept in sync by hand.
   *
   * Each of these panels only ever collapses (visually, via CSS) above its own
   * breakpoint — #controls at >=1024px, #detail-panel and #news-dock at
   * >=1280px, matching the `@media (width >= 64rem)` and `(width >= 80rem)`
   * blocks in global.css. Without this, a reader who collapses a panel on a
   * desktop-width window and then narrows past that breakpoint (or loads the
   * persisted flag on a phone) gets a panel that CSS renders again but that is
   * still `inert` — unfocusable and invisible to a screen reader, with no
   * visible tab to undo it, since each tab is itself gated on the same
   * breakpoint.
   *
   * One function rather than three copies of the predicate: it was written out
   * per panel, and the third copy arrived with the news dock. Three
   * implementations of one invariant is three places for it to stop agreeing,
   * and only the dock's is covered by a test.
   *
   * One MediaQueryList per breakpoint, not a fresh one per call — matchMedia()
   * allocates, and these run on every dock/undock as well as at startup.
   */
  const controlsDockMql = window.matchMedia('(width >= 64rem)');
  const detailDockMql = window.matchMedia('(width >= 80rem)');

  function inertSync(el: HTMLElement | null, mql: MediaQueryList): () => void {
    const sync = () => {
      if (el) el.inert = el.hasAttribute('data-collapsed') && mql.matches;
    };
    mql.addEventListener('change', sync);
    return sync;
  }

  const syncControlsInert = inertSync(controlsEl, controlsDockMql);
  const syncDetailInert = inertSync(detailEl, detailDockMql);
  const syncNewsInert = inertSync(newsDockEl, detailDockMql);

  // Sync the tabs' chrome to whatever /panels-init.js already stamped on
  // #controls pre-paint (or to the untouched default, if it stamped
  // nothing), then reveal both — see NO-JS in the panels spec for why they
  // ship `hidden` in the markup rather than being visible from the start.
  // [data-ready] goes on last: it's what turns transitions on, and doing
  // that after this sync is what keeps a restored collapsed state from
  // visibly animating open on load.
  {
    const startCollapsed = controlsEl.hasAttribute('data-collapsed');
    layersTabEl.setAttribute('aria-expanded', String(!startCollapsed));
    syncControlsInert();
    syncDetailInert();
    layersTabEl.hidden = false;
    setDetailOpen(false);
    controlsEl.setAttribute('data-ready', '');
    detailEl.setAttribute('data-ready', '');

    // Same order as #controls above: sync the tab's chrome to whatever
    // /panels-init.js already stamped, then reveal, then turn transitions on —
    // so a dock restored collapsed does not animate open on load.
    if (newsDockEl && newsTabEl) {
      newsTabEl.setAttribute(
        'aria-expanded',
        String(!newsDockEl.hasAttribute('data-collapsed')),
      );
      syncNewsInert();
      newsTabEl.hidden = false;
      newsDockEl.setAttribute('data-ready', '');
    }
  }

  /* --------------------------- Near-me DOM list --------------------------
     A real DOM record list for "what's near me", reusing #detail-panel's
     existing bottom-sheet/sidebar shell (see setOverlay above) rather than a
     second sheet — the sheet now has three states: 'closed' (today's
     default/empty), 'list' (near-me's own record list) and 'record' (a
     single selected feature — the panel's pre-existing content, unchanged,
     optionally reached from the list with a back affordance). See #135.
  */

  type SheetMode = 'closed' | 'list' | 'record';
  let sheetMode: SheetMode = 'closed';

  let nearMeActive = false;
  let nearMeLoading = false;
  // nearMeShown deliberately doesn't exist as its own field: it's always
  // exactly nearMeRecords.length (both onNearMeResult's `shown` and
  // onNearMeRecords's `records` are built from the same targets/records
  // arrays in mapController.ts's applyNearMeRadius, under the identical
  // NEARME_MAX_LINES condition) — a second field here would just be a
  // second place for the two to silently disagree.
  let nearMeRecords: { layerId: string; featureId: string; distanceM: number }[] = [];
  let nearMeFound = 0;
  let nearMeAccuracyM = 0;
  const nearMeLayerErrors = new Map<string, string>();

  /*
   * NearMeRadiusControl (mapController.ts) mounts as a MapLibre corner
   * popover by default. Below `xl` that floating popover is easy to miss —
   * the reader is already looking at this sheet's own header, so the
   * slider's primary, reachable home there is inline in it instead.
   *
   * There is only ever one live `<input>` — this reparents the control's
   * *own* DOM node (its onAdd() container is a plain detached-appendable
   * element with no MapLibre-internal dependency on staying inside the
   * corner-controls container) rather than building a second slider that
   * would have to stay synced with it.
   *
   * `nearMeRadiusMobileSlot` is the fixed point that makes this survive
   * renderNearMeList's own frequent full rebuilds of the sheet header: the
   * *decision* of which container (the corner stack vs. this slot) the
   * radius control's node belongs in is only re-evaluated on load and on
   * a breakpoint change (see syncNearMeRadiusPlacement), never on every
   * sheet render — but the slot itself still has to be re-inserted into
   * whatever fresh header DOM renderNearMeList just built, or its
   * still-attached child (the radius control) would vanish along with the
   * old header when detailEl.textContent is cleared. Moving this empty
   * wrapper along with a header rebuild isn't the reparent decision this
   * comment is describing — it's just the slot going where the header goes.
   */
  const nearMeRadiusMobileSlot = document.createElement('div');
  nearMeRadiusMobileSlot.className = 'nearme-radius-slot';

  /**
   * Moves the radius control's real DOM node between the corner-controls
   * stack (`>=xl`, matching #detail-panel's own dock breakpoint —
   * `detailDockMql`, declared above alongside #detail-panel's own dock
   * sync) and `nearMeRadiusMobileSlot`, and — while docked in the corner
   * stack — realigns its vertical position to the near-me button's own
   * centre (see below). Called once on load, on every breakpoint crossing,
   * and on every onNearMeModeChange (resetViewControl hiding/showing
   * alongside that same event shifts the near-me button up or down one
   * slot in the column, which the alignment has to track) — not on every
   * sheet-mode change beyond that, per this feature's own spec. `--inline`
   * is the JS-toggled modifier class global.css's `.near-me-radius-control`
   * rules key off of to swap from floating-popover positioning to laying
   * out inline within whatever flex row it's currently parented in.
   */
  function syncNearMeRadiusPlacement() {
    const radiusEl = document.querySelector<HTMLElement>('.near-me-radius-control');
    const cornerControlsEl = document.getElementById('map-corner-controls');
    if (!radiusEl) return;
    if (detailDockMql.matches) {
      if (radiusEl.parentElement !== cornerControlsEl) cornerControlsEl?.appendChild(radiusEl);
      radiusEl.classList.remove('near-me-radius-control--inline');
      // Align the popover's own vertical centre with the "near me" button's
      // centre specifically, not global.css's plain `top: 50%` fallback
      // (the corner stack's own middle) — the stack holds more than two
      // evenly-sized siblings (theme toggle, reset, near-me, zoom buttons,
      // attribution), so the stack's middle and the near-me button's own
      // middle are two different pixels. `.maplibregl-ctrl-group` is the
      // button's own container and cornerControlsEl's direct child, so its
      // `offsetTop` is already in the same coordinate space radiusEl's own
      // `top` resolves against.
      const nearMeGroup = cornerControlsEl
        ?.querySelector<HTMLElement>('.near-me-control-button')
        ?.closest<HTMLElement>('.maplibregl-ctrl-group');
      if (nearMeGroup) {
        radiusEl.style.top = `${nearMeGroup.offsetTop + nearMeGroup.offsetHeight / 2}px`;
      }
    } else {
      if (radiusEl.parentElement !== nearMeRadiusMobileSlot) nearMeRadiusMobileSlot.appendChild(radiusEl);
      radiusEl.classList.add('near-me-radius-control--inline');
      radiusEl.style.top = '';
    }
  }
  detailDockMql.addEventListener('change', syncNearMeRadiusPlacement);
  syncNearMeRadiusPlacement();

  // The record currently open, if any — kept independent of `sheetMode` so
  // returning from 'record' to 'list' (the back affordance) can still
  // highlight and scroll to the row it came from, and so a radius commit
  // that drops a still-open record out of range can tell (see
  // onNearMeRecords below) without losing track of which record that was.
  let openRecord: { layerId: string; featureId: string } | null = null;
  // Set just before an explicit list-row tap calls focusFeature, consumed
  // once by handleSelect — the one signal that distinguishes "reached this
  // record from the list" (move focus to the resulting back button) from
  // any other route to the same record (a map tap, search, a cross-source
  // jump), which get the back button when applicable but not the focus move.
  let focusBackOnNextRow = false;

  const fmtMiles = formatMiles;

  /** True when this row's `entityKey` attribute is blank — shared by nearMeEntityName's fallback and buildNearMeRow's coordinates line, so the two can never disagree about which rows are "unattributed" (and, via isUnattributedValue, can never disagree with /near-me's own identical check either). */
  function nearMeIsUnattributed(layer: (typeof layers)[number], feature: LoadedFeature): boolean {
    const key = layer.nearMeList?.entityKey;
    return isUnattributedValue(key ? feature.properties.attributes?.[key] : null);
  }

  function nearMeEntityName(layer: (typeof layers)[number], feature: LoadedFeature): string {
    if (!nearMeIsUnattributed(layer, feature)) {
      return String(feature.properties.attributes?.[layer.nearMeList!.entityKey!]);
    }
    // A layer that names its own unattributedLabel (see registry.ts's alpr
    // entry) gets that instead of the generic fallback — the same camera
    // must not read as "No operator recorded" here and "ALPR Camera" on
    // /near-me (NearMe.astro's own listRow honors the same field).
    return layer.nearMeList?.unattributedLabel ?? S.entityUnattributed;
  }

  function nearMeDetailLines(layer: (typeof layers)[number], feature: LoadedFeature): string[] {
    const out: string[] = [];
    for (const d of layer.nearMeList?.detail ?? []) {
      const value = feature.properties.attributes?.[d.key];
      if (isUnattributedValue(value)) continue;
      out.push(`${d.label}: ${value}`);
    }
    return out;
  }

  // "Did this record's other-source match" — one shared predicate for the
  // near-me list's cross-listed marker, the search results list's sr-only
  // suffix, and the detail panel's own `matched` check, which independently
  // retyped this same `crossSourceSiteId != null` test three times before
  // (one of the three used a bare truthy check instead, which happens to
  // agree with `!= null` for every real site id but is worth not leaving as
  // a second, subtly different spelling of the same rule). Deliberately
  // `crossSourceSiteId` (a confirmed match) only, not a near-miss: every
  // caller's own marker mirrors the map's brass ring, which
  // alpr-cross-source.mjs only ever draws solid for a real match.
  function isCrossListed(layer: ClientLayer, feature: LoadedFeature): boolean {
    return !!(layer.crossSource && feature.properties.attributes?.crossSourceSiteId != null);
  }

  /** A near-me record resolved back to its own feature/layer, for rendering. */
  function resolveNearMeRow(record: { layerId: string; featureId: string; distanceM: number }) {
    const layer = layerById.get(record.layerId);
    if (!layer) return null;
    const feature = controller.getFeatureById(layer.id, record.featureId);
    if (!feature) return null;
    return { record, layer, feature };
  }

  /** One row — see the mobile-list spec's exact markup this mirrors. */
  function buildNearMeRow(resolved: NonNullable<ReturnType<typeof resolveNearMeRow>>) {
    const { record, layer, feature } = resolved;
    const isOpen = openRecord?.layerId === layer.id && openRecord?.featureId === feature.properties.id;

    const li = el('li', 'border-l-2');
    li.style.borderColor = `var(--layer-color-${layer.id})`;

    const button = el(
      'button',
      `flex w-full min-h-11 flex-col text-left px-3 py-2 hover:bg-ink-800 active:bg-ink-800${isOpen ? ' bg-ink-850' : ''}`,
    );
    button.setAttribute('type', 'button');
    if (isOpen) button.setAttribute('aria-current', 'true');
    button.setAttribute('data-nearme-row', `${layer.id}::${feature.properties.id}`);

    const entityName = nearMeEntityName(layer, feature);
    const distanceText = `${fmtMiles(record.distanceM)} mi`;
    const topRow = el('div', 'flex items-baseline justify-between gap-x-3 gap-y-0.5');
    topRow.append(
      el('span', `min-w-0 flex-1 truncate text-sm ${isOpen ? 'text-accent' : 'text-ink-100'}`, entityName),
      el('span', 'shrink-0 font-mono text-xs text-ink-400', distanceText),
    );
    button.append(topRow);

    const ariaParts = [`${entityName}, ${distanceText}`];

    // One "secondary" line under the entity/distance row — detail text,
    // coordinates, and the cross-listed marker each used to build this same
    // div/attribute/append shape independently.
    function appendSecondaryLine(className: string, text = '') {
      const div = el('div', `mt-0.5 ${className}`, text);
      div.setAttribute('data-nearme-row-secondary', '');
      button.append(div);
      return div;
    }

    const detailLines = nearMeDetailLines(layer, feature);
    if (detailLines.length) {
      appendSecondaryLine('text-xs text-ink-400', detailLines.join(' · '));
      ariaParts.push(detailLines.join('. '));
    }

    // The record's own position — only for a row that has no operator name
    // to show in its place, and only in addition to the camera-type detail
    // line above, never instead of it. See
    // NearMeSummary.list.showCoordsWhenUnattributed's own comment.
    if (
      layer.nearMeList?.showCoordsWhenUnattributed &&
      nearMeIsUnattributed(layer, feature) &&
      feature.geometry.type === 'Point'
    ) {
      const coordsText = formatCoords(feature.geometry.coordinates as [number, number]);
      appendSecondaryLine('font-mono text-xs text-ink-400', coordsText);
      ariaParts.push(coordsText);
    }

    const crossListed = isCrossListed(layer, feature);
    if (crossListed && layer.crossSource) {
      const crossDiv = appendSecondaryLine('flex items-center gap-1 text-xs');
      crossDiv.style.color = 'var(--color-cross-source-ring)';
      const svg = document.createElementNS('http://www.w3.org/2000/svg', 'svg');
      svg.setAttribute('width', '10');
      svg.setAttribute('height', '10');
      svg.setAttribute('viewBox', '0 0 10 10');
      svg.setAttribute('aria-hidden', 'true');
      for (const cx of [4, 6.5]) {
        const circle = document.createElementNS('http://www.w3.org/2000/svg', 'circle');
        circle.setAttribute('cx', String(cx));
        circle.setAttribute('cy', '5');
        circle.setAttribute('r', '3');
        circle.setAttribute('fill', 'none');
        circle.setAttribute('stroke', 'currentColor');
        circle.setAttribute('stroke-width', '1');
        svg.append(circle);
      }
      crossDiv.append(svg, document.createTextNode(S.mapNearMeCrossListed));
      ariaParts.push(layer.crossSource.searchSuffix);
    }

    button.setAttribute('aria-label', ariaParts.join('. '));
    button.addEventListener('click', () => {
      focusBackOnNextRow = true;
      controller.focusFeature(layer.id, feature.properties.id);
      // focusFeature is synchronous and, when the feature still resolves,
      // calls onSelect (which reads and clears this flag) before returning.
      // If it's still true here, the feature couldn't be found — data
      // evicted/replaced between this row being built and the click — and
      // onSelect never ran. Clear it defensively so the *next*, unrelated
      // selection doesn't inherit a stale "focus the back button" request
      // and steal focus the reader never asked for.
      focusBackOnNextRow = false;
    });

    li.append(button);
    return li;
  }

  /** Renders the 'list' sheet state — near-me's own record list. */
  function renderNearMeList() {
    detailEl.textContent = '';
    detailTabNameEl.textContent = fill(S.mapNearMeListTabSuffix, { count: nearMeRecords.length });

    // Sticky, not just a static header above a long scroll: detailEl
    // (#detail-panel) is the scrolling element itself, and this header is
    // its direct child, so `sticky top-0` pins it to the viewport's own top
    // as the row list scrolls beneath — "ALPRs Near Me" and the radius
    // slider stay reachable without scrolling back up. `bg-ink-900` (the
    // panel's own background) is required, not decorative: without an
    // opaque background of its own, a sticky element still paints *over*
    // whatever scrolls under it, but with nothing there to paint, scrolled
    // rows would show straight through.
    const header = el(
      'div',
      'sticky top-0 z-10 flex items-start justify-between gap-2 border-b border-ink-800 bg-ink-900 p-3',
    );
    const titleWrap = el('div', 'min-w-0 flex-1');
    // The heading and the (possibly empty, at >=xl) mobile radius slot share
    // one row — the slider reads as acting on this heading specifically when
    // it sits right next to it, not below it. See nearMeRadiusMobileSlot's
    // own comment for why re-attaching it here on every render is not
    // itself the corner-vs-sheet placement decision.
    const headingRow = el('div', 'flex items-center justify-between gap-2');
    headingRow.append(el('h2', 'min-w-0 truncate text-base font-semibold leading-snug text-ink-100', S.mapNearMe));
    headingRow.append(nearMeRadiusMobileSlot);
    titleWrap.append(headingRow);
    // Not shown while loading: `.near-me-radius-input`'s DOM value is
    // whatever the *previous* near-me session left it at — reset() only
    // runs inside showNearMe, after geolocation resolves — so reopening
    // near-me could otherwise flash "0 found, 0 shown within {stale radius}
    // mi" for the loading window before the real default radius lands.
    // mapNearMeLoading (below, in `body`) already carries this state.
    const radiusInput = document.querySelector<HTMLInputElement>('.near-me-radius-input');
    if (radiusInput && !nearMeLoading) {
      titleWrap.append(
        el(
          'p',
          'mt-0.5 text-[11px] uppercase tracking-wider text-ink-400',
          fill(S.mapNearMeListSummary, { found: nearMeFound, shown: nearMeRecords.length, radius: radiusInput.value }),
        ),
      );
    }
    // No close (✕) button here on purpose — near-me's own map toggle
    // ("locate near me") is the one control that starts *and* ends this
    // mode, per its own onNearMeModeChange comment: turning it off already
    // calls closeSheet() itself, in the same place the sweep stops, the
    // mask hides, and the forced-clarity dot style resets. A second exit
    // control that only closed the sheet — the sweep/mask/pinned camera all
    // still running underneath, sonar sweep included — read as "back to the
    // regular map" when it wasn't; removing it makes the one real exit the
    // only exit.
    header.append(titleWrap);
    detailEl.append(header);

    const body = el('div', 'p-3');

    if (nearMeAccuracyM > 0 && metersToMiles(nearMeAccuracyM) >= LOW_ACCURACY_MILES) {
      body.append(
        el(
          'p',
          'mb-3 rounded-md border border-warn/30 bg-warn/5 p-3 text-xs leading-relaxed text-warn',
          fill(S.lowAccuracy, { accuracy: fmtMiles(nearMeAccuracyM) }),
        ),
      );
    }

    for (const [layerId, message] of nearMeLayerErrors) {
      body.append(
        el(
          'p',
          'mb-3 rounded-md border border-warn/30 bg-warn/5 p-3 text-xs leading-relaxed text-warn',
          fill(S.mapNearMeLayerError, { layer: layerById.get(layerId)?.label ?? layerId }) + ` (${message})`,
        ),
      );
    }

    if (nearMeLoading) {
      body.append(el('p', 'text-sm leading-relaxed text-ink-300', S.mapNearMeLoading));
    } else if (!nearMeRecords.length) {
      // Empty state — same populated-card-shape convention NearMe.astro's
      // own empty states use: the "nothing found" line plus every eligible
      // layer's own honest limit, not a shrunken placeholder.
      body.append(el('p', 'text-sm leading-relaxed text-ink-300', S.mapNearMeNone));
      for (const layer of layers) {
        if (layer.nearMeList?.caveat) {
          body.append(el('p', 'mt-2 text-xs leading-relaxed text-warn', layer.nearMeList.caveat));
        }
      }
    } else {
      const ul = el('ul', 'divide-y divide-ink-800');
      for (const record of nearMeRecords) {
        const resolved = resolveNearMeRow(record);
        if (resolved) ul.append(buildNearMeRow(resolved));
      }
      body.append(ul);

      const shownLayerIds = new Set(nearMeRecords.map((r) => r.layerId));
      for (const layer of layers) {
        if (shownLayerIds.has(layer.id) && layer.nearMeList?.caveat) {
          body.append(el('p', 'mt-3 text-xs leading-relaxed text-warn', layer.nearMeList.caveat));
        }
      }
    }

    detailEl.append(body);
    setDetailOpen(true);
  }

  /** Switches the sheet to 'list' — near-me's own entry point. */
  function showNearMeList() {
    sheetMode = 'list';
    renderNearMeList();
  }

  /**
   * The back affordance's own handler — returns to 'list' without losing
   * track of which record was open, then scrolls/focuses that row so the
   * reader lands back where they left off rather than at the top of a long
   * list. Also undoes the map's own half of the selection (deselectPoint):
   * the camera eases back to wherever it was before the reader zoomed into
   * this camera, and its focus-frame marker clears — a camera going back
   * to "not selected" without the map itself agreeing read as the record
   * panel and the map disagreeing about whether anything was still open.
   */
  function backToList() {
    controller.deselectPoint();
    sheetMode = 'list';
    renderNearMeList();
    if (!openRecord) return;
    const rowBtn = detailEl.querySelector<HTMLButtonElement>(
      `[data-nearme-row="${CSS.escape(`${openRecord.layerId}::${openRecord.featureId}`)}"]`,
    );
    if (!rowBtn) return;
    rowBtn.scrollIntoView({ behavior: REDUCED_MOTION ? 'auto' : 'smooth', block: 'nearest' });
    rowBtn.focus();
  }

  /** Closes the sheet fully — from 'list' or 'record' alike, one stage. */
  function closeSheet() {
    sheetMode = 'closed';
    openRecord = null;
    detailEl.textContent = '';
    setDetailOpen(false);
  }

  /**
   * MapController's onSelect funnel (map tap, search, /near-me deep link, a
   * cross-source jump) and every list-row tap alike. A record gets the
   * back-to-list affordance exactly when it is currently one of near-me's
   * own drawn candidates — not "was this reached from the list", which
   * would also have to cover a map tap landing on the same record the list
   * already names.
   *
   * Deselection (feature/layer both null — a map tap on empty space) falls
   * back to the near-me list, not a full close, while near-me is active:
   * "ALPRs Near Me" is the one modal a reader in that mode should always be
   * able to find their way back to short of actually toggling the mode
   * itself off (the near-me sheet's own header lost its ✕ for exactly this
   * reason — see renderNearMeList's own comment). Only when near-me is
   * *not* active does a deselecting tap close the sheet outright, its
   * original behaviour.
   */
  function handleSelect(feature: LoadedFeature | null, layer?: ClientLayer) {
    if (!feature || !layer) {
      if (nearMeActive) backToList();
      else closeSheet();
      return;
    }
    const featureId = feature.properties.id;
    const inNearMeList =
      nearMeActive && nearMeRecords.some((r) => r.layerId === layer.id && r.featureId === featureId);
    openRecord = { layerId: layer.id, featureId };
    sheetMode = 'record';
    const wantsFocus = focusBackOnNextRow;
    focusBackOnNextRow = false;
    const backBtn = renderDetail(feature, layer, inNearMeList ? backToList : undefined);
    if (wantsFocus) backBtn?.focus();
  }

  /**
   * Builds one record's content into #detail-panel. Called only with a real
   * feature/layer pair — deselection (a map tap on empty space, or the
   * sheet's own close controls) goes through closeSheet() instead, without
   * calling this at all; see handleSelect below. `back`, when given, is a
   * "what's near me" list this record belongs to — see handleSelect's own
   * comment on how that's decided — and gets prepended as the sheet's first
   * interactive element, ahead of the header's own close button, per the
   * mobile-list spec. Returns that back button (or null) so a caller that
   * just came from an explicit row tap can move focus onto it.
   */
  function renderDetail(feature: LoadedFeature, layer: ClientLayer, back?: () => void): HTMLButtonElement | null {
    detailEl.textContent = '';
    // An explicit selection is a request to see the record — force the
    // panel open even if the reader had pulled it closed for a previous
    // one. Hover cards are separate popup elements that never touch
    // #detail-panel, so nothing here needs to guard against a mere hover
    // reopening it. Routed through setPanelCollapsed (not a direct
    // attribute clear) so data-animating gets set the same as any other
    // expand — otherwise the CSS min-width pin never applies here and the
    // panel's freshly-rendered content squishes into place instead of
    // sliding open like every other expand does.
    if (detailEl.hasAttribute('data-collapsed')) {
      setPanelCollapsed(detailEl, detailTabEl, false);
    }
    const p = feature.properties;
    const attrs = p.attributes as Record<string, unknown>;
    detailTabNameEl.textContent = `, ${p.name}`;
    // A selection's only other observable effect is opening #detail-panel —
    // real for a sighted reader, invisible to one relying on #map-status.
    // Announced here, not in the onSelect callback itself, because this is
    // the one path every selection route (map tap, search, /near-me) funnels
    // through, same reason focusFeature's own selection logic lives in one
    // place rather than at each call site. See #131.
    status(fill(S.recordSelected, { layer: layer.label, name: p.name }));

    const header = el('div', 'flex items-start justify-between gap-2 border-b border-ink-800 p-3');
    const titleWrap = el('div', 'min-w-0');
    const badge = el('div', 'mb-1 flex items-center gap-1.5');
    const dot = el('span', 'h-2 w-2 rounded-full shrink-0');
    dot.setAttribute('style', `background:var(--layer-color-${layer.id})`);
    badge.append(dot, el('span', 'text-[11px] uppercase tracking-wider text-ink-400', layer.label));
    titleWrap.append(badge, el('h2', 'text-base font-semibold leading-snug text-ink-100', p.name));
    if (p.county) {
      titleWrap.append(el('p', 'mt-0.5 text-xs text-ink-400', `${p.county}, ${p.state}`));
    }
    // What kind of ground this shape actually is, for a name — a tract
    // number, a HOLC ID — that doesn't say so on its own. See
    // LayerDefinition.geometryNote's comment in layers/types.ts.
    if (layer.geometryNote) {
      titleWrap.append(el('p', 'mt-1 text-xs italic leading-snug text-ink-400', layer.geometryNote));
    }
    // The position itself, for a record that has one exactly — see
    // formatCoords's own comment on why six decimals.
    if (feature.geometry.type === 'Point') {
      titleWrap.append(
        el(
          'p',
          'mt-0.5 font-mono text-[11px] text-ink-400',
          formatCoords(feature.geometry.coordinates as [number, number]),
        ),
      );
    }

    // h-9 w-9, not the p-1 the glyph alone needs — this is the detail
    // panel's most-tapped mobile control (every selection opens the sheet
    // this closes), and a ~24px hit area is the WCAG AA floor, not a
    // comfortable one. Matches #close-compare's own h-8/w-8 sizing choice.
    const close = el(
      'button',
      'flex h-9 w-9 shrink-0 items-center justify-center rounded text-ink-400 hover:text-ink-100',
      '✕',
    );
    close.setAttribute('type', 'button');
    close.setAttribute('aria-label', S.closePanel);
    close.addEventListener('click', () => {
      closeSheet();
      (document.getElementById('map-search') as HTMLElement)?.focus();
    });
    header.append(titleWrap, close);

    const body = el('div', 'space-y-4 p-3');

    /*
      The way out of the panel.

      Sits above the raw fields rather than under the provenance at the
      bottom, because a reader who has decided to act has already decided —
      making them scroll past the licence to find the button is how a dead
      end gets rebuilt. The panel is narrow and scrolls; anything below the
      fold on a phone may as well not exist.

      What it carries is the whole point: the request template for this kind of
      record, the body to address, and where the record is, so the Take Action
      page can name the offices for that exact ground instead of starting the
      reader at a blank form.
    */
    if (layer.action) {
      const named =
        layer.action.bodyKey != null ? String(attrs[layer.action.bodyKey] ?? '').trim() : '';
      let addressee = named;
      if (!addressee) {
        if (layer.action.fallbackBody === 'name') addressee = p.name;
        else if (layer.action.fallbackBody === 'county' && p.county) addressee = p.county;
        else if (layer.action.fallbackBody === 'countySheriff' && p.county) {
          addressee = `${p.county} Sheriff's Office`;
        }
      }

      const params = new URLSearchParams({ type: layer.action.requestType });
      if (addressee) params.set('body', addressee);
      if (feature.geometry.type === 'Point') {
        const [lng, lat] = feature.geometry.coordinates as [number, number];
        params.set('at', `${lng.toFixed(5)},${lat.toFixed(5)}`);
      }

      const cta = el(
        'a',
        'block rounded-md bg-accent px-3 py-2 text-center text-sm font-medium text-on-accent hover:brightness-110',
        layer.action.label,
      );
      cta.setAttribute('href', `${ACT_PATH}?${params}`);
      body.append(cta);

      // Say who the letter will be addressed to before the reader commits to
      // a page change — and, where the operator is blank, say that instead of
      // quietly substituting the sheriff and letting them think we knew.
      body.append(
        el(
          'p',
          '-mt-2 text-[11px] leading-relaxed text-ink-400',
          named
            ? fill(S.actionAddressed, { body: addressee })
            : addressee
              ? fill(S.actionUnknownOperator, { body: addressee })
              : S.actionPickBody,
        ),
      );
    }

    // Layer-specific fields.
    const rows = layer.detailFields
      .map((f) => ({
        key: f.key,
        label: f.label,
        value: formatValue(attrs[f.key], f.format),
        format: f.format,
        pillLabels: f.pillLabels,
      }))
      .filter((r) => r.value !== null);

    if (rows.length) {
      const dl = el('dl', 'space-y-2');
      for (const row of rows) {
        const wrap = el('div');
        wrap.append(el('dt', 'text-[11px] uppercase tracking-wider text-ink-400', row.label));
        if (row.format === 'link') {
          const dd = el('dd', 'text-sm');
          const a = el('a', 'text-accent underline underline-offset-2 break-words', S.viewRecord);
          a.setAttribute('href', row.value!);
          a.setAttribute('target', '_blank');
          a.setAttribute('rel', 'noopener noreferrer');
          dd.append(a);
          wrap.append(dd);
        } else if (row.format === 'pills') {
          // One capsule per code, in source order. A code with no entry in
          // pillLabels still renders — Title Cased with underscores turned to
          // spaces — rather than being dropped: the source document names it,
          // even if this project's label map hasn't caught up yet.
          const dd = el('dd', 'flex flex-wrap gap-1.5');
          for (const code of row.value!.split(';').map((s) => s.trim()).filter(Boolean)) {
            const label =
              row.pillLabels?.[code] ??
              code.replace(/_/g, ' ').replace(/\b\w/g, (c) => c.toUpperCase());
            dd.append(
              el(
                'span',
                'inline-flex items-center rounded-full border border-ink-700 bg-ink-850 px-2 py-0.5 text-[11px] text-ink-200',
                label,
              ),
            );
          }
          wrap.append(dd);
        } else {
          const dd = el('dd', 'text-sm text-ink-100 break-words');
          // A row whose key drives the map's own fill color (categoryColors)
          // gets that same swatch beside its value here, the same pairing the
          // filter checkboxes already draw — one color, read the same way
          // wherever it shows up (see the filter list a few hundred lines up).
          const swatchColor =
            layer.categoryColors?.key === row.key
              ? (layer.categoryColors.colors.find((c) => c.value === attrs[row.key])?.color ??
                layer.categoryColors.fallback)
              : null;
          if (swatchColor) {
            const swatch = el('span', 'mr-1.5 inline-block h-2 w-2 rounded-full align-middle');
            swatch.style.background = swatchColor;
            dd.append(swatch);
          }
          dd.append(document.createTextNode(row.value!));
          wrap.append(dd);
        }
        dl.append(wrap);
      }
      body.append(dl);
    }

    // "Cross-listed corner" — a dedicated section, not a detailFields row,
    // because §1c requires the full explanation every time this shows, not a
    // value a reader can skim past. Always rendered when the layer names
    // crossSource, matched or not: an unmatched record needs the "this is
    // normal, not a finding" copy just as much as a matched one needs its
    // own caveats — see CLAUDE.md §1c and the registry's own comment on
    // LayerDefinition.crossSource.
    if (layer.crossSource) {
      const matched = isCrossListed(layer, feature);
      // A near miss only ever applies to an otherwise-unmatched record — see
      // LayerDefinition.crossSource.nearMiss's own comment — and only this
      // layer's crossSource block names the copy for it (alpr's has no use
      // for the key, so this falls through to plain `unmatched` there too).
      const nearMissText =
        !matched && attrs.crossSourceNearMiss === true ? layer.crossSource.nearMiss : undefined;
      const cross = el('div', 'rounded-md border border-ink-800 bg-ink-850 p-2.5');
      cross.append(el('h3', 'mb-1 text-[11px] uppercase tracking-wider text-ink-400', S.crossListedCorner));
      // The term's own definition (§0.9: every jargon term renders with an
      // inline gloss), separate from the record-specific paragraph below —
      // a reader who lands straight on this panel from search or "near me"
      // may never have seen the layer panel's `legend` row. Distinct field
      // from `legend` per LayerDefinition.crossSource's own comment: this
      // one is scoped to the bare term, not the static swatch row.
      cross.append(el('p', 'text-xs leading-relaxed text-ink-300', layer.crossSource.glossary));
      const body_ = matched
        ? fill(layer.crossSource.matched, {
            n: String(attrs.crossSourceCount ?? ''),
            d: String(attrs.crossSourceMeters ?? ''),
            agency: String(attrs.crossSourceAgencyName ?? ''),
          })
        : nearMissText
          ? fill(nearMissText, { d: String(attrs.crossSourceNearMissMeters ?? '') })
          : layer.crossSource.unmatched;
      cross.append(el('p', 'mt-1.5 text-xs leading-relaxed text-ink-200', body_));
      // A near miss names a *different* record — the filing that won the
      // tie — so give the reader a way to actually get there, per §0.6
      // ("what can be done"). crossSourceNearMissSiteId only ever appears
      // alongside nearMissText (see alpr-cross-source.mjs pass 3), so this
      // is gated the same way.
      if (nearMissText && attrs.crossSourceNearMissSiteId != null) {
        const siteId = String(attrs.crossSourceNearMissSiteId);
        const jump = el(
          'button',
          'mt-1.5 block text-xs text-accent underline underline-offset-2',
          S.crossSourceJumpToMatch,
        );
        jump.setAttribute('type', 'button');
        jump.addEventListener('click', () => controller.focusCrossSourceSite(layer.id, siteId));
        cross.append(jump);
      }
      // Not gated on `matched`: the losing filing in a contested pairing
      // between two different agencies never gets its own crossSourceSiteId
      // (see alpr-cross-source.mjs pass 2 — assignment always goes to the
      // *nearer* filing), so a matched-only guard here would silently drop
      // the contested flag for that record and show it the plain
      // "no record nearby" `unmatched` copy instead — which is false, since
      // a record within 50 m does exist, it just lost the tie.
      if (attrs.crossSourceContested) {
        cross.append(el('p', 'mt-1.5 text-xs leading-relaxed text-warn', layer.crossSource.contested));
      }
      if (matched && attrs.crossSourceAnchorAmbiguous) {
        cross.append(
          el('p', 'mt-1.5 text-xs leading-relaxed text-ink-300', layer.crossSource.ambiguousAnchor),
        );
      }
      body.append(cross);
    }

    // Confidence and limitations (spec F8).
    const conf = el('div');
    conf.append(
      el('h3', 'mb-1 text-[11px] uppercase tracking-wider text-ink-400', S.confidence),
      el('p', 'text-xs leading-relaxed text-warn', CONFIDENCE_TEXT[p.confidence] ?? p.confidence),
    );
    body.append(conf);

    if (layer.limitations.length) {
      const lim = el('div');
      lim.append(el('h3', 'mb-1 text-[11px] uppercase tracking-wider text-ink-400', S.limitations));
      const ul = el('ul', 'list-disc space-y-1 pl-4 text-xs leading-relaxed text-ink-300');
      for (const item of layer.limitations) ul.append(el('li', undefined, item));
      lim.append(ul);
      body.append(lim);
    }

    // Provenance travels with every record (spec F5, F7).
    const prov = el('div', 'border-t border-ink-800 pt-3 text-xs text-ink-400');
    const srcLine = el('p', 'break-words');
    srcLine.append(document.createTextNode(`${S.source}: `));
    const srcLink = el('a', 'text-ink-200 underline underline-offset-2', layer.source);
    srcLink.setAttribute('href', layer.sourceUrl);
    srcLink.setAttribute('target', '_blank');
    srcLink.setAttribute('rel', 'noopener noreferrer');
    srcLine.append(srcLink);
    prov.append(srcLine, el('p', 'mt-1', `${S.license}: ${layer.license}`));
    if (p.sourceDate) prov.append(el('p', 'mt-1', `${S.source}: ${p.sourceDate}`));
    body.append(prov);

    let backBtn: HTMLButtonElement | null = null;
    if (back) {
      backBtn = el(
        'button',
        'flex w-full min-h-9 items-center gap-1.5 border-b border-ink-800 px-3 py-2 text-left text-xs font-medium text-accent hover:bg-ink-800',
        `← ${S.mapNearMeBack}`,
      ) as HTMLButtonElement;
      backBtn.setAttribute('type', 'button');
      backBtn.setAttribute('data-nearme-back', '');
      backBtn.addEventListener('click', back);
      detailEl.append(backBtn);
    }
    detailEl.append(header, body);
    setDetailOpen(true);
    detailEl.scrollTop = 0;
    return backBtn;
  }

  /* ------------------------------ Controls ------------------------------ */

  /**
   * What a closed section says about itself.
   *
   * Read out of the switches rather than tracked separately, so the summary
   * line cannot claim a layer is on after something else has switched it off —
   * clearing the filters resets every switch, and this is what makes the
   * headings agree with the map afterwards.
   */
  const groupEls = document.querySelectorAll<HTMLDetailsElement>('[data-layer-group]');

  /**
   * Persist each category's open/closed state across reloads — extends the
   * anti-flash pattern panels-init.js already runs for #controls/#news-dock
   * (see that file's own comment on the third inclusion this reads back).
   * Stored densely: only categories a reader actually opened get an entry.
   */
  const LAYER_GROUPS_OPEN_KEY = 'mapLayerGroupsOpen';
  groupEls.forEach((group) => {
    group.addEventListener('toggle', () => {
      try {
        const raw = window.localStorage.getItem(LAYER_GROUPS_OPEN_KEY);
        const state: Record<string, boolean> = raw ? JSON.parse(raw) : {};
        const id = group.dataset.layerGroup!;
        if (group.open) state[id] = true;
        else delete state[id];
        window.localStorage.setItem(LAYER_GROUPS_OPEN_KEY, JSON.stringify(state));
      } catch {
        // Storage can throw (e.g. Safari private browsing) — the category
        // just doesn't remember its state for the next page view.
      }
    });
  });

  /**
   * A control's own boolean state — works for both the category-level
   * `role="switch"` button (state lives in `aria-checked`) and the
   * layer-level checkbox (state lives in `.checked`).
   */
  function isOn(el: Element): boolean {
    if (el instanceof HTMLInputElement) return el.checked;
    return el.getAttribute('aria-checked') === 'true';
  }
  function setOn(el: Element, on: boolean) {
    if (el instanceof HTMLInputElement) {
      el.checked = on;
      return;
    }
    el.setAttribute('aria-checked', String(on));
  }

  /**
   * Apply a desired on/off state to one switch (category bulk switch or
   * layer checkbox alike) and, if it actually changed anything, tell the
   * controller. Shared by every place that drives a *set* of switches toward
   * some target state — the category bulk switch, both branches of
   * `setNearMeLayerMode`, and `applyFilterStateFromUrl`'s `on` param — each
   * of which still builds and loops its own list of switches; only this
   * per-switch body is common to all four.
   */
  function applySwitchState(sw: HTMLElement, target: boolean): void {
    if (isOn(sw) === target) return;
    setOn(sw, target);
    const layer = layerById.get(sw.dataset.layerSwitch!);
    if (layer) controller.setLayerVisible(layer, target);
  }

  /**
   * The on-map keys, rebuilt from the switches' current state.
   *
   * Generated from the same categoryColors table as the paint expression and
   * the panel swatches, so the three cannot disagree. Every value is labelled
   * beneath its own segment when the values are short enough to fit; a longer
   * scale labels its two ends, which for an ordered ramp (decades, bands) is
   * the reading that matters.
   */
  const mapKeysEl = document.getElementById('map-keys');
  function refreshMapKeys() {
    if (!mapKeysEl) return;
    mapKeysEl.replaceChildren();
    for (const layer of layers) {
      const cc = layer.categoryColors;
      if (!cc || cc.showOnMapKey === false) continue;
      const btn = document.querySelector<HTMLElement>(`[data-layer-switch="${layer.id}"]`);
      if (!btn || !isOn(btn)) continue;

      const card = document.createElement('div');
      card.className = 'rounded-md border border-ink-800 bg-ink-900/85 px-2 py-1.5 backdrop-blur-sm';

      const title = document.createElement('p');
      title.className = 'mb-1 truncate text-[10px] leading-tight text-ink-300';
      title.textContent = cc.label;
      card.appendChild(title);

      const bar = document.createElement('div');
      bar.className = 'flex h-1.5 w-full overflow-hidden rounded-full border border-ink-800';
      for (const c of cc.colors) {
        const seg = document.createElement('span');
        seg.className = 'h-full flex-1';
        seg.style.background = c.color;
        bar.appendChild(seg);
      }
      card.appendChild(bar);

      const labelEach = cc.colors.every((c) => c.value.length <= 3);
      const row = document.createElement('p');
      row.className = 'mt-0.5 flex justify-between gap-1 text-[10px] leading-tight text-ink-400';
      const values = labelEach
        ? cc.colors.map((c) => c.value)
        : [cc.colors[0]?.value ?? '', cc.colors[cc.colors.length - 1]?.value ?? ''];
      for (const [i, value] of values.entries()) {
        const span = document.createElement('span');
        if (labelEach) span.className = 'flex-1 text-center';
        else span.className = i === 0 ? '' : 'text-right';
        span.textContent = value;
        row.appendChild(span);
      }
      card.appendChild(row);

      mapKeysEl.appendChild(card);
    }
  }

  /**
   * Refresh every category's own count badge, sr-only sentence, dots, and
   * bulk switch — and persist this drawer's open/closed `<details>` state.
   * A category's bulk switch reads "on" only when every one of its layers is
   * on; a mixed state (some on, some off) collapses to visually "off", per
   * the spec this shipped from — clicking it from either off or mixed turns
   * every layer in that one category on.
   */
  function refreshGroups() {
    groupEls.forEach((group) => {
      const switches = [...group.querySelectorAll<HTMLElement>('[data-layer-switch]')];
      const onCount = switches.filter((s) => isOn(s)).length;
      const onBadge = group.querySelector('[data-group-on]');
      if (onBadge) onBadge.textContent = String(onCount);
      const sr = group.querySelector('[data-group-sr]');
      if (sr) sr.textContent = fill(S.categoryLayersShown, { n: onCount, m: switches.length });
      const bulk = group.querySelector<HTMLButtonElement>('[data-category-switch]');
      if (bulk) setOn(bulk, switches.length > 0 && onCount === switches.length);
    });
    refreshMapKeys();
  }

  document.querySelectorAll<HTMLElement>('[data-layer-switch]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const layer = layerById.get(btn.dataset.layerSwitch!);
      // A checkbox's native click already flips `.checked` before this
      // listener runs, so `isOn(btn)` already reads the new state; a
      // `role="switch"` button has no such native behavior and still needs
      // an explicit flip.
      const next = btn instanceof HTMLInputElement ? btn.checked : !isOn(btn);
      if (!(btn instanceof HTMLInputElement)) setOn(btn, next);
      if (layer) controller.setLayerVisible(layer, next);
      refreshGroups();
      syncFilterStateToUrl();
    });
  });

  // Layers the registry marks `defaultOn` ship pre-checked (aria-checked
  //="true") in the markup, but nothing has told the controller yet — that
  // happens here, once, on load.
  document.querySelectorAll<HTMLElement>('[data-layer-switch]').forEach((btn) => {
    if (!isOn(btn)) return;
    const layer = layerById.get(btn.dataset.layerSwitch!);
    if (layer) controller.setLayerVisible(layer, true);
  });
  refreshGroups();

  /**
   * Category bulk switch (level 1). Always scoped to the one category it
   * lives in — `switches` below is queried from `group`, this category's own
   * `<details>`, never from the whole document — so there is deliberately no
   * control anywhere that can turn on every layer in every category at once.
   * Batched: N layers toggled in one click produce exactly one camera
   * decision and one status announcement, not N.
   */
  document.querySelectorAll<HTMLButtonElement>('[data-category-switch]').forEach((bulk) => {
    bulk.addEventListener('click', (event) => {
      // The switch now lives inside <summary>; without this the click would
      // also bubble into the browser's native summary-click handler and
      // toggle the <details> open/closed on top of flipping the switch.
      event.stopPropagation();
      const groupId = bulk.dataset.categorySwitch!;
      const group = document.querySelector<HTMLElement>(`[data-layer-group="${groupId}"]`);
      if (!group) return;
      const switches = [...group.querySelectorAll<HTMLElement>('[data-layer-switch]')];
      const allOn = switches.length > 0 && switches.every((s) => isOn(s));
      const turnOn = !allOn;
      controller.runBatched(() => {
        for (const sw of switches) applySwitchState(sw, turnOn);
      });
      refreshGroups();
      syncFilterStateToUrl();
      status(fill(S.categoryLayersShown, { n: turnOn ? switches.length : 0, m: switches.length }));
    });
  });

  // The layers "what's near me" itself searches — currently both ALPR
  // camera layers, but read from ClientLayer's own `nearMeRadiusMi` (see
  // that field's own comment in mapController.ts) rather than named here,
  // so a future radius-mode layer is included with no second edit. Only
  // these stay on while "near me" mode is active; everything else is
  // forced off for the duration.
  const nearMeOnlyLayerIds = new Set<string>(layers.filter((l) => l.nearMeRadiusMi).map((l) => l.id));
  // Snapshot of every switch's state from just before "near me"
  // forced its own set on — restored verbatim once the mode ends, so
  // leaving it doesn't cost the reader whatever they'd already switched on.
  // Null both before the first activation and again once restored, so a
  // second onNearMeModeChange(true) — MapController only ever fires one per
  // activation today, but nothing enforces that — can't clobber a real
  // prior state with the forced one.
  let nearMePriorLayerState: Map<string, boolean> | null = null;

  function setNearMeLayerMode(active: boolean) {
    const switches = [...document.querySelectorAll<HTMLElement>('[data-layer-switch]')];
    controller.runBatched(() => {
      if (active) {
        if (!nearMePriorLayerState) {
          nearMePriorLayerState = new Map(switches.map((s) => [s.dataset.layerSwitch!, isOn(s)]));
        }
        for (const sw of switches) {
          applySwitchState(sw, nearMeOnlyLayerIds.has(sw.dataset.layerSwitch!));
        }
      } else if (nearMePriorLayerState) {
        const prior = nearMePriorLayerState;
        nearMePriorLayerState = null;
        for (const sw of switches) {
          applySwitchState(sw, prior.get(sw.dataset.layerSwitch!) ?? false);
        }
      }
    });
    refreshGroups();
  }

  /**
   * The count beside each value checkbox, recalculated from
   * `controller.filteredFeatures` on every filter change — so the number a
   * reader sees always reflects whatever *other* filters are active on the
   * same layer, not a static build-time tally.
   */
  /**
   * Every value badge's count, recomputed. Grouped by (layerId, key) first
   * rather than looping `controller.filteredFeatures(layerId)` once per
   * badge: that used to mean a layer with V distinct filter values paid for
   * V independent full scans of its own feature array on every single
   * interaction anywhere in the panel — for `holc_appraisal_detail`
   * (11,561 features), one checkbox tick elsewhere on the page re-scanned
   * it once per value badge it has. Now each (layerId, key) pair scans its
   * layer's filtered features exactly once and tallies every value in that
   * one pass.
   */
  function refreshFilterCounts() {
    // layerId -> key -> that (layer, key) pair's badges.
    const byLayer = new Map<string, Map<string, { value: string; el: HTMLElement }[]>>();
    document.querySelectorAll<HTMLElement>('[data-filter-value-count]').forEach((el) => {
      const [layerId, key, value] = el.dataset.filterValueCount!.split(':');
      if (!layerId || !key || value === undefined) return;
      let byKey = byLayer.get(layerId);
      if (!byKey) byLayer.set(layerId, (byKey = new Map()));
      const badges = byKey.get(key);
      if (badges) badges.push({ value, el });
      else byKey.set(key, [{ value, el }]);
    });
    for (const [layerId, byKey] of byLayer) {
      const matches = controller.filteredFeatures(layerId);
      for (const [key, badges] of byKey) {
        const counts = new Map<string, number>();
        for (const f of matches) {
          const raw = (f.properties.attributes as Record<string, unknown>)[key];
          if (raw == null) continue;
          const v = String(raw);
          counts.set(v, (counts.get(v) ?? 0) + 1);
        }
        for (const { value, el } of badges) el.textContent = String(counts.get(value) ?? 0);
      }
    }
  }

  document.querySelectorAll<HTMLInputElement>('[data-filter-key]').forEach((input) => {
    input.addEventListener('change', () => {
      const layerId = input.dataset.filterLayer!;
      const key = input.dataset.filterKey!;
      const boxes = document.querySelectorAll<HTMLInputElement>(
        `[data-filter-layer="${layerId}"][data-filter-key="${key}"]`,
      );
      const checked = [...boxes].filter((c) => c.checked);
      // Every box ticked is the default, not a filter: pass the empty set so
      // the controller drops the key. Storing the full list instead would
      // read as an active narrowing — and would quietly exclude records whose
      // attribute is null, which no ticked box can name.
      controller.setFilter(
        layerId,
        key,
        new Set(checked.length === boxes.length ? [] : checked.map((c) => c.value)),
      );
      refreshFilterCounts();
      syncFilterStateToUrl();
    });
  });

  /**
   * The from/to pair of date-bound inputs for one layer/filter-key. Shared by
   * this section's own change listener, `syncFilterStateToUrl`, and
   * `applyFilterStateFromUrl` below — all three otherwise hand-built the same
   * two-selector pair independently.
   */
  function getDateBoundEls(
    layerId: string,
    key: string,
  ): { fromEl: HTMLInputElement | null; toEl: HTMLInputElement | null } {
    return {
      fromEl: document.querySelector<HTMLInputElement>(
        `[data-filter-layer="${layerId}"][data-filter-key="${key}"][data-date-bound="from"]`,
      ),
      toEl: document.querySelector<HTMLInputElement>(
        `[data-filter-layer="${layerId}"][data-filter-key="${key}"][data-date-bound="to"]`,
      ),
    };
  }

  /**
   * `dateRange` filters (level 3, e.g. agency_287g's "Date signed") — a
   * plain from/to date control wired straight to
   * `controller.setDateRangeFilter`. Fixes the pre-existing bug where
   * `dateRange`-kind filters were declared in the registry but silently
   * dropped from the panel (see clientLayers' own `filters` comment above).
   */
  document.querySelectorAll<HTMLInputElement>('[data-date-bound]').forEach((input) => {
    input.addEventListener('change', () => {
      const layerId = input.dataset.filterLayer!;
      const key = input.dataset.filterKey!;
      const { fromEl, toEl } = getDateBoundEls(layerId, key);
      controller.setDateRangeFilter(layerId, key, {
        from: fromEl?.value || undefined,
        to: toEl?.value || undefined,
      });
      refreshFilterCounts();
      syncFilterStateToUrl();
    });
  });

  /**
   * "Reset to default" (level 3) — restores each value's own
   * `defaultExcluded`-driven default state, not a blanket "select all".
   * Batched for the same reason the category bulk switch is: one click can
   * touch many checkboxes, but the round trip only happens once.
   */
  document.querySelectorAll<HTMLButtonElement>('[data-filter-reset]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const layerId = btn.dataset.filterReset!;
      const key = btn.dataset.filterResetKey!;
      const layer = layerById.get(layerId);
      const filter = layer?.filters.find((f) => f.key === key);
      if (!layer || !filter) return;
      const boxes = document.querySelectorAll<HTMLInputElement>(
        `[data-filter-layer="${layerId}"][data-filter-key="${key}"]`,
      );
      controller.runBatched(() => {
        boxes.forEach((box) => {
          box.checked = !filter.defaultExcluded?.includes(box.value);
        });
        const allowed = filter.values.filter((v) => !filter.defaultExcluded?.includes(v));
        controller.setFilter(layerId, key, new Set(allowed.length === filter.values.length ? [] : allowed));
      });
      refreshFilterCounts();
      syncFilterStateToUrl();
      status(`${filter.label}: ${S.filterResetToDefault}`);
    });
  });

  /**
   * Search-within-values and search-within-layer-names (levels 3 and 2).
   * Plain substring match via the shared filterQuery module — see that
   * file's own header for why this is deliberately not fuzzy. A force-opened
   * group (via `.open = true`) is restored to whatever it was once the query
   * clears; a zero-match group is removed from view entirely rather than
   * left open and empty.
   *
   * One parameterized function behind both `wireValueSearch` and
   * `wireLayerSearch` below — the two only ever differed in which rows they
   * search, how to read a row's own text, where the empty-state message
   * goes, and what it says. The one behavioral difference that isn't just a
   * selector — value-search force-opens (and later restores) its enclosing
   * `<details>` while layer-search leaves its group's own open/closed state
   * alone — is `manageDetails`, opted into only by the caller that needs it.
   */
  function wireSearch(
    input: HTMLInputElement,
    opts: {
      list: HTMLElement | null;
      rowSelector: string;
      getRowText: (row: HTMLElement) => string;
      empty: HTMLElement | null;
      emptyText: (query: string) => string;
      manageDetails?: boolean;
    },
  ) {
    input.hidden = false;
    const { list, rowSelector, getRowText, empty, emptyText, manageDetails } = opts;
    if (!list) return;
    const rows = [...list.querySelectorAll<HTMLElement>(rowSelector)];
    const details = manageDetails ? input.closest('details') : null;
    let priorOpen: boolean | null = null;
    input.addEventListener('input', () => {
      const query = input.value;
      if (manageDetails && query.trim() && details && priorOpen === null) priorOpen = details.open;
      let anyVisible = false;
      for (const row of rows) {
        const matches = matchesQuery(getRowText(row), query);
        row.hidden = !matches;
        if (matches) anyVisible = true;
      }
      if (manageDetails) {
        if (query.trim()) {
          if (details) details.open = true;
        } else if (details && priorOpen !== null) {
          details.open = priorOpen;
          priorOpen = null;
        }
      }
      if (empty) {
        empty.hidden = anyVisible || !query.trim();
        if (!anyVisible && query.trim()) empty.textContent = emptyText(query);
      }
    });
  }

  function wireValueSearch(input: HTMLInputElement) {
    const layerId = input.dataset.filterValueSearch!;
    const key = input.dataset.filterValueSearchKey!;
    const layer = layerById.get(layerId);
    const filter = layer?.filters.find((f) => f.key === key);
    wireSearch(input, {
      list: document.querySelector<HTMLElement>(`[data-filter-value-list="${layerId}:${key}"]`),
      rowSelector: '[data-filter-value-row]',
      getRowText: (row) => row.dataset.filterValueText ?? '',
      empty: document.querySelector<HTMLElement>(`[data-filter-value-empty="${layerId}:${key}"]`),
      emptyText: (query) => fill(S.filterSearchValuesEmpty, { query, filter: filter?.label ?? '' }),
      manageDetails: true,
    });
  }
  document
    .querySelectorAll<HTMLInputElement>('[data-filter-value-search]')
    .forEach((input) => wireValueSearch(input));

  function wireLayerSearch(input: HTMLInputElement) {
    const groupId = input.dataset.layerSearch!;
    const groupEl = document.querySelector<HTMLElement>(`[data-layer-group="${groupId}"]`);
    const categoryLabel = groupEl?.querySelector('[data-category-label]')?.textContent ?? '';
    wireSearch(input, {
      list: document.querySelector<HTMLElement>(`[data-layer-list="${groupId}"]`),
      rowSelector: '[data-layer-row]',
      getRowText: (row) => row.dataset.layerName ?? '',
      empty: document.querySelector<HTMLElement>(`[data-layer-search-empty="${groupId}"]`),
      emptyText: (query) => fill(S.filterSearchLayersEmpty, { query, category: categoryLabel }),
    });
  }
  document.querySelectorAll<HTMLInputElement>('[data-layer-search]').forEach((input) => wireLayerSearch(input));

  /**
   * Everything the reader has narrowed the map by, put back to how it opened.
   *
   * "Filters" is whatever is currently hiding records, not just the value
   * checkboxes: a half-typed search still cuts the map down, so a clear that
   * ignores it leaves the reader looking at a subset while every control
   * claims otherwise. The layer
   * toggles go too: a control panel where every box is empty and the map is
   * still drawing something is a panel that is lying about its own state, so
   * clearing empties the map back to the basemap and leaves the reader to
   * switch on what they came for.
   */
  document.getElementById('clear-filters')?.addEventListener('click', () => {
    controller.runBatched(() => {
      document
        .querySelectorAll<HTMLInputElement>('[data-filter-key]')
        .forEach((c) => (c.checked = false));
      controller.clearFilters();

      document.querySelectorAll<HTMLInputElement>('[data-date-bound]').forEach((input) => {
        if (!input.value) return;
        input.value = '';
      });

      document.querySelectorAll<HTMLElement>('[data-layer-switch]').forEach((btn) => {
        setOn(btn, false);
        const layer = layerById.get(btn.dataset.layerSwitch!);
        if (layer) controller.setLayerVisible(layer, false);
      });
    });

    // Emptying the box is not enough on its own — the results list stays open
    // over the map until something re-runs the search. Re-running it on an
    // empty query is what closes it, and it is already the one piece of code
    // that knows how. The boundary outline goes with it: it is on the map
    // because of a search that is no longer there, and leaving a township
    // ringed after clearing the thing that ringed it reads as a filter still
    // running. Where the reader is looking is not ours to change — that is
    // what "reset view" is for, next to this.
    searchInput.value = '';
    runSearch('');
    controller.clearJurisdiction();
    document.querySelectorAll<HTMLInputElement>('[data-filter-value-search], [data-layer-search]').forEach((input) => {
      input.value = '';
      input.dispatchEvent(new Event('input'));
    });
    refreshGroups();
    refreshFilterCounts();
    syncFilterStateToUrl();

    status(S.filtersCleared);
  });

  /* ------------------------------- Compare ------------------------------- */

  const openCompareButton = document.getElementById('open-compare');
  const compareOverlay = document.getElementById('compare-overlay');
  const closeCompareButton = document.getElementById('close-compare');
  openCompareButton?.addEventListener('click', () => {
    if (compareOverlay) compareOverlay.hidden = false;
  });
  closeCompareButton?.addEventListener('click', () => {
    if (compareOverlay) compareOverlay.hidden = true;
  });
  window.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && compareOverlay && !compareOverlay.hidden) compareOverlay.hidden = true;
  });

  /* ------------------------------- Search ------------------------------- */

  const searchInput = document.getElementById('map-search') as HTMLInputElement;
  const searchResults = document.getElementById('search-results')!;

  /*
    Places, above records.

    The box has always said "Search a city, county, or agency" and has only
    ever searched records — so typing the name of the township you live in
    returned "no records match", which reads as "there is nothing here" rather
    than "this box does not do that". Now the governments come first, because
    somebody typing a place name is trying to get to a place, and a camera that
    merely happens to be tagged with that county is not what they meant.
  */
  let jurisdictionIndex: Jurisdiction[] = [];
  fetch('/data/reference/mn-jurisdictions.json')
    .then((r) => r.json())
    .then((doc) => {
      jurisdictionIndex = doc.jurisdictions ?? [];
    })
    .catch(() => {
      // Search still works over records; it just cannot find a township.
      jurisdictionIndex = [];
    });

  /**
   * Boundaries, fetched the first time somebody picks a place and not before.
   * 1.6 MB is a lot to spend on a map that may only ever be panned.
   */
  let shapes: Promise<{ features: any[] }> | null = null;
  function loadShapes() {
    shapes ??= fetch('/data/reference/mn-jurisdictions.geojson')
      .then((r) => (r.ok ? r.json() : { features: [] }))
      .catch(() => ({ features: [] }));
    return shapes;
  }

  async function focusJurisdiction(j: Jurisdiction) {
    // Move immediately on the index's interior point, then outline the
    // boundary when it arrives. Waiting for 1.6 MB before anything happens
    // makes a click feel broken on a slow connection.
    controller.flyTo([j.lng, j.lat], 11);
    const doc = await loadShapes();
    const match = doc.features.find((f: any) => f.properties?.geoid === j.geoid);
    if (match) controller.showJurisdiction(match);
  }

  function runSearch(query: string) {
    const q = query.trim().toLowerCase();
    searchResults.textContent = '';
    if (q.length < 2) {
      searchResults.classList.add('hidden');
      return;
    }

    const placeHits = jurisdictionIndex
      .filter((j) => j.name.toLowerCase().includes(q))
      .sort((a, b) => {
        const as = a.name.toLowerCase().startsWith(q) ? 0 : 1;
        const bs = b.name.toLowerCase().startsWith(q) ? 0 : 1;
        return as - bs || a.name.localeCompare(b.name);
      })
      .slice(0, 8);

    const hits: { layer: ClientLayer; feature: LoadedFeature }[] = [];
    for (const layer of layers) {
      for (const feature of controller.getFeatures(layer.id)) {
        const p = feature.properties;
        const haystack = `${p.name} ${p.county ?? ''} ${Object.values(p.attributes ?? {}).join(' ')}`;
        if (haystack.toLowerCase().includes(q)) hits.push({ layer, feature });
        if (hits.length >= 40) break;
      }
    }

    if (!placeHits.length && !hits.length) {
      searchResults.append(el('li', 'px-2.5 py-2 text-xs text-ink-400', S.noResults));
      searchResults.classList.remove('hidden');
      return;
    }

    for (const j of placeHits) {
      const li = el('li');
      li.setAttribute('role', 'option');
      const button = el(
        'button',
        'flex w-full items-start gap-2 px-2.5 py-1.5 text-left hover:bg-ink-800',
      );
      button.setAttribute('type', 'button');
      // An outline rather than a filled dot: a place is a frame, not a record.
      const ring = el('span', 'mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full border border-ink-300');
      const text = el('span', 'min-w-0');
      text.append(
        el('span', 'block truncate text-xs text-ink-100', displayName(j.name)),
        el('span', 'block truncate text-[11px] text-ink-400', j.county),
      );
      button.append(ring, text);
      button.addEventListener('click', () => {
        void focusJurisdiction(j);
        searchResults.classList.add('hidden');
      });
      li.append(button);
      searchResults.append(li);
    }

    for (const { layer, feature } of hits) {
      const li = el('li');
      li.setAttribute('role', 'option');
      const button = el(
        'button',
        'flex w-full items-start gap-2 px-2.5 py-1.5 text-left hover:bg-ink-800',
      );
      button.setAttribute('type', 'button');
      const dot = el('span', 'mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full');
      dot.setAttribute('style', `background:var(--layer-color-${layer.id})`);
      const text = el('span', 'min-w-0');
      text.append(
        el('span', 'block truncate text-xs text-ink-100', feature.properties.name),
        el('span', 'block truncate text-[11px] text-ink-400', feature.properties.county ?? layer.label),
      );
      // The ring/width difference the map draws for a matched record (see
      // mapController's crossSource paint case) is otherwise canvas-only —
      // this is the accessible copy of that state, on the one interface a
      // screen reader actually gets (spec §4). Real text, not aria-hidden.
      if (isCrossListed(layer, feature)) {
        text.append(el('span', 'sr-only', layer.crossSource!.searchSuffix));
      } else if (
        layer.crossSource?.nearMissSearchSuffix &&
        feature.properties.attributes.crossSourceNearMiss
      ) {
        text.append(el('span', 'sr-only', layer.crossSource.nearMissSearchSuffix));
      }
      button.append(dot, text);
      button.addEventListener('click', () => {
        controller.focusFeature(layer.id, feature.properties.id);
        searchResults.classList.add('hidden');
      });
      li.append(button);
      searchResults.append(li);
    }
    searchResults.classList.remove('hidden');
  }

  let searchTimer: number;
  searchInput.addEventListener('input', () => {
    window.clearTimeout(searchTimer);
    searchTimer = window.setTimeout(() => runSearch(searchInput.value), 140);
  });
  searchInput.addEventListener('blur', () => {
    // Delay so a click on a result still registers.
    window.setTimeout(() => searchResults.classList.add('hidden'), 180);
  });

  /* --------------------------- Layers drawer --------------------------- */

  // Below `lg` the layers list is an overlay under the search row rather than
  // a block of the page the map has to share height with — see #controls.
  // Above `lg` the same element is the sidebar, always shown, and the button
  // driving this is display:none, so the attribute is simply ignored there.
  const layerDrawer = document.getElementById('layer-drawer')!;
  const layersToggle = document.getElementById('layers-toggle')!;

  function setDrawerOpen(open: boolean) {
    layerDrawer.toggleAttribute('data-open', open);
    layersToggle.setAttribute('aria-expanded', String(open));
  }

  layersToggle.addEventListener('click', () => {
    setDrawerOpen(!layerDrawer.hasAttribute('data-open'));
  });

  // A tap on the map is the reader going back to the map. Leaving the drawer
  // up over what they just tapped is the one thing it must not do.
  mapEl.addEventListener('pointerdown', () => setDrawerOpen(false));

  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape') return;
    // Innermost first: the drawer is drawn over the panel, so one Escape
    // should dismiss what is actually on top rather than both at once.
    if (layerDrawer.hasAttribute('data-open')) {
      setDrawerOpen(false);
      layersToggle.focus();
      return;
    }
    // One stage regardless of sheet state — 'list' or 'record' alike closes
    // outright, not back-to-list-then-closed. See closeSheet's own comment.
    if (!detailEl.hidden) closeSheet();
  });

  /* ---------------------------- Shareable URL ---------------------------- */

  /**
   * Filter state as URL query params — layer toggles: `on=id,id`; enum
   * filter values: `f.<layerId>.<key>=value,value`, written only when the
   * filter is actively narrowing (some but not all values ticked), the same
   * "empty set means no filter" rule `setFilter`'s own caller already
   * follows; `dateRange` filters: `fd.<layerId>.<key>=from,to`, either side
   * blank when unset. Purely client-side (§4: "near me" never round-trips a
   * location, and this doesn't either) — `history.replaceState` only, no
   * navigation and no server involved. Deliberately leaves `lat`/`lng`/
   * `zoom` (the /near-me deep link, see above) and any other existing query
   * param untouched, clearing only the keys this function itself owns.
   */
  function syncFilterStateToUrl() {
    const url = new URL(window.location.href);
    for (const key of [...url.searchParams.keys()]) {
      if (key === 'on' || key.startsWith('f.') || key.startsWith('fd.')) url.searchParams.delete(key);
    }
    const onIds = [...document.querySelectorAll<HTMLElement>('[data-layer-switch]')]
      .filter((btn) => isOn(btn))
      .map((btn) => btn.dataset.layerSwitch!);
    if (onIds.length) url.searchParams.set('on', onIds.join(','));
    for (const layer of layers) {
      for (const filter of layer.filters) {
        if (filter.kind === 'dateRange') {
          const { fromEl, toEl } = getDateBoundEls(layer.id, filter.key);
          if (fromEl?.value || toEl?.value) {
            url.searchParams.set(`fd.${layer.id}.${filter.key}`, `${fromEl?.value ?? ''},${toEl?.value ?? ''}`);
          }
        } else {
          const boxes = [
            ...document.querySelectorAll<HTMLInputElement>(
              `[data-filter-layer="${layer.id}"][data-filter-key="${filter.key}"]`,
            ),
          ];
          const checked = boxes.filter((b) => b.checked);
          if (checked.length > 0 && checked.length < boxes.length) {
            url.searchParams.set(`f.${layer.id}.${filter.key}`, checked.map((b) => b.value).join(','));
          }
        }
      }
    }
    history.replaceState(null, '', url);
  }

  /** The inverse of `syncFilterStateToUrl` — applies `?on=`/`?f.…=`/`?fd.…=` from the URL that loaded this page. */
  function applyFilterStateFromUrl() {
    const params = new URLSearchParams(window.location.search);
    if (![...params.keys()].some((k) => k === 'on' || k.startsWith('f.') || k.startsWith('fd.'))) return;
    controller.runBatched(() => {
      const onParam = params.get('on');
      if (onParam !== null) {
        const onSet = new Set(onParam.split(',').filter(Boolean));
        document.querySelectorAll<HTMLElement>('[data-layer-switch]').forEach((btn) => {
          applySwitchState(btn, onSet.has(btn.dataset.layerSwitch!));
        });
      }
      for (const [key, value] of params.entries()) {
        if (key.startsWith('f.')) {
          const [, layerId, filterKey] = key.split('.');
          if (!layerId || !filterKey) continue;
          const values = new Set(value.split(',').filter(Boolean));
          document
            .querySelectorAll<HTMLInputElement>(`[data-filter-layer="${layerId}"][data-filter-key="${filterKey}"]`)
            .forEach((box) => (box.checked = values.has(box.value)));
          controller.setFilter(layerId, filterKey, values);
        } else if (key.startsWith('fd.')) {
          const [, layerId, filterKey] = key.split('.');
          if (!layerId || !filterKey) continue;
          const [from, to] = value.split(',');
          const { fromEl, toEl } = getDateBoundEls(layerId, filterKey);
          if (fromEl) fromEl.value = from ?? '';
          if (toEl) toEl.value = to ?? '';
          controller.setDateRangeFilter(layerId, filterKey, { from: from || undefined, to: to || undefined });
        }
      }
    });
    refreshGroups();
    refreshFilterCounts();
  }

  /* ------------------------------ Start-up ------------------------------ */

  // Nothing draws until the reader switches it on — the map opens on the
  // basemap alone, for now. (The cameras used to open pre-drawn; restore
  // them to this list to bring that back.)
  const DEFAULT_ON: string[] = [];

  // Some filters open already narrowed — a withdrawn data-center proposal is
  // worth finding but should not be drawn as though it were a building. The
  // checkboxes were rendered pre-ticked; tell the controller the same thing, or
  // the panel and the map would disagree until the reader touched a box.
  for (const layer of layers) {
    for (const filter of layer.filters) {
      if (!filter.defaultExcluded?.length) continue;
      const allowed = filter.values.filter((v) => !filter.defaultExcluded!.includes(v));
      controller.setFilter(layer.id, filter.key, new Set(allowed));
    }
  }

  // A shared URL's filter state wins over both the registry defaults just
  // applied above and the switches' own pre-checked markup — loading a link
  // a reader shared should show exactly what they shared, not the site's
  // own opening state.
  applyFilterStateFromUrl();

  status(S.loading, 0);
  // A shared URL's `on=` param already decided which layers are on/off —
  // applyFilterStateFromUrl() ran above and its comment says the URL wins.
  // Checked again here, not just there: this runs later, inside `map.once
  // ('load', …)`, so without this check a DEFAULT_ON layer explicitly left
  // out of a shared link would sit correctly off for a moment and then get
  // silently forced back on the instant the map finished loading. Inert
  // today since DEFAULT_ON is empty, but the ordering bug ships regardless
  // of that and would only surface once someone repopulates it.
  const urlSpecifiedLayerState = new URLSearchParams(window.location.search).has('on');
  controller.map.once('load', () => {
    if (!urlSpecifiedLayerState) {
      for (const id of DEFAULT_ON) {
        const btn = document.querySelector<HTMLElement>(`[data-layer-switch="${id}"]`);
        const layer = layerById.get(id);
        if (btn && layer) {
          setOn(btn, true);
          controller.setLayerVisible(layer, true);
        }
      }
    }
    refreshGroups();
    status('', 400);
  });
</script>
