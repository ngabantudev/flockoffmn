---
import type { Locale } from '~/layers/types';
import { loadAllLayers, distinctValues } from '~/layers/data';
import { LAYER_CATEGORIES } from '~/layers/registry';
import { useTranslations, pick, localePath } from '~/lib/i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useTranslations(locale);

const loaded = await loadAllLayers();

// Serialise only what the browser needs. Filter values are computed at build
// time from the real data, so the controls can never offer a value that no
// record has.
const clientLayers = loaded.map(({ definition: d, collection }) => ({
  id: d.id,
  category: d.category,
  label: pick(d.label, locale),
  summary: pick(d.summary, locale),
  whatThisMeans: pick(d.whatThisMeans, locale),
  limitations: d.limitations.map((l) => pick(l, locale)),
  impactSpheres: d.impactSpheres?.map((s) => ({
    icon: s.icon,
    title: pick(s.title, locale),
    color: s.color,
    body: pick(s.body, locale),
    citation: s.citation,
    // The registry cannot know the locale, so an internal citation is written
    // as a sentinel there and resolved to a real, locale-correct path here —
    // the one place in the pipeline that has both.
    citationUrl: s.citationUrl === 'internal:sources' ? localePath(locale, '/sources') : s.citationUrl,
    citation2: s.citation2,
    citation2Url: s.citation2Url,
  })),
  color: d.color,
  colorLight: d.colorLight,
  pointStrokeColor: d.pointStrokeColor,
  geometry: d.geometry,
  // The panel's order is the draw order. Reading it off LAYER_CATEGORIES here
  // means a category can be moved, renamed or inserted in one place and the
  // map restacks itself to match, instead of the two drifting apart silently.
  stackRank: LAYER_CATEGORIES.findIndex((c) => c.id === d.category),
  bearingKey: d.bearingKey,
  scale: d.scale,
  blockAggregate: d.blockAggregate,
  categoryColors: d.categoryColors
    ? {
        key: d.categoryColors.key,
        label: pick(d.categoryColors.label, locale),
        colors: d.categoryColors.colors,
        fallback: d.categoryColors.fallback,
      }
    : undefined,
  labelBy: d.labelBy,
  polygonClick: d.polygonClick,
  weightBy: d.weightBy
    ? { key: d.weightBy.key, label: pick(d.weightBy.label, locale), stops: d.weightBy.stops }
    : undefined,
  opacity: d.opacity,
  dataPath: d.dataPath,
  filters: d.filters
    .filter((f) => f.kind === 'enum')
    .map((f) => ({
      key: f.key,
      label: pick(f.label, locale),
      kind: f.kind,
      values: distinctValues(collection, f.key),
      valueDescriptions: f.valueDescriptions
        ? Object.fromEntries(
            Object.entries(f.valueDescriptions).map(([v, text]) => [v, pick(text, locale)]),
          )
        : undefined,
      // Only the excluded values this layer actually has. A registry entry that
      // names a value the data no longer contains must not leave the filter
      // opening pre-ticked against nothing.
      defaultExcluded: (f.defaultExcluded ?? []).filter((v) =>
        distinctValues(collection, f.key).includes(v),
      ),
    }))
    .filter((f) => f.values.length > 1),
  detailFields: d.detailFields.map((f) => ({
    key: f.key,
    label: pick(f.label, locale),
    format: f.format,
  })),
  action: d.action
    ? {
        requestType: d.action.requestType,
        label: pick(d.action.label, locale),
        bodyKey: d.action.bodyKey,
        fallbackBody: d.action.fallbackBody,
      }
    : undefined,
  source: collection?.metadata.source ?? d.provenance.source,
  sourceUrl: collection?.metadata.sourceUrl ?? d.provenance.sourceUrl,
  license: collection?.metadata.license ?? d.provenance.license,
  featureCount: collection?.metadata.featureCount ?? 0,
}));

/*
  The panel, one shelf per kind of subject.

  Ordering inside a section stays the registry's `order`, because that ordering
  is already an argument about what to read first; the sections only decide
  which layers stand next to which. A layer naming a category this file has
  never heard of would otherwise vanish out of the panel while remaining on the
  map, which is exactly the silent kind of wrong the registry is meant to
  prevent — so it stops the build instead.
*/
const known = new Set(LAYER_CATEGORIES.map((c) => c.id));
const orphan = clientLayers.find((l) => !known.has(l.category));
if (orphan) {
  throw new Error(
    `Layer "${orphan.id}" has category "${orphan.category}", which is not in LAYER_CATEGORIES.`,
  );
}

const layerGroups = LAYER_CATEGORIES.map((category) => ({
  id: category.id,
  label: pick(category.label, locale),
  summary: pick(category.summary, locale),
  layers: clientLayers.filter((l) => l.category === category.id),
})).filter((group) => group.layers.length > 0);

const strings = {
  loading: t('loading'),
  noResults: t('noResults'),
  whatThisMeans: t('whatThisMeans'),
  limitations: t('limitations'),
  source: t('source'),
  license: t('license'),
  confidence: t('confidence'),
  viewRecord: t('viewRecord'),
  closePanel: t('closePanel'),
  confidenceConfirmed: t('confidenceConfirmed'),
  confidenceReported: t('confidenceReported'),
  confidenceProbabilistic: t('confidenceProbabilistic'),
  ofTotal: t('ofTotal'),
  actionAddressed: t('actionAddressed'),
  actionUnknownOperator: t('actionUnknownOperator'),
  actionPickBody: t('actionPickBody'),
  filtersCleared: t('filtersCleared'),
};
---

{/*
  One CSS custom property per layer, dark value as the default and a light
  override under two selectors — the same pair global.css's whole ink ramp
  uses, and both are required, not redundant: :root[data-theme='light'] is
  an explicit choice (the site theme toggle sets that attribute), while
  @media (prefers-color-scheme: light) : root:not([data-theme]) covers a
  visitor who has never touched the toggle and is just following their OS
  setting live via CSS, with no data-theme attribute for the first selector
  to match at all. Missing this second block was a real bug caught by
  actually loading the page with the OS set to light rather than trusting
  the pattern was copied correctly: every layer's panel swatch stayed on
  its dark value for exactly this (the far more common, toggle-never-
  touched) case. Only layers whose colour actually fails WCAG 3:1 on a
  light background carry a colorLight (see LayerDefinition's own comment in
  layers/types.ts); the rest just repeat `color`, which already clears the
  floor in both themes.

  This governs *panel/UI* colour and tracks *site* theme specifically. The
  map's own paint (dots, lines, fills) is a separate, independent question
  answered in mapController.ts by this.layerColor(), keyed to the current
  *basemap*'s dark/light state instead — the two aren't the same theme, see
  lib/theme.ts, and conflating them here would make a panel swatch that's
  right for the sidebar but wrong for what's actually drawn on the map, or
  the other way around.
*/}
<style set:html={`
  :root {
    ${clientLayers.map((l) => `--layer-color-${l.id}: ${l.color};`).join('\n    ')}
  }
  @media (prefers-color-scheme: light) {
    :root:not([data-theme]) {
      ${clientLayers.map((l) => `--layer-color-${l.id}: ${l.colorLight ?? l.color};`).join('\n      ')}
    }
  }
  :root[data-theme='light'] {
    ${clientLayers.map((l) => `--layer-color-${l.id}: ${l.colorLight ?? l.color};`).join('\n    ')}
  }
`} />

<div class="relative flex h-full min-h-0 flex-col lg:flex-row">
  {/* ---------------------------- Controls ---------------------------- */}
  <aside
    id="controls"
    aria-label={t('layers')}
    class="scroll-slim z-20 flex max-h-[45dvh] shrink-0 flex-col overflow-y-auto border-b border-ink-800 bg-ink-900 lg:max-h-none lg:w-84 lg:border-r lg:border-b-0"
  >
    <div class="border-b border-ink-800 p-3">
      <label for="map-search" class="sr-only">{t('searchLabel')}</label>
      <input
        id="map-search"
        type="search"
        autocomplete="off"
        placeholder={t('searchPlaceholder')}
        class="w-full rounded-md border border-ink-700 bg-ink-850 px-3 py-2 text-sm text-ink-100 placeholder:text-ink-400 focus:border-accent focus:outline-none"
      />
      <ul
        id="search-results"
        class="mt-1.5 hidden max-h-56 overflow-y-auto rounded-md border border-ink-700 bg-ink-850 text-sm"
        role="listbox"
      >
      </ul>
    </div>

    <div class="p-3">
      <div class="mb-2 flex items-baseline justify-between">
        <h2 class="text-xs font-semibold tracking-wider text-ink-400 uppercase">{t('layers')}</h2>
        <button
          id="clear-filters"
          type="button"
          class="text-xs text-ink-400 underline underline-offset-2 hover:text-ink-100"
        >
          {t('clearFilters')}
        </button>
      </div>

      {/*
        Every section ships closed, so the panel opens as a short list of
        subjects rather than a wall of seven cards nobody scrolls to the end
        of. A closed section still has to report itself: the coloured dots are
        the layers it holds, lit when that layer is drawn, and the count beside
        them says how many. Otherwise the map opens with cameras on the screen
        and no visible control claiming responsibility for them.

        `<details>` rather than a scripted accordion. A closed section is
        genuinely closed — its checkboxes leave the tab order, keyboard and
        screen-reader behaviour is the platform's, and the sections still open
        if the script never arrives.
      */}
      <ul class="space-y-1.5">
        {
          layerGroups.map((group) => (
            <li>
              <details
                class="layer-group rounded-lg border border-ink-800 bg-ink-900"
                data-layer-group={group.id}
              >
                <summary class="flex cursor-pointer items-center gap-2 rounded-lg px-2.5 py-2 hover:bg-ink-850">
                  <svg
                    class="layer-group-chevron h-3 w-3 shrink-0 text-ink-400"
                    viewBox="0 0 24 24"
                    fill="none"
                    aria-hidden="true"
                  >
                    <path
                      d="m6 9 6 6 6-6"
                      stroke="currentColor"
                      stroke-width="2.5"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    />
                  </svg>
                  <span class="min-w-0 text-[11px] font-semibold tracking-wider text-ink-200 uppercase">
                    {group.label}
                  </span>
                  <span class="ml-auto flex shrink-0 items-center gap-2">
                    <span class="flex items-center gap-1" aria-hidden="true">
                      {group.layers.map((layer) => (
                        <span
                          data-group-dot={layer.id}
                          class="h-2 w-2 rounded-full opacity-25 transition-opacity"
                          style={`background:var(--layer-color-${layer.id})`}
                        />
                      ))}
                    </span>
                    <span class="font-mono text-[10px] text-ink-400">
                      <span data-group-on={group.id}>0</span>/<span>{group.layers.length}</span>
                      <span class="sr-only"> {t('layersOn')}</span>
                    </span>
                  </span>
                </summary>

                <div class="border-t border-ink-800 p-2.5">
                  <p class="mb-2 text-[11px] leading-snug text-ink-400">{group.summary}</p>
                  <ul class="space-y-2">
                    {group.layers.map((layer) => (
                        <li class="rounded-lg border border-ink-800 bg-ink-850">
                          <div class="flex items-start gap-2.5 p-2.5">
                            <input
                              type="checkbox"
                              id={`layer-${layer.id}`}
                              data-layer-toggle={layer.id}
                              checked={layer.category === 'surveillance'}
                              class="mt-0.5 h-4 w-4 shrink-0 accent-current"
                              style={`color:var(--layer-color-${layer.id})`}
                            />
                            <div class="min-w-0 flex-1">
                              <label
                                for={`layer-${layer.id}`}
                                class="flex cursor-pointer items-center gap-2 text-sm font-medium text-ink-100"
                              >
                                <span
                                  class="h-2.5 w-2.5 shrink-0 rounded-full"
                                  style={`background:var(--layer-color-${layer.id})`}
                                  aria-hidden="true"
                                />
                                <span class="min-w-0">{layer.label}</span>
                              </label>
                              <p class="mt-1 text-xs leading-snug text-ink-400">{layer.summary}</p>
                              <p class="mt-1 font-mono text-[11px] text-ink-400">
                                <span data-count={layer.id}>0</span>
                                <span> {strings.ofTotal} </span>
                                <span>{layer.featureCount}</span>
                              </p>
                            </div>
                          </div>

                          {layer.filters.length > 0 && (
                            <details class="border-t border-ink-800">
                              <summary class="cursor-pointer px-2.5 py-1.5 text-xs text-ink-400 hover:text-ink-100">
                                {t('filters')}
                              </summary>
                              <div class="space-y-2.5 px-2.5 pb-2.5">
                                {layer.filters.map((filter) => (
                                  <fieldset>
                                    <legend class="mb-1 text-[11px] font-semibold tracking-wide text-ink-400 uppercase">
                                      {filter.label}
                                    </legend>
                                    <div class="space-y-1">
                                      {filter.values.map((value) => (
                                        <label class="flex cursor-pointer items-start gap-2 text-xs text-ink-200">
                                          <input
                                            type="checkbox"
                                            data-filter-layer={layer.id}
                                            data-filter-key={filter.key}
                                            value={value}
                                            checked={!filter.defaultExcluded!.includes(value)}
                                            class="mt-0.5 h-3.5 w-3.5 shrink-0"
                                          />
                                          {/*
                                            Where this filter is the same attribute the map colours
                                            by, each value carries its ground colour, so the toggle
                                            and the fill read as one system.
                                          */}
                                          {layer.categoryColors?.key === filter.key && (
                                            <span
                                              class="mt-1 h-2 w-2 shrink-0 rounded-sm"
                                              style={`background:${
                                                layer.categoryColors.colors.find((c) => c.value === value)
                                                  ?.color ?? layer.categoryColors.fallback
                                              }`}
                                              aria-hidden="true"
                                            />
                                          )}
                                          <span class="min-w-0">
                                            {value}
                                            {filter.valueDescriptions?.[value] && (
                                              <span class="block text-[10px] leading-snug text-ink-400">
                                                {filter.valueDescriptions[value]}
                                              </span>
                                            )}
                                          </span>
                                        </label>
                                      ))}
                                    </div>
                                  </fieldset>
                                ))}
                              </div>
                            </details>
                          )}
                        </li>
                    ))}
                  </ul>
                </div>
              </details>
            </li>
          ))
        }
      </ul>
    </div>
  </aside>

  {/* ------------------------------ Map ------------------------------ */}
  <div class="relative min-h-0 flex-1">
    <div id="map" class="absolute inset-0" role="application" aria-label={t('mapLabel')}></div>

    <div
      id="map-status"
      role="status"
      aria-live="polite"
      class="pointer-events-none absolute top-2 left-1/2 -translate-x-1/2 rounded-full bg-ink-900/90 px-3 py-1 text-xs text-ink-200 opacity-0 transition-opacity"
    >
    </div>

    <button
      id="reset-view"
      type="button"
      class="absolute right-2 bottom-8 rounded-md border border-ink-700 bg-ink-900/90 px-2.5 py-1.5 text-xs text-ink-200 hover:text-ink-100"
    >
      {t('resetView')}
    </button>

    {/*
      On-map keys for colour-coded layers, one bar per visible layer that
      declares categoryColors. Rebuilt from the layer toggles on every change, so a key can never
      outlive the layer it explains. aria-hidden because the same table
      already exists accessibly in the layer panel beside the map — this is
      the glanceable duplicate, not the record.
    */}
    <div
      id="map-keys"
      class="pointer-events-none absolute bottom-8 left-2 z-10 flex w-56 max-w-[70vw] flex-col gap-1.5"
      aria-hidden="true"
    >
    </div>
  </div>

  {/* --------------------------- Detail panel --------------------------- */}
  <aside
    id="detail-panel"
    aria-label={t('whatThisMeans')}
    hidden
    class="scroll-slim z-20 max-h-[55dvh] shrink-0 overflow-y-auto border-t border-ink-800 bg-ink-900 lg:max-h-none lg:w-[24rem] lg:border-t-0 lg:border-l"
  >
  </aside>
</div>

<script is:inline type="application/json" id="layer-config" set:html={JSON.stringify(clientLayers)} />
<script is:inline type="application/json" id="ui-strings" set:html={JSON.stringify(strings)} />
<script is:inline type="application/json" id="act-path" set:html={JSON.stringify(localePath(locale, '/act'))} />

<script>
  import { MapController, type ClientLayer, type LoadedFeature } from '~/lib/mapController';
  import { compassLabel } from '~/lib/geo.mjs';
  import { displayName } from '~/lib/authority.mjs';
  import { createElement, Route, Fingerprint, Speech, Landmark, type IconNode } from 'lucide';

  /**
   * Every icon an `impactSpheres` entry can name, by the string the registry
   * writes. Never emoji — see the type's own comment in layers/types.ts.
   */
  const IMPACT_SPHERE_ICONS: Record<string, IconNode> = { Route, Fingerprint, Speech, Landmark };

  type Jurisdiction = {
    geoid: string;
    name: string;
    kind: 'city' | 'township' | 'unorganized';
    governed: boolean;
    county: string;
    countyFips: string;
    lat: number;
    lng: number;
  };

  const layers = JSON.parse(document.getElementById('layer-config')!.textContent!) as (ClientLayer & {
    featureCount: number;
  })[];
  const S = JSON.parse(document.getElementById('ui-strings')!.textContent!) as Record<string, string>;
  const ACT_PATH = JSON.parse(document.getElementById('act-path')!.textContent!) as string;

  const mapEl = document.getElementById('map')!;
  const detailEl = document.getElementById('detail-panel')!;
  const statusEl = document.getElementById('map-status')!;

  // Keyed by plain string: lookups come from DOM datasets and event payloads,
  // which are untyped by definition.
  const layerById = new Map<string, (typeof layers)[number]>(layers.map((l) => [l.id, l]));

  function status(message: string, holdMs = 1800) {
    statusEl.textContent = message;
    statusEl.style.opacity = '1';
    if (holdMs) window.setTimeout(() => (statusEl.style.opacity = '0'), holdMs);
  }

  const controller = new MapController(mapEl, layers, {
    onSelect: (feature, layer) => renderDetail(feature, layer),
    onCounts: (counts) => {
      for (const [id, { shown }] of Object.entries(counts)) {
        const el = document.querySelector(`[data-count="${id}"]`);
        if (el) el.textContent = String(shown);
      }
    },
    onLayerReady: (id) => status(`${layerById.get(id)?.label ?? id} ✓`),
    onError: (id, message) =>
      status(`${layerById.get(id)?.label ?? id}: ${message}`, 6000),
  });

  /* ----------------------------- Detail panel ---------------------------- */

  const CONFIDENCE_TEXT: Record<string, string> = {
    confirmed: S.confidenceConfirmed,
    reported: S.confidenceReported,
    probabilistic: S.confidenceProbabilistic,
  };

  function el(tag: string, className?: string, text?: string) {
    const node = document.createElement(tag);
    if (className) node.className = className;
    if (text != null) node.textContent = text;
    return node;
  }

  const isExternalUrl = (url: string) => /^https?:\/\//.test(url);

  function citationLink(text: string, url: string) {
    const a = el('a', 'text-accent underline underline-offset-2', text);
    a.setAttribute('href', url);
    if (isExternalUrl(url)) {
      a.setAttribute('target', '_blank');
      a.setAttribute('rel', 'noopener noreferrer');
    }
    return a;
  }

  /**
   * Concrete, cited stakes for one layer — Carpenter v. United States for
   * movement, a documented ICE-lookup audit for immigration status, and so
   * on. Anchored to a case, a study or an audit rather than asserted, which
   * is the whole reason each card carries a linked source rather than a bare
   * claim. Stands in for the plain-language paragraph on a layer that has
   * one of these, rather than sitting under it, so there is no divider
   * expecting something above it.
   */
  function impactSpheresBlock(spheres: NonNullable<ClientLayer['impactSpheres']>) {
    const wrap = el('div', 'space-y-3');
    for (const sphere of spheres) {
      const card = el('div', 'border-l-2 pl-2.5');
      card.style.borderLeftColor = sphere.color;

      const heading = el('div', 'flex items-center gap-1.5');
      const iconNode = IMPACT_SPHERE_ICONS[sphere.icon];
      if (iconNode) {
        const icon = createElement(iconNode) as unknown as SVGElement;
        icon.setAttribute('aria-hidden', 'true');
        icon.setAttribute('width', '14');
        icon.setAttribute('height', '14');
        (icon as unknown as HTMLElement).style.color = sphere.color;
        (icon as unknown as HTMLElement).style.flexShrink = '0';
        heading.append(icon);
      }
      const title = el('span', 'text-xs font-semibold', sphere.title);
      title.style.color = sphere.color;
      heading.append(title);

      const bodyP = el('p', 'mt-1 text-xs leading-relaxed text-ink-300', sphere.body);

      const cite = el('p', 'mt-1 text-[11px] text-ink-400');
      cite.append(document.createTextNode(`${S.source}: `), citationLink(sphere.citation, sphere.citationUrl));
      if (sphere.citation2 && sphere.citation2Url) {
        cite.append(' · ', citationLink(sphere.citation2, sphere.citation2Url));
      }

      card.append(heading, bodyP, cite);
      wrap.append(card);
    }
    return wrap;
  }

  function formatValue(value: unknown, format?: string): string | null {
    if (value === null || value === undefined || value === '') return null;
    if (format === 'date') {
      const d = new Date(String(value));
      return Number.isNaN(d.getTime())
        ? String(value)
        : d.toLocaleDateString(document.documentElement.lang, {
            year: 'numeric',
            month: 'long',
            day: 'numeric',
          });
    }
    if (format === 'degrees') {
      const compass = compassLabel(value);
      return compass ? `${value}° (${compass})` : `${value}°`;
    }
    return String(value);
  }

  /** Substitute {placeholders} in a dictionary string. */
  const fill = (template: string, values: Record<string, string | number>) =>
    template.replace(/\{(\w+)\}/g, (_, key) => String(values[key] ?? ''));

  function renderDetail(feature: LoadedFeature | null, layer?: ClientLayer) {
    detailEl.textContent = '';
    if (!feature || !layer) {
      detailEl.hidden = true;
      return;
    }
    const p = feature.properties;
    const attrs = p.attributes as Record<string, unknown>;

    const header = el('div', 'flex items-start justify-between gap-2 border-b border-ink-800 p-3');
    const titleWrap = el('div', 'min-w-0');
    const badge = el('div', 'mb-1 flex items-center gap-1.5');
    const dot = el('span', 'h-2 w-2 rounded-full shrink-0');
    dot.setAttribute('style', `background:var(--layer-color-${layer.id})`);
    badge.append(dot, el('span', 'text-[11px] uppercase tracking-wider text-ink-400', layer.label));
    titleWrap.append(badge, el('h2', 'text-base font-semibold leading-snug text-ink-100', p.name));
    if (p.county) {
      titleWrap.append(el('p', 'mt-0.5 text-xs text-ink-400', `${p.county}, ${p.state}`));
    }
    // The position itself, for a record that has one exactly. Six decimals is
    // about 11 cm — far finer than a crowd-sourced pin deserves, but it is what
    // the source holds, and rounding it here would quietly disagree with the
    // OpenStreetMap record linked below.
    if (feature.geometry.type === 'Point') {
      const [lng, lat] = feature.geometry.coordinates as [number, number];
      titleWrap.append(
        el(
          'p',
          'mt-0.5 font-mono text-[11px] text-ink-400',
          `${lat.toFixed(6)}, ${lng.toFixed(6)}`,
        ),
      );
    }

    const close = el('button', 'shrink-0 rounded p-1 text-ink-400 hover:text-ink-100', '✕');
    close.setAttribute('type', 'button');
    close.setAttribute('aria-label', S.closePanel);
    close.addEventListener('click', () => {
      detailEl.hidden = true;
      (document.getElementById('map-search') as HTMLElement)?.focus();
    });
    header.append(titleWrap, close);

    const body = el('div', 'space-y-4 p-3');

    /*
      Meaning before data.

      A reader who just clicked a dot doesn't yet know what a "cord" or a
      "reader location" is — the raw fields and the action button are both
      unreadable without this first. It used to sit below both, which meant
      scrolling past a button and a table of jargon to find out what any of
      it meant.
    */
    const means = el('div', 'rounded-md border border-ink-800 bg-ink-850 p-2.5');
    means.append(el('h3', 'mb-1 text-[11px] uppercase tracking-wider text-ink-400', S.whatThisMeans));
    // A layer with cited cards lets them carry the explanation outright —
    // the prose paragraph would only restate what the cards already show,
    // and the whole point of shortening this section was less to read, not
    // the same reading twice in two forms. Every other layer still gets the
    // plain paragraph; whatThisMeans itself is untouched for the Sources
    // page, which documents every layer the same way regardless.
    if (layer.impactSpheres?.length) {
      means.append(impactSpheresBlock(layer.impactSpheres));
    } else {
      means.append(el('p', 'text-xs leading-relaxed text-ink-200', layer.whatThisMeans));
    }
    body.append(means);

    /*
      The way out of the panel.

      Sits above the raw fields rather than under the provenance at the
      bottom, because a reader who has decided to act has already decided —
      making them scroll past the licence to find the button is how a dead
      end gets rebuilt. The panel is narrow and scrolls; anything below the
      fold on a phone may as well not exist.

      What it carries is the whole point: the request template for this kind of
      record, the body to address, and where the record is, so the Take Action
      page can name the offices for that exact ground instead of starting the
      reader at a blank form.
    */
    if (layer.action) {
      const named =
        layer.action.bodyKey != null ? String(attrs[layer.action.bodyKey] ?? '').trim() : '';
      let addressee = named;
      if (!addressee) {
        if (layer.action.fallbackBody === 'name') addressee = p.name;
        else if (layer.action.fallbackBody === 'county' && p.county) addressee = p.county;
        else if (layer.action.fallbackBody === 'countySheriff' && p.county) {
          addressee = `${p.county} Sheriff's Office`;
        }
      }

      const params = new URLSearchParams({ type: layer.action.requestType });
      if (addressee) params.set('body', addressee);
      if (feature.geometry.type === 'Point') {
        const [lng, lat] = feature.geometry.coordinates as [number, number];
        params.set('at', `${lng.toFixed(5)},${lat.toFixed(5)}`);
      }

      const cta = el(
        'a',
        'block rounded-md bg-accent px-3 py-2 text-center text-sm font-medium text-on-accent hover:brightness-110',
        layer.action.label,
      );
      cta.setAttribute('href', `${ACT_PATH}?${params}`);
      body.append(cta);

      // Say who the letter will be addressed to before the reader commits to
      // a page change — and, where the operator is blank, say that instead of
      // quietly substituting the sheriff and letting them think we knew.
      body.append(
        el(
          'p',
          '-mt-2 text-[11px] leading-relaxed text-ink-400',
          named
            ? fill(S.actionAddressed, { body: addressee })
            : addressee
              ? fill(S.actionUnknownOperator, { body: addressee })
              : S.actionPickBody,
        ),
      );
    }

    // Layer-specific fields.
    const rows = layer.detailFields
      .map((f) => ({ label: f.label, value: formatValue(attrs[f.key], f.format), format: f.format }))
      .filter((r) => r.value !== null);

    if (rows.length) {
      const dl = el('dl', 'space-y-2');
      for (const row of rows) {
        const wrap = el('div');
        wrap.append(el('dt', 'text-[11px] uppercase tracking-wider text-ink-400', row.label));
        if (row.format === 'link') {
          const dd = el('dd', 'text-sm');
          const a = el('a', 'text-accent underline underline-offset-2 break-words', S.viewRecord);
          a.setAttribute('href', row.value!);
          a.setAttribute('target', '_blank');
          a.setAttribute('rel', 'noopener noreferrer');
          dd.append(a);
          wrap.append(dd);
        } else {
          wrap.append(el('dd', 'text-sm text-ink-100 break-words', row.value!));
        }
        dl.append(wrap);
      }
      body.append(dl);
    }

    // Confidence and limitations (spec F8).
    const conf = el('div');
    conf.append(
      el('h3', 'mb-1 text-[11px] uppercase tracking-wider text-ink-400', S.confidence),
      el('p', 'text-xs leading-relaxed text-warn', CONFIDENCE_TEXT[p.confidence] ?? p.confidence),
    );
    body.append(conf);

    if (layer.limitations.length) {
      const lim = el('div');
      lim.append(el('h3', 'mb-1 text-[11px] uppercase tracking-wider text-ink-400', S.limitations));
      const ul = el('ul', 'list-disc space-y-1 pl-4 text-xs leading-relaxed text-ink-300');
      for (const item of layer.limitations) ul.append(el('li', undefined, item));
      lim.append(ul);
      body.append(lim);
    }

    // Provenance travels with every record (spec F5, F7).
    const prov = el('div', 'border-t border-ink-800 pt-3 text-xs text-ink-400');
    const srcLine = el('p', 'break-words');
    srcLine.append(document.createTextNode(`${S.source}: `));
    const srcLink = el('a', 'text-ink-200 underline underline-offset-2', layer.source);
    srcLink.setAttribute('href', layer.sourceUrl);
    srcLink.setAttribute('target', '_blank');
    srcLink.setAttribute('rel', 'noopener noreferrer');
    srcLine.append(srcLink);
    prov.append(srcLine, el('p', 'mt-1', `${S.license}: ${layer.license}`));
    if (p.sourceDate) prov.append(el('p', 'mt-1', `${S.source}: ${p.sourceDate}`));
    body.append(prov);

    detailEl.append(header, body);
    detailEl.hidden = false;
    detailEl.scrollTop = 0;
  }

  /* ------------------------------ Controls ------------------------------ */

  /**
   * What a closed section says about itself.
   *
   * Read out of the checkboxes rather than tracked separately, so the summary
   * line cannot claim a layer is on after something else has switched it off —
   * clearing the filters empties every toggle, and this is what makes the
   * headings agree with the map afterwards.
   */
  const groupEls = document.querySelectorAll<HTMLDetailsElement>('[data-layer-group]');

  /**
   * The on-map keys, rebuilt from the toggles' current state.
   *
   * Generated from the same categoryColors table as the paint expression and
   * the panel swatches, so the three cannot disagree. Every value is labelled
   * beneath its own segment when the values are short enough to fit; a longer
   * scale labels its two ends, which for an ordered ramp (decades, bands) is
   * the reading that matters.
   */
  const mapKeysEl = document.getElementById('map-keys');
  function refreshMapKeys() {
    if (!mapKeysEl) return;
    mapKeysEl.replaceChildren();
    for (const layer of layers) {
      const cc = layer.categoryColors;
      if (!cc) continue;
      const input = document.querySelector<HTMLInputElement>(`[data-layer-toggle="${layer.id}"]`);
      if (!input?.checked) continue;

      const card = document.createElement('div');
      card.className = 'rounded-md border border-ink-800 bg-ink-900/85 px-2 py-1.5 backdrop-blur-sm';

      const title = document.createElement('p');
      title.className = 'mb-1 truncate text-[10px] leading-tight text-ink-300';
      title.textContent = cc.label;
      card.appendChild(title);

      const bar = document.createElement('div');
      bar.className = 'flex h-1.5 w-full overflow-hidden rounded-full border border-ink-800';
      for (const c of cc.colors) {
        const seg = document.createElement('span');
        seg.className = 'h-full flex-1';
        seg.style.background = c.color;
        bar.appendChild(seg);
      }
      card.appendChild(bar);

      const labelEach = cc.colors.every((c) => c.value.length <= 3);
      const row = document.createElement('p');
      row.className = 'mt-0.5 flex justify-between gap-1 text-[10px] leading-tight text-ink-400';
      const values = labelEach
        ? cc.colors.map((c) => c.value)
        : [cc.colors[0]?.value ?? '', cc.colors[cc.colors.length - 1]?.value ?? ''];
      for (const [i, value] of values.entries()) {
        const span = document.createElement('span');
        if (labelEach) span.className = 'flex-1 text-center';
        else span.className = i === 0 ? '' : 'text-right';
        span.textContent = value;
        row.appendChild(span);
      }
      card.appendChild(row);

      mapKeysEl.appendChild(card);
    }
  }

  function refreshGroups() {
    groupEls.forEach((group) => {
      const toggles = [...group.querySelectorAll<HTMLInputElement>('[data-layer-toggle]')];
      const on = group.querySelector('[data-group-on]');
      if (on) on.textContent = String(toggles.filter((t) => t.checked).length);
      for (const toggle of toggles) {
        const dot = group.querySelector(`[data-group-dot="${toggle.dataset.layerToggle}"]`);
        dot?.classList.toggle('opacity-25', !toggle.checked);
      }
    });
    refreshMapKeys();
  }

  document.querySelectorAll<HTMLInputElement>('[data-layer-toggle]').forEach((input) => {
    input.addEventListener('change', () => {
      const layer = layerById.get(input.dataset.layerToggle!);
      if (layer) controller.setLayerVisible(layer, input.checked);
      refreshGroups();
    });
  });

  // Surveillance apparatus ships pre-checked in the markup, unlike every
  // other registry layer's group — but a `change` event only fires on user
  // interaction, never for a checkbox's initial `checked` attribute, so
  // whatever starts checked has to be turned on here explicitly.
  document.querySelectorAll<HTMLInputElement>('[data-layer-toggle]').forEach((input) => {
    if (!input.checked) return;
    const layer = layerById.get(input.dataset.layerToggle!);
    if (layer) controller.setLayerVisible(layer, true);
  });
  refreshGroups();

  document.querySelectorAll<HTMLInputElement>('[data-filter-key]').forEach((input) => {
    input.addEventListener('change', () => {
      const layerId = input.dataset.filterLayer!;
      const key = input.dataset.filterKey!;
      const boxes = document.querySelectorAll<HTMLInputElement>(
        `[data-filter-layer="${layerId}"][data-filter-key="${key}"]`,
      );
      const checked = [...boxes].filter((c) => c.checked);
      // Every box ticked is the default, not a filter: pass the empty set so
      // the controller drops the key. Storing the full list instead would
      // read as an active narrowing — and would quietly exclude records whose
      // attribute is null, which no ticked box can name.
      controller.setFilter(
        layerId,
        key,
        new Set(checked.length === boxes.length ? [] : checked.map((c) => c.value)),
      );
    });
  });

  /**
   * Everything the reader has narrowed the map by, put back to how it opened.
   *
   * "Filters" is whatever is currently hiding records, not just the value
   * checkboxes: a half-typed search still cuts the map down, so a clear that
   * ignores it leaves the reader looking at a subset while every control
   * claims otherwise. The layer
   * toggles go too: a control panel where every box is empty and the map is
   * still drawing something is a panel that is lying about its own state, so
   * clearing empties the map back to the basemap and leaves the reader to
   * switch on what they came for.
   */
  document.getElementById('clear-filters')?.addEventListener('click', () => {
    document
      .querySelectorAll<HTMLInputElement>('[data-filter-key]')
      .forEach((c) => (c.checked = false));
    controller.clearFilters();

    document.querySelectorAll<HTMLInputElement>('[data-layer-toggle]').forEach((input) => {
      input.checked = false;
      const layer = layerById.get(input.dataset.layerToggle!);
      if (layer) controller.setLayerVisible(layer, false);
    });

    // Emptying the box is not enough on its own — the results list stays open
    // over the map until something re-runs the search. Re-running it on an
    // empty query is what closes it, and it is already the one piece of code
    // that knows how. The boundary outline goes with it: it is on the map
    // because of a search that is no longer there, and leaving a township
    // ringed after clearing the thing that ringed it reads as a filter still
    // running. Where the reader is looking is not ours to change — that is
    // what "reset view" is for, next to this.
    searchInput.value = '';
    runSearch('');
    controller.clearJurisdiction();
    refreshGroups();

    status(S.filtersCleared);
  });

  document.getElementById('reset-view')?.addEventListener('click', () => controller.resetView());

  /* ------------------------------- Search ------------------------------- */

  const searchInput = document.getElementById('map-search') as HTMLInputElement;
  const searchResults = document.getElementById('search-results')!;

  /*
    Places, above records.

    The box has always said "Search a city, county, or agency" and has only
    ever searched records — so typing the name of the township you live in
    returned "no records match", which reads as "there is nothing here" rather
    than "this box does not do that". Now the governments come first, because
    somebody typing a place name is trying to get to a place, and a camera that
    merely happens to be tagged with that county is not what they meant.
  */
  let jurisdictionIndex: Jurisdiction[] = [];
  fetch('/data/reference/mn-jurisdictions.json')
    .then((r) => r.json())
    .then((doc) => {
      jurisdictionIndex = doc.jurisdictions ?? [];
    })
    .catch(() => {
      // Search still works over records; it just cannot find a township.
      jurisdictionIndex = [];
    });

  /**
   * Boundaries, fetched the first time somebody picks a place and not before.
   * 1.6 MB is a lot to spend on a map that may only ever be panned.
   */
  let shapes: Promise<{ features: any[] }> | null = null;
  function loadShapes() {
    shapes ??= fetch('/data/reference/mn-jurisdictions.geojson')
      .then((r) => (r.ok ? r.json() : { features: [] }))
      .catch(() => ({ features: [] }));
    return shapes;
  }

  async function focusJurisdiction(j: Jurisdiction) {
    // Move immediately on the index's interior point, then outline the
    // boundary when it arrives. Waiting for 1.6 MB before anything happens
    // makes a click feel broken on a slow connection.
    controller.flyTo([j.lng, j.lat], 11);
    const doc = await loadShapes();
    const match = doc.features.find((f: any) => f.properties?.geoid === j.geoid);
    if (match) controller.showJurisdiction(match);
  }

  function runSearch(query: string) {
    const q = query.trim().toLowerCase();
    searchResults.textContent = '';
    if (q.length < 2) {
      searchResults.classList.add('hidden');
      return;
    }

    const placeHits = jurisdictionIndex
      .filter((j) => j.name.toLowerCase().includes(q))
      .sort((a, b) => {
        const as = a.name.toLowerCase().startsWith(q) ? 0 : 1;
        const bs = b.name.toLowerCase().startsWith(q) ? 0 : 1;
        return as - bs || a.name.localeCompare(b.name);
      })
      .slice(0, 8);

    const hits: { layer: ClientLayer; feature: LoadedFeature }[] = [];
    for (const layer of layers) {
      for (const feature of controller.getFeatures(layer.id)) {
        const p = feature.properties;
        const haystack = `${p.name} ${p.county ?? ''} ${Object.values(p.attributes ?? {}).join(' ')}`;
        if (haystack.toLowerCase().includes(q)) hits.push({ layer, feature });
        if (hits.length >= 40) break;
      }
    }

    if (!placeHits.length && !hits.length) {
      searchResults.append(el('li', 'px-2.5 py-2 text-xs text-ink-400', S.noResults));
      searchResults.classList.remove('hidden');
      return;
    }

    for (const j of placeHits) {
      const li = el('li');
      li.setAttribute('role', 'option');
      const button = el(
        'button',
        'flex w-full items-start gap-2 px-2.5 py-1.5 text-left hover:bg-ink-800',
      );
      button.setAttribute('type', 'button');
      // An outline rather than a filled dot: a place is a frame, not a record.
      const ring = el('span', 'mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full border border-ink-300');
      const text = el('span', 'min-w-0');
      text.append(
        el('span', 'block truncate text-xs text-ink-100', displayName(j.name)),
        el('span', 'block truncate text-[11px] text-ink-400', j.county),
      );
      button.append(ring, text);
      button.addEventListener('click', () => {
        void focusJurisdiction(j);
        searchResults.classList.add('hidden');
      });
      li.append(button);
      searchResults.append(li);
    }

    for (const { layer, feature } of hits) {
      const li = el('li');
      li.setAttribute('role', 'option');
      const button = el(
        'button',
        'flex w-full items-start gap-2 px-2.5 py-1.5 text-left hover:bg-ink-800',
      );
      button.setAttribute('type', 'button');
      const dot = el('span', 'mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full');
      dot.setAttribute('style', `background:var(--layer-color-${layer.id})`);
      const text = el('span', 'min-w-0');
      text.append(
        el('span', 'block truncate text-xs text-ink-100', feature.properties.name),
        el('span', 'block truncate text-[11px] text-ink-400', feature.properties.county ?? layer.label),
      );
      button.append(dot, text);
      button.addEventListener('click', () => {
        controller.focusFeature(layer.id, feature.properties.id);
        searchResults.classList.add('hidden');
      });
      li.append(button);
      searchResults.append(li);
    }
    searchResults.classList.remove('hidden');
  }

  let searchTimer: number;
  searchInput.addEventListener('input', () => {
    window.clearTimeout(searchTimer);
    searchTimer = window.setTimeout(() => runSearch(searchInput.value), 140);
  });
  searchInput.addEventListener('blur', () => {
    // Delay so a click on a result still registers.
    window.setTimeout(() => searchResults.classList.add('hidden'), 180);
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && !detailEl.hidden) {
      detailEl.hidden = true;
    }
  });

  /* ------------------------------ Start-up ------------------------------ */

  // Nothing draws until the reader switches it on — the map opens on the
  // basemap alone, for now. (The cameras used to open pre-drawn; restore
  // them to this list to bring that back.)
  const DEFAULT_ON: string[] = [];

  // Some filters open already narrowed — a withdrawn data-center proposal is
  // worth finding but should not be drawn as though it were a building. The
  // checkboxes were rendered pre-ticked; tell the controller the same thing, or
  // the panel and the map would disagree until the reader touched a box.
  for (const layer of layers) {
    for (const filter of layer.filters) {
      if (!filter.defaultExcluded?.length) continue;
      const allowed = filter.values.filter((v) => !filter.defaultExcluded!.includes(v));
      controller.setFilter(layer.id, filter.key, new Set(allowed));
    }
  }

  status(S.loading, 0);
  controller.map.once('load', () => {
    for (const id of DEFAULT_ON) {
      const input = document.querySelector<HTMLInputElement>(`[data-layer-toggle="${id}"]`);
      const layer = layerById.get(id);
      if (input && layer) {
        input.checked = true;
        controller.setLayerVisible(layer, true);
      }
    }
    refreshGroups();
    status('', 400);
  });
</script>
