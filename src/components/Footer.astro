---
import type { Locale } from '~/layers/types';
import { useTranslations, localePath, pick } from '~/lib/i18n';
import { LAYERS } from '~/layers/registry';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useTranslations(locale);

const REPO = 'https://github.com/ngabantudev/flockoffmn';
---

<footer class="mt-16 border-t border-ink-800 bg-ink-900">
  <div class="mx-auto grid max-w-[1600px] gap-8 px-4 py-10 sm:grid-cols-2 lg:grid-cols-4">
    <div>
      <p class="text-sm font-semibold text-ink-100">{t('siteName')}</p>
      <p class="mt-2 text-sm leading-relaxed text-ink-400">{t('tagline')}</p>
      <p class="mt-3 text-xs text-ink-400">{t('noTrackers')}</p>
    </div>

    <div>
      <p class="text-sm font-semibold text-ink-100">{t('layers')}</p>
      <ul class="mt-2 space-y-1.5 text-sm">
        {
          LAYERS.map((layer) => (
            <li>
              <a
                href={`${localePath(locale, '/sources')}#${layer.slug}`}
                class="flex items-center gap-2 text-ink-400 transition-colors hover:text-ink-100"
              >
                <span
                  class="h-2 w-2 shrink-0 rounded-full"
                  style={`background:${layer.color}`}
                  aria-hidden="true"
                />
                {pick(layer.label, locale)}
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <div>
      <p class="text-sm font-semibold text-ink-100">{t('navData')}</p>
      <ul class="mt-2 space-y-1.5 text-sm text-ink-400">
        <li><a class="hover:text-ink-100" href={localePath(locale, '/data')}>{t('navData')}</a></li>
        <li><a class="hover:text-ink-100" href={localePath(locale, '/sources')}>{t('navSources')}</a></li>
        <li><a class="hover:text-ink-100" href={localePath(locale, '/contribute')}>{t('navContribute')}</a></li>
        <li><a class="hover:text-ink-100" href={localePath(locale, '/about')}>{t('navAbout')}</a></li>
      </ul>
    </div>

    <div>
      <p class="text-sm font-semibold text-ink-100">{t('attribution')}</p>
      <p class="mt-2 text-xs leading-relaxed text-ink-400">
        Camera data © OpenStreetMap contributors (ODbL). 287(g) and detention records: U.S.
        Immigration and Customs Enforcement (public domain). Redlining: Mapping Inequality,
        University of Richmond (CC BY-NC-SA 4.0). Data centers: FracTracker Alliance. County
        geography: U.S. Census Bureau.
      </p>
      <p class="mt-3 text-xs text-ink-400">
        <a class="underline underline-offset-2 hover:text-ink-100" href={REPO}>{t('openSource')}</a>
        <span aria-hidden="true"> · </span>
        <span>Code MIT · Compiled data CC BY 4.0</span>
      </p>
    </div>
  </div>
</footer>
