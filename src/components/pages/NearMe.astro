---
import type { Locale, LayerDefinition } from '~/layers/types';
import { LAYERS } from '~/layers/registry';
import { useTranslations, pick, localePath } from '~/lib/i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useTranslations(locale);

/**
 * A `nearMe` key in `detail` must also be a `detailFields` entry, so the label
 * is written once. Throwing here turns a registry typo into a build failure
 * rather than a card that silently renders "undefined: 3" to a reader.
 */
function labelFor(layer: LayerDefinition, key: string): string {
  const field = layer.detailFields.find((f) => f.key === key);
  if (!field) {
    throw new Error(
      `Layer "${layer.id}" names "${key}" in nearMe.detail but has no detailFields entry for it.`,
    );
  }
  return pick(field.label, locale);
}

/**
 * Only layers that declare a `nearMe` summary. This list drives both what the
 * page fetches and what it draws, so the two cannot disagree — previously the
 * page fetched every layer and drew five by name, which meant the covenants
 * layer was downloaded on every visit and never shown.
 */
const nearMeLayers = LAYERS.filter((l) => l.nearMe).map((l) => {
  const n = l.nearMe!;
  return {
    id: l.id,
    color: l.color,
    dataPath: l.dataPath,
    mode: n.mode,
    title: pick(n.title, locale),
    empty: pick(n.empty, locale),
    radii: n.radii ?? [],
    detail: (n.detail ?? []).map((key) => ({ key, label: labelFor(l, key) })),
    linkKey: n.linkKey ?? null,
    linkLabel: n.linkKey ? labelFor(l, n.linkKey) : null,
    caveat: n.caveat ? pick(n.caveat, locale) : null,
    wide: n.wide ?? false,
    list: n.list
      ? {
          entityKey: n.list.entityKey ?? null,
          detail: (n.list.detail ?? []).map((key) => ({ key, label: labelFor(l, key) })),
          initialCount: n.list.initialCount ?? 8,
          showOnMap: n.list.showOnMap ?? false,
        }
      : null,
  };
});

const strings = {
  locating: t('locating'),
  locationDenied: t('locationDenied'),
  locationUnavailable: t('locationUnavailable'),
  noResults: t('noResults'),
  loading: t('loading'),
  aroundYourLocation: t('aroundYourLocation'),
  aroundPlace: t('aroundPlace'),
  stateName: t('stateName'),
  mappedWithin: t('mappedWithin'),
  alsoWithin: t('alsoWithin'),
  nearestIs: t('nearestIs'),
  distanceAway: t('distanceAway'),
  foundInCounty: t('foundInCounty'),
  entityUnattributed: t('entityUnattributed'),
  showOnMap: t('showOnMap'),
  showMore: t('showMore'),
  outsideMinnesotaTitle: t('outsideMinnesotaTitle'),
  outsideMinnesota: t('outsideMinnesota'),
  lowAccuracy: t('lowAccuracy'),

  whoAnswersTitle: t('whoAnswersTitle'),
  whoAnswersIntro: t('whoAnswersIntro'),
  whoAnswersEmpty: t('whoAnswersEmpty'),
  youAreIn: t('youAreIn'),
  inCounty: t('inCounty'),
  noLocalGovernment: t('noLocalGovernment'),
  operatorMismatch: t('operatorMismatch'),
  operatorUnattributed: t('operatorUnattributed'),
  writeToThisOffice: t('writeToThisOffice'),
  underStatute: t('underStatute'),
  jurisdictionCity: t('jurisdictionCity'),
  jurisdictionTownship: t('jurisdictionTownship'),
  jurisdictionUnorganized: t('jurisdictionUnorganized'),
  jurisdictionCounty: t('jurisdictionCounty'),
  officeTownClerk: t('officeTownClerk'),
  officeTownClerkRole: t('officeTownClerkRole'),
  officeCityClerk: t('officeCityClerk'),
  officeCityClerkRole: t('officeCityClerkRole'),
  officeCountyAdministrator: t('officeCountyAdministrator'),
  officeCountyAdministratorRole: t('officeCountyAdministratorRole'),
  officeLawEnforcement: t('officeLawEnforcement'),
  officeLawEnforcementRole: t('officeLawEnforcementRole'),
  officeCommissioner: t('officeCommissioner'),
  officeCommissionerRole: t('officeCommissionerRole'),
};

const actPath = localePath(locale, '/act');
const homePath = localePath(locale, '/');
---

<div class="mx-auto max-w-4xl px-4 py-10">
  <h1 class="text-2xl font-semibold tracking-tight text-ink-100 sm:text-3xl">{t('nearMeTitle')}</h1>
  <p class="mt-2 max-w-2xl text-sm leading-relaxed text-ink-300">{t('nearMeIntro')}</p>

  <!--
    Privacy note is not fine print: it is the reason this page works the way it
    does. The place list is shipped with the site, so a lookup involves no
    request to any geocoder and nothing to log.
  -->
  <p class="mt-3 flex max-w-2xl items-start gap-2 rounded-md border border-ink-800 bg-ink-900 p-3 text-xs leading-relaxed text-ink-300">
    <svg viewBox="0 0 20 20" class="mt-0.5 h-4 w-4 shrink-0 text-accent" fill="currentColor" aria-hidden="true">
      <path
        fill-rule="evenodd"
        d="M10 1.5 3.5 4.2v5c0 4 2.8 7.7 6.5 9.3 3.7-1.6 6.5-5.3 6.5-9.3v-5L10 1.5Zm2.9 6.6-3.4 4.2a.8.8 0 0 1-1.2 0L6.6 10.4a.8.8 0 1 1 1.2-1l1.1 1.4 2.8-3.5a.8.8 0 1 1 1.2 1Z"
        clip-rule="evenodd"></path>
    </svg>
    <span>{t('nearMePrivacy')}</span>
  </p>

  <div class="mt-6 grid gap-3 sm:grid-cols-[1fr_auto]">
    <div>
      <label for="place-search" class="mb-1.5 block text-sm font-medium text-ink-200">
        {t('chooseAPlace')}
      </label>
      <div class="relative">
        <input
          id="place-search"
          type="search"
          autocomplete="off"
          role="combobox"
          aria-expanded="false"
          aria-controls="place-results"
          placeholder={t('searchPlaceholder')}
          class="w-full rounded-md border border-ink-700 bg-ink-850 px-3 py-2.5 text-sm text-ink-100 placeholder:text-ink-400 focus:border-accent focus:outline-none"
        />
        <ul
          id="place-results"
          role="listbox"
          class="absolute z-20 mt-1 hidden max-h-64 w-full overflow-y-auto rounded-md border border-ink-700 bg-ink-850 shadow-xl"
        >
        </ul>
      </div>
    </div>

    <div class="flex items-end">
      <button
        id="use-location"
        type="button"
        class="w-full rounded-md border border-ink-700 bg-ink-850 px-4 py-2.5 text-sm font-medium text-ink-100 hover:border-accent hover:text-accent sm:w-auto"
      >
        {t('useMyLocation')}
      </button>
    </div>
  </div>

  <p id="near-status" role="status" aria-live="polite" class="mt-3 text-sm text-warn"></p>

  <section id="near-results" hidden class="mt-8">
    <h2 id="near-heading" class="text-lg font-semibold text-ink-100"></h2>
    <p id="near-sub" class="mt-0.5 text-sm text-ink-400"></p>
    <p id="near-accuracy" hidden class="mt-2 text-xs leading-relaxed text-warn"></p>

    <!--
      Who answers here comes before the layer cards, deliberately. Everything
      below it is a finding; this is the part a reader can act on, and it was
      the step the site used to leave them to work out for themselves.
    -->
    <div id="who-answers" class="mt-5"></div>

    <div id="near-cards" class="mt-5 grid gap-3 sm:grid-cols-2"></div>

    <div class="mt-6 rounded-lg border border-accent/30 bg-accent/5 p-4">
      <p class="text-sm leading-relaxed text-ink-200">{t('crossLayerNote')}</p>
      <a
        href={localePath(locale, '/explainer')}
        class="mt-2 inline-block text-sm font-medium text-accent underline underline-offset-2"
      >
        {t('readHowThisConnects')} →
      </a>
    </div>
  </section>
</div>

<script is:inline type="application/json" id="near-layers" set:html={JSON.stringify(nearMeLayers)} />
<script is:inline type="application/json" id="near-strings" set:html={JSON.stringify(strings)} />
<script is:inline type="application/json" id="near-act-path" set:html={JSON.stringify(actPath)} />
<script is:inline type="application/json" id="near-home-path" set:html={JSON.stringify(homePath)} />

<script>
  import {
    haversineMeters,
    metersToMiles,
    findContaining,
    distanceToGeometryMeters,
  } from '~/lib/geo.mjs';
  import { resolveAuthorities, operatorGap, displayName } from '~/lib/authority.mjs';
  import { MN_BOUNDS } from '~/lib/mapStyle';

  type NearMeLayer = {
    id: string;
    color: string;
    dataPath: string;
    mode: 'radius' | 'nearest' | 'contains' | 'countyMatch';
    title: string;
    empty: string;
    radii: number[];
    detail: { key: string; label: string }[];
    linkKey: string | null;
    linkLabel: string | null;
    caveat: string | null;
    wide: boolean;
    list: {
      entityKey: string | null;
      detail: { key: string; label: string }[];
      initialCount: number;
      showOnMap: boolean;
    } | null;
  };

  const layers = JSON.parse(
    document.getElementById('near-layers')!.textContent!,
  ) as NearMeLayer[];
  const S = JSON.parse(document.getElementById('near-strings')!.textContent!) as Record<string, string>;

  const searchInput = document.getElementById('place-search') as HTMLInputElement;
  const resultsList = document.getElementById('place-results')!;
  const statusEl = document.getElementById('near-status')!;
  const section = document.getElementById('near-results')!;
  const heading = document.getElementById('near-heading')!;
  const sub = document.getElementById('near-sub')!;
  const accuracyEl = document.getElementById('near-accuracy')!;
  const cards = document.getElementById('near-cards')!;
  const whoEl = document.getElementById('who-answers')!;

  const REDUCED_MOTION = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  /*
   * Minnesota's own bounding box, already padded a few tenths of a degree
   * (see MN_BOUNDS's own comment in mapStyle.ts) so a fix that lands just
   * past the state line doesn't misreport as "outside Minnesota" — the
   * jurisdiction/county lookups below are the precise answer; this box only
   * decides whether it's worth asking them at all. Reused from mapStyle.ts
   * rather than redeclared here, so the two never drift apart.
   */
  const inMinnesota = ([lng, lat]: [number, number]) =>
    lng >= MN_BOUNDS[0][0] && lng <= MN_BOUNDS[1][0] && lat >= MN_BOUNDS[0][1] && lat <= MN_BOUNDS[1][1];

  // Below this, a 5-mile radius stops being a meaningful promise — worth
  // saying so, not worth alarming a reader whose fix was merely ordinary.
  const LOW_ACCURACY_MILES = 2;

  type Jurisdiction = {
    geoid: string;
    name: string;
    kind: 'city' | 'township' | 'unorganized';
    governed: boolean;
    county: string;
    countyFips: string;
    lat: number;
    lng: number;
  };
  /** A search hit: either a Census place or a unit of government. */
  type Place = { name: string; lat: number; lng: number; jurisdiction?: Jurisdiction };
  type Feature = { geometry: GeoJSON.Geometry; properties: Record<string, any> };

  let places: Place[] = [];
  let counties: { features: any[] } | null = null;
  const layerData = new Map<string, Feature[]>();

  const ACT_PATH = JSON.parse(document.getElementById('near-act-path')!.textContent!) as string;
  const HOME_PATH = JSON.parse(document.getElementById('near-home-path')!.textContent!) as string;

  /** Everything the page needs, fetched once, in parallel. */
  async function loadAll() {
    const [placeDoc, jurisdictionDoc, countyDoc, ...layerDocs] = await Promise.all([
      fetch('/data/reference/mn-places.json').then((r) => r.json()),
      fetch('/data/reference/mn-jurisdictions.json').then((r) => r.json()),
      fetch('/data/reference/mn-counties.geojson').then((r) => r.json()),
      ...layers.map((l) =>
        fetch(l.dataPath)
          .then((r) => (r.ok ? r.json() : { features: [] }))
          .catch(() => ({ features: [] })),
      ),
    ]);
    counties = countyDoc;
    layers.forEach((l, i) => layerData.set(l.id, layerDocs[i].features ?? []));

    const jurisdictions: Jurisdiction[] = jurisdictionDoc.jurisdictions ?? [];

    /*
      The two indexes overlap and neither contains the other, so the search
      list is a merge rather than a replacement.

      `mn-places.json` is the Census incorporated-place gazetteer: 914 cities,
      plus the unincorporated communities that people actually use as
      addresses. `mn-jurisdictions.json` is every unit of government: all 900
      cities and, critically, all 1,798 townships, which had no entry here at
      all — a fifth of the state's population could not find where they live.

      Where both list the same city the jurisdiction record wins, because it
      knows its county and its class and the gazetteer entry does not. What
      survives from the gazetteer is the unincorporated communities, which are
      real places to search for and are governed by whichever township or city
      contains them.
    */
    const governmentNames = new Set(
      jurisdictions.map((j) => displayName(j.name).toLowerCase()),
    );
    const gazetteer: Place[] = (placeDoc.places ?? []).filter(
      (p: Place) =>
        !governmentNames.has(`${p.name.toLowerCase()} city`) &&
        !governmentNames.has(p.name.toLowerCase()),
    );

    places = [
      ...jurisdictions.map((j) => ({
        name: displayName(j.name),
        lat: j.lat,
        lng: j.lng,
        jurisdiction: j,
      })),
      ...gazetteer,
    ];
  }

  const ready = loadAll();

  /**
   * Jurisdiction boundaries, fetched only when they are actually needed.
   *
   * 1.6 MB of polygons answers exactly one question: which unit of government
   * contains a raw pair of coordinates. When a reader picks a township by name
   * we already know the answer and never touch this file — so the download
   * happens only for "use my location", and only once.
   */
  let jurisdictionShapes: Promise<{ features: Feature[] }> | null = null;
  function loadJurisdictionShapes() {
    jurisdictionShapes ??= fetch('/data/reference/mn-jurisdictions.geojson')
      .then((r) => (r.ok ? r.json() : { features: [] }))
      .catch(() => ({ features: [] }));
    return jurisdictionShapes;
  }

  function el(tag: string, cls?: string, text?: string) {
    const n = document.createElement(tag);
    if (cls) n.className = cls;
    if (text != null) n.textContent = text;
    return n;
  }

  /** Substitute {placeholders} in a dictionary string. */
  const fill = (template: string, values: Record<string, string | number>) =>
    template.replace(/\{(\w+)\}/g, (_, key) => String(values[key] ?? ''));

  const miles = (m: number) => metersToMiles(m);
  const fmtMiles = (m: number) => {
    const mi = miles(m);
    return mi < 0.1 ? '< 0.1' : mi.toFixed(mi < 10 ? 1 : 0);
  };

  /* --------------------------- Place search --------------------------- */

  function renderPlaceResults(query: string) {
    const q = query.trim().toLowerCase();
    resultsList.textContent = '';
    if (q.length < 2) {
      resultsList.classList.add('hidden');
      searchInput.setAttribute('aria-expanded', 'false');
      return;
    }
    const hits = places
      .filter((p) => p.name.toLowerCase().includes(q))
      // Prefer names that start with the query.
      .sort((a, b) => {
        const as = a.name.toLowerCase().startsWith(q) ? 0 : 1;
        const bs = b.name.toLowerCase().startsWith(q) ? 0 : 1;
        return as - bs || a.name.localeCompare(b.name);
      })
      .slice(0, 25);

    if (!hits.length) {
      resultsList.append(el('li', 'px-3 py-2 text-xs text-ink-400', S.noResults));
    } else {
      for (const place of hits) {
        const li = el('li');
        li.setAttribute('role', 'option');
        const button = el(
          'button',
          'flex w-full items-baseline justify-between gap-3 px-3 py-2 text-left text-sm text-ink-200 hover:bg-ink-800 hover:text-ink-100',
        );
        button.setAttribute('type', 'button');
        button.append(el('span', '', place.name));
        // Minnesota has a Waterford township and a Waterford, and plenty more
        // pairs like it. The county is what tells two hits apart in a list.
        if (place.jurisdiction) {
          button.append(
            el('span', 'shrink-0 text-xs text-ink-400', place.jurisdiction.county),
          );
        }
        button.addEventListener('click', () => {
          searchInput.value = place.name;
          resultsList.classList.add('hidden');
          void analyse([place.lng, place.lat], place.name, place.jurisdiction ?? null);
        });
        li.append(button);
        resultsList.append(li);
      }
    }
    resultsList.classList.remove('hidden');
    searchInput.setAttribute('aria-expanded', 'true');
  }

  let timer: number;
  searchInput.addEventListener('input', () => {
    window.clearTimeout(timer);
    timer = window.setTimeout(() => renderPlaceResults(searchInput.value), 120);
  });
  searchInput.addEventListener('blur', () =>
    window.setTimeout(() => resultsList.classList.add('hidden'), 180),
  );

  /* ---------------------------- Geolocation --------------------------- */

  document.getElementById('use-location')?.addEventListener('click', () => {
    if (!navigator.geolocation) {
      statusEl.textContent = S.locationUnavailable;
      return;
    }
    statusEl.textContent = S.locating;
    navigator.geolocation.getCurrentPosition(
      (pos) => {
        statusEl.textContent = '';
        // Coordinates are used in memory and never stored or transmitted.
        // `null` for the place name selects the "your location" heading.
        void analyse([pos.coords.longitude, pos.coords.latitude], null, null, pos.coords.accuracy);
      },
      (err) => {
        statusEl.textContent =
          err.code === err.PERMISSION_DENIED ? S.locationDenied : S.locationUnavailable;
      },
      { enableHighAccuracy: false, timeout: 10_000, maximumAge: 60_000 },
    );
  });

  /* ------------------------- Cross-layer summary ------------------------ */

  function card(title: string, color: string) {
    const wrap = el('div', 'rounded-lg border border-ink-800 bg-ink-900 p-4');
    const head = el('div', 'mb-2 flex items-center gap-2');
    const dot = el('span', 'h-2 w-2 shrink-0 rounded-full');
    dot.setAttribute('style', `background:${color}`);
    head.append(dot, el('h3', 'text-sm font-semibold text-ink-100', title));
    wrap.append(head);
    return wrap;
  }

  /**
   * The closest record, measured to the geometry rather than to a point
   * standing in for it.
   *
   * This used to measure to the centre of a record's bounding box, which is
   * exact for a point and badly wrong for anything with extent: someone
   * standing on a nine-mile stretch of road would be told it was four miles
   * away, because that is how far they were from its midpoint. The same rule
   * the ingest uses to route between cameras answers the question here.
   */
  function nearest(point: [number, number], features: Feature[]) {
    let best: { feature: Feature; distance: number } | null = null;
    for (const f of features) {
      const d = distanceToGeometryMeters(point, f.geometry);
      if (!best || d < best.distance) best = { feature: f, distance: d };
    }
    return best;
  }

  /** `label: value` lines for the attributes a layer asked to surface. */
  function detailLines(layer: NearMeLayer, feature: Feature, cls: string) {
    const out: HTMLElement[] = [];
    for (const d of layer.detail) {
      const value = feature.properties.attributes?.[d.key];
      // A null attribute is a real gap in the source, not a zero. Say nothing
      // rather than inventing a placeholder.
      if (value === null || value === undefined || value === '') continue;
      out.push(el('p', cls, `${d.label}: ${value}`));
    }
    return out;
  }

  /**
   * A single row: distance, entity label, detail lines, and an optional
   * "show on map" link that centres the homepage map on the record.
   */
  function listRow(layer: NearMeLayer, row: { feature: Feature; distance: number }) {
    const list = layer.list!;
    const li = el('li', 'border-l-2 pl-3');
    li.setAttribute('style', `border-color:${layer.color}`);

    const entityValue = list.entityKey ? row.feature.properties.attributes?.[list.entityKey] : null;
    const head = el('div', 'flex flex-wrap items-baseline justify-between gap-x-3 gap-y-0.5');
    head.append(
      el(
        'span',
        'text-sm text-ink-100',
        entityValue === null || entityValue === undefined || entityValue === ''
          ? S.entityUnattributed
          : String(entityValue),
      ),
      el('span', 'font-mono text-xs text-ink-400 shrink-0', `${fmtMiles(row.distance)} mi`),
    );
    li.append(head);

    for (const d of list.detail) {
      const value = row.feature.properties.attributes?.[d.key];
      if (value === null || value === undefined || value === '') continue;
      li.append(el('p', 'mt-0.5 text-xs text-ink-400', `${d.label}: ${value}`));
    }

    if (list.showOnMap && row.feature.geometry.type === 'Point') {
      const [lng, lat] = (row.feature.geometry as GeoJSON.Point).coordinates;
      const a = el('a', 'mt-1 inline-block text-xs text-accent underline underline-offset-2', `${S.showOnMap} →`);
      a.setAttribute('href', `${HOME_PATH}?lat=${lat}&lng=${lng}&zoom=17`);
      li.append(a);
    }
    return li;
  }

  /**
   * Every record within the headline radius, nearest first, capped with a
   * plain "show more" button rather than pagination — this keeps the DOM
   * list (and its screen-reader order) intact instead of swapping pages.
   */
  function recordList(layer: NearMeLayer, rows: { feature: Feature; distance: number }[]) {
    const list = layer.list!;
    const ul = el('ul', 'mt-3 space-y-2.5');
    const shown = rows.slice(0, list.initialCount);
    const rest = rows.slice(list.initialCount);
    for (const row of shown) ul.append(listRow(layer, row));

    const out = [ul];
    if (rest.length) {
      const button = el(
        'button',
        'mt-3 text-xs font-medium text-accent underline underline-offset-2',
        fill(S.showMore, { count: rest.length }),
      );
      button.setAttribute('type', 'button');
      button.addEventListener('click', () => {
        for (const row of rest) ul.append(listRow(layer, row));
        button.remove();
      });
      out.push(button);
    }
    return out;
  }

  /**
   * Count of records inside each radius, plus the distance to the closest —
   * or, where the layer declared `list`, every one of those records
   * enumerated nearest first instead of left as a bare number.
   */
  function radiusBody(layer: NearMeLayer, features: Feature[], point: [number, number]) {
    const withDistance = features
      .filter((f) => f.geometry.type === 'Point')
      .map((f) => ({
        feature: f,
        distance: haversineMeters(point, (f.geometry as GeoJSON.Point).coordinates as [number, number]),
      }))
      .sort((a, b) => a.distance - b.distance);
    if (!withDistance.length) return null;

    const radii = layer.radii.length ? layer.radii : [1];
    const within = (mi: number) => withDistance.filter((r) => miles(r.distance) <= mi);
    const headline = within(radii[0]);

    const out = [
      el('p', 'text-2xl font-semibold text-ink-100', String(headline.length)),
      el('p', 'text-xs text-ink-400', fill(S.mappedWithin, { miles: radii[0] })),
    ];

    if (layer.list) {
      out.push(...recordList(layer, headline));
      return out;
    }

    const rest = radii
      .slice(1)
      .map((mi) => fill(S.alsoWithin, { count: within(mi).length, miles: mi }));
    rest.push(fill(S.nearestIs, { distance: fmtMiles(withDistance[0].distance) }));
    out.push(el('p', 'mt-2 text-sm text-ink-300', `${rest.join('. ')}.`));
    return out;
  }

  /** The single closest record and how far away it is. */
  function nearestBody(layer: NearMeLayer, features: Feature[], point: [number, number]) {
    const best = nearest(point, features);
    if (!best) return null;
    const out = [
      el('p', 'text-sm text-ink-100', best.feature.properties.name),
      el(
        'p',
        'mt-0.5 text-xs text-ink-400',
        fill(S.distanceAway, { distance: fmtMiles(best.distance) }),
      ),
      ...detailLines(layer, best.feature, 'mt-0.5 text-xs text-ink-400'),
    ];
    const url = layer.linkKey ? best.feature.properties.attributes?.[layer.linkKey] : null;
    if (url) {
      const a = el(
        'a',
        'mt-2 inline-block text-xs text-accent underline underline-offset-2',
        `${layer.linkLabel} →`,
      );
      a.setAttribute('href', String(url));
      a.setAttribute('target', '_blank');
      a.setAttribute('rel', 'noopener noreferrer');
      out.push(a);
    }
    return out;
  }

  /** The polygon this point falls inside, if any. */
  function containsBody(layer: NearMeLayer, features: Feature[], point: [number, number]) {
    const hit = findContaining(point, features as any[]);
    if (!hit) return null;
    return [
      el('p', 'text-sm font-medium text-ink-100', hit.properties.name),
      ...detailLines(layer, hit, 'mt-1 text-xs leading-relaxed text-ink-300'),
    ];
  }

  /** Records filed against the county this point falls in. */
  function countyBody(layer: NearMeLayer, features: Feature[], countyName: string | null) {
    if (!countyName) return null;
    const matches = features.filter((f) => f.properties.county === countyName);
    if (!matches.length) return null;
    const out = [
      el('p', 'text-sm text-ink-200', fill(S.foundInCounty, { count: matches.length })),
    ];
    const ul = el('ul', 'mt-2 space-y-1.5');
    for (const m of matches) {
      const li = el('li', 'text-sm');
      li.append(el('span', 'block text-ink-100', m.properties.name));
      for (const line of detailLines(layer, m, 'block text-xs text-ink-400')) li.append(line);
      ul.append(li);
    }
    out.push(ul);
    return out;
  }

  function renderCard(layer: NearMeLayer, point: [number, number], countyName: string | null) {
    const features = layerData.get(layer.id) ?? [];
    const wrap = card(layer.title, layer.color);

    let body: HTMLElement[] | null = null;
    if (layer.mode === 'radius') body = radiusBody(layer, features, point);
    else if (layer.mode === 'nearest') body = nearestBody(layer, features, point);
    else if (layer.mode === 'contains') body = containsBody(layer, features, point);
    else if (layer.mode === 'countyMatch') body = countyBody(layer, features, countyName);

    if (body) wrap.append(...body);
    else wrap.append(el('p', 'text-sm leading-relaxed text-ink-300', layer.empty));

    // The caveat shows on empty cards too. "No camera near here" is exactly
    // the answer a reader is most likely to over-trust, so the warning that
    // absence is not evidence has to travel with it.
    if (layer.caveat) {
      wrap.append(el('p', 'mt-2 text-xs leading-relaxed text-warn', layer.caveat));
    }
    if (layer.wide) wrap.className += ' sm:col-span-2';
    return wrap;
  }

  /* -------------------------- Who answers here ------------------------- */

  const KIND_LABEL: Record<string, string> = {
    city: 'jurisdictionCity',
    township: 'jurisdictionTownship',
    unorganized: 'jurisdictionUnorganized',
    county: 'jurisdictionCounty',
  };

  /**
   * The offices that have to answer for this ground, and — where the data
   * supports saying it — the fact that the cameras here belong to none of
   * them.
   */
  function renderWhoAnswers(
    point: [number, number],
    jurisdiction: Jurisdiction | null,
    countyName: string | null,
  ) {
    whoEl.textContent = '';
    if (!jurisdiction && !countyName) {
      whoEl.append(
        el(
          'p',
          'rounded-lg border border-ink-800 bg-ink-900 p-4 text-sm text-ink-300',
          S.whoAnswersEmpty,
        ),
      );
      return;
    }

    const wrap = el('div', 'rounded-lg border border-accent/30 bg-ink-900 p-5');
    wrap.append(el('h3', 'text-base font-semibold text-ink-100', S.whoAnswersTitle));

    if (jurisdiction) {
      const line = el('p', 'mt-1 text-sm text-ink-200');
      line.append(
        el('span', 'text-ink-400', `${S.youAreIn} `),
        el('span', 'font-medium text-ink-100', displayName(jurisdiction.name)),
        el(
          'span',
          'text-ink-400',
          ` — ${S[KIND_LABEL[jurisdiction.kind]]} ${fill(S.inCounty, { county: jurisdiction.county })}`,
        ),
      );
      wrap.append(line);
    }

    wrap.append(el('p', 'mt-2 text-sm leading-relaxed text-ink-300', S.whoAnswersIntro));

    // The 82 subdivisions with no government of their own. Said out loud, so
    // a missing local row reads as a fact about the place rather than a gap
    // in our data.
    if (jurisdiction && !jurisdiction.governed) {
      wrap.append(
        el(
          'p',
          'mt-3 rounded-md border border-warn/30 bg-warn/5 p-3 text-xs leading-relaxed text-warn',
          S.noLocalGovernment,
        ),
      );
    }

    // Who actually runs the cameras here, against who the reader elects.
    // Reads the alpr layer's own registry radius rather than a second literal,
    // so this gap check and the camera card above it cannot drift apart again
    // the way they had — one said "3 mi", the other already checked 5.
    const cameras = layerData.get('alpr') ?? [];
    const gapRadius = layers.find((l) => l.id === 'alpr')?.radii[0] ?? 5;
    const nearby = cameras.filter(
      (f) =>
        f.geometry.type === 'Point' &&
        miles(haversineMeters(point, (f.geometry as GeoJSON.Point).coordinates as [number, number])) <=
          gapRadius,
    );
    if (nearby.length) {
      const gap = operatorGap(
        nearby.map((f) => f.properties.attributes?.operator ?? null),
        jurisdiction,
      );
      if (gap.outside.length && jurisdiction) {
        wrap.append(
          el(
            'p',
            'mt-3 rounded-md border border-accent/30 bg-accent/5 p-3 text-xs leading-relaxed text-ink-200',
            fill(S.operatorMismatch, {
              operators: gap.outside.join(', '),
              jurisdiction: displayName(jurisdiction.name),
            }),
          ),
        );
      }
      if (gap.unattributed) {
        wrap.append(
          el(
            'p',
            'mt-2 text-xs leading-relaxed text-ink-400',
            fill(S.operatorUnattributed, { count: gap.unattributed }),
          ),
        );
      }
    }

    const list = el('ol', 'mt-4 space-y-3');
    for (const authority of resolveAuthorities(jurisdiction, countyName)) {
      const item = el('li', 'border-l-2 border-ink-800 pl-3');
      item.append(el('p', 'text-sm font-medium text-ink-100', authority.entity));
      item.append(
        el('p', 'text-sm text-ink-200', S[`office${capitalise(authority.office.id)}`]),
      );
      item.append(
        el(
          'p',
          'mt-0.5 text-xs leading-relaxed text-ink-400',
          S[`office${capitalise(authority.office.id)}Role`],
        ),
      );

      const cite = `Minn. Stat. § ${authority.office.cite}${
        authority.office.subdivision ? `, ${authority.office.subdivision}` : ''
      }`;
      const a = el('a', 'mt-1 inline-block text-xs text-accent underline underline-offset-2',
        fill(S.underStatute, { cite }));
      a.setAttribute('href', authority.office.url);
      a.setAttribute('target', '_blank');
      a.setAttribute('rel', 'noopener noreferrer');
      item.append(a);

      list.append(item);
    }
    wrap.append(list);

    // The whole point of the card: a way out of it into a letter, with the
    // body already chosen.
    const act = el(
      'a',
      'mt-4 inline-block rounded-md bg-accent px-4 py-2 text-sm font-medium text-on-accent hover:brightness-110',
      `${S.writeToThisOffice} →`,
    );
    act.setAttribute(
      'href',
      jurisdiction ? `${ACT_PATH}?jurisdiction=${encodeURIComponent(jurisdiction.geoid)}` : ACT_PATH,
    );
    wrap.append(act);

    whoEl.append(wrap);
  }

  const capitalise = (s: string) => s.charAt(0).toUpperCase() + s.slice(1);

  /** Guards against an older lookup finishing after a newer one. */
  let latest = 0;

  async function analyse(
    point: [number, number],
    placeName: string | null,
    jurisdiction: Jurisdiction | null = null,
    accuracyMeters: number | null = null,
  ) {
    const token = ++latest;
    statusEl.textContent = S.loading;
    await ready;
    if (token !== latest) return;

    accuracyEl.hidden = true;
    if (accuracyMeters != null && miles(accuracyMeters) >= LOW_ACCURACY_MILES) {
      accuracyEl.textContent = fill(S.lowAccuracy, { accuracy: fmtMiles(accuracyMeters) });
      accuracyEl.hidden = false;
    }

    // A location a search box can't produce — only "use my location" can —
    // and one this box structurally cannot reach out of state, so this is
    // the one place worth spending a coverage check before anything else.
    if (!jurisdiction && !inMinnesota(point)) {
      statusEl.textContent = '';
      heading.textContent = placeName
        ? fill(S.aroundPlace, { place: placeName })
        : S.aroundYourLocation;
      sub.textContent = S.outsideMinnesotaTitle;
      whoEl.textContent = '';
      whoEl.append(
        el(
          'p',
          'rounded-lg border border-ink-800 bg-ink-900 p-4 text-sm leading-relaxed text-ink-300',
          S.outsideMinnesota,
        ),
      );
      cards.textContent = '';
      section.hidden = false;
      section.scrollIntoView({
        behavior: REDUCED_MOTION ? 'auto' : 'smooth',
        block: 'nearest',
      });
      return;
    }

    // A jurisdiction picked by name is already known. Only raw coordinates
    // need the boundaries, and only then do we pay for them.
    if (!jurisdiction) {
      const shapes = await loadJurisdictionShapes();
      if (token !== latest) return;
      const hit = findContaining(point, shapes.features as any[]);
      jurisdiction = (hit?.properties as Jurisdiction) ?? null;
    }
    statusEl.textContent = '';

    const county = counties ? findContaining(point, counties.features) : null;
    const countyName = jurisdiction?.county ?? county?.properties?.name ?? null;

    heading.textContent = placeName
      ? fill(S.aroundPlace, { place: placeName })
      : S.aroundYourLocation;
    sub.textContent = countyName ? `${countyName}, ${S.stateName}` : S.stateName;

    renderWhoAnswers(point, jurisdiction, countyName);

    cards.textContent = '';
    for (const layer of layers) cards.append(renderCard(layer, point, countyName));

    section.hidden = false;
    section.scrollIntoView({
      behavior: REDUCED_MOTION ? 'auto' : 'smooth',
      block: 'nearest',
    });
  }
</script>
