---
import type { Locale } from '~/layers/types';
import { loadAllLayers } from '~/layers/data';
import { useTranslations, localePath } from '~/lib/i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useTranslations(locale);

const loaded = await loadAllLayers();

// Agencies that have actually signed something, plus every county, so the
// generator can address a real body rather than a blank.
const agencyLayer = loaded.find((l) => l.definition.id === 'agency_287g')?.collection;
const agencies = [
  ...new Set((agencyLayer?.features ?? []).map((f) => f.properties.name)),
].sort();

const counties = [
  ...new Set(
    loaded
      .flatMap((l) => l.collection?.features ?? [])
      .map((f) => f.properties.county)
      .filter((c): c is string => Boolean(c)),
  ),
].sort();

const facilities = (
  loaded.find((l) => l.definition.id === 'detention_facility')?.collection?.features ?? []
).map((f) => f.properties.name);

// The locator's own strings. Everything else on this page is English prose in
// the markup; these go through the dictionary because the same card is drawn
// on the "near me" page, and one office must not be named two different ways.
const locatorStrings = {
  noResults: t('noResults'),
  whoAnswersTitle: t('whoAnswersTitle'),
  whoAnswersIntro: t('whoAnswersIntro'),
  youAreIn: t('youAreIn'),
  inCounty: t('inCounty'),
  noLocalGovernment: t('noLocalGovernment'),
  useThisBody: t('useThisBody'),
  addressedTo: t('addressedTo'),
  underStatute: t('underStatute'),
  jurisdictionCity: t('jurisdictionCity'),
  jurisdictionTownship: t('jurisdictionTownship'),
  jurisdictionUnorganized: t('jurisdictionUnorganized'),
  jurisdictionCounty: t('jurisdictionCounty'),
  officeTownClerk: t('officeTownClerk'),
  officeTownClerkRole: t('officeTownClerkRole'),
  officeCityClerk: t('officeCityClerk'),
  officeCityClerkRole: t('officeCityClerkRole'),
  officeCountyAdministrator: t('officeCountyAdministrator'),
  officeCountyAdministratorRole: t('officeCountyAdministratorRole'),
  officeLawEnforcement: t('officeLawEnforcement'),
  officeLawEnforcementRole: t('officeLawEnforcementRole'),
  officeCommissioner: t('officeCommissioner'),
  officeCommissionerRole: t('officeCommissionerRole'),
};
---

<script is:inline type="application/json" id="locator-strings" set:html={JSON.stringify(locatorStrings)} />

<div class="mx-auto max-w-4xl px-4 py-10">
  <h1 class="text-2xl font-semibold tracking-tight text-ink-100 sm:text-3xl">{t('navAct')}</h1>
  <p class="prose-civic mt-3">
    Everything on this map came from a record somebody requested or published. These tools help you
    request the next one. They are informational, not legal advice.
  </p>

  <!--
    ------------------------- Where you live -------------------------
    Placed before the letter generator because it answers the question that
    blocks it. The generator has always been able to address any body — but
    only to a reader who already knew which body to name. Somebody looking at a
    camera down their road does not, and "Which body?" as an empty text box is
    where they stopped.
  -->
  <section class="mt-8 rounded-lg border border-accent/30 bg-ink-900 p-5">
    <h2 class="text-lg font-semibold text-ink-100">{t('locateTitle')}</h2>
    <p class="mt-1.5 text-sm leading-relaxed text-ink-300">{t('locateIntro')}</p>

    <div class="mt-4 max-w-md">
      <label for="jurisdiction-search" class="mb-1.5 block text-sm font-medium text-ink-200">
        {t('locateLabel')}
      </label>
      <div class="relative">
        <input
          id="jurisdiction-search"
          type="search"
          autocomplete="off"
          role="combobox"
          aria-expanded="false"
          aria-controls="jurisdiction-results"
          placeholder={t('locatePlaceholder')}
          class="w-full rounded-md border border-ink-700 bg-ink-850 px-3 py-2.5 text-sm text-ink-100 placeholder:text-ink-400 focus:border-accent focus:outline-none"
        />
        <ul
          id="jurisdiction-results"
          role="listbox"
          class="absolute z-20 mt-1 hidden max-h-64 w-full overflow-y-auto rounded-md border border-ink-700 bg-ink-850 shadow-xl"
        >
        </ul>
      </div>
      <p class="mt-1.5 text-xs leading-relaxed text-ink-400">{t('locateHint')}</p>
    </div>

    <div id="jurisdiction-authorities" class="mt-5"></div>
  </section>

  <!-- ------------------------- Records request ------------------------- -->
  <section class="mt-8 rounded-lg border border-ink-800 bg-ink-900 p-5">
    <h2 class="text-lg font-semibold text-ink-100">Public records request generator</h2>
    <p class="mt-1.5 text-sm leading-relaxed text-ink-300">
      Minnesota's public records law is the
      <a
        href="https://www.revisor.mn.gov/statutes/cite/13"
        target="_blank"
        rel="noopener noreferrer"
        class="text-accent underline underline-offset-2">Government Data Practices Act, Minn. Stat. ch. 13</a
      >. Under it, government data is public unless a statute says otherwise, and you do not have to
      explain why you want it. Pick a request below, fill in the blanks, and send it.
    </p>

    <div class="mt-5 grid gap-4 sm:grid-cols-2">
      <div>
        <label for="req-type" class="mb-1.5 block text-sm font-medium text-ink-200">
          What are you requesting?
        </label>
        <select
          id="req-type"
          class="w-full rounded-md border border-ink-700 bg-ink-850 px-3 py-2 text-sm text-ink-100 focus:border-accent focus:outline-none"
        >
          <optgroup label="Surveillance technology">
            <option value="alpr">ALPR data retention and sharing audit</option>
            <option value="inventory">Surveillance technology inventory</option>
            <option value="drone">Drone / DFR programme records</option>
          </optgroup>
          <optgroup label="Immigration enforcement">
            <option value="287g">287(g) agreement records and activity</option>
            <option value="detention">ICE detention contract and billing records</option>
            <option value="dvs">Driver and vehicle record disclosure agreements</option>
          </optgroup>
          <optgroup label="Money and infrastructure">
            <option value="procurement">Purchase orders and vendor payment history</option>
            <option value="permits">Permits for fixed surveillance installations</option>
            <option value="datacenter">Data center permits, utilities and tax abatements</option>
          </optgroup>
        </select>
      </div>

      <div>
        <label for="req-agency" class="mb-1.5 block text-sm font-medium text-ink-200">
          Which body?
        </label>
        <input
          id="req-agency"
          list="agency-list"
          placeholder="e.g. Hennepin County Sheriff's Office"
          class="w-full rounded-md border border-ink-700 bg-ink-850 px-3 py-2 text-sm text-ink-100 placeholder:text-ink-400 focus:border-accent focus:outline-none"
        />
        <datalist id="agency-list">
          {agencies.map((a) => <option value={a} />)}
          {counties.map((c) => <option value={`${c} Sheriff's Office`} />)}
          {facilities.map((f) => <option value={f} />)}
        </datalist>
        <p id="route-hint" class="mt-1.5 text-xs leading-relaxed text-ink-400"></p>
      </div>

      <div>
        <label for="req-name" class="mb-1.5 block text-sm font-medium text-ink-200">
          Your name
        </label>
        <input
          id="req-name"
          placeholder="Optional — you may request anonymously"
          class="w-full rounded-md border border-ink-700 bg-ink-850 px-3 py-2 text-sm text-ink-100 placeholder:text-ink-400 focus:border-accent focus:outline-none"
        />
      </div>

      <div>
        <label for="req-contact" class="mb-1.5 block text-sm font-medium text-ink-200">
          Reply address
        </label>
        <input
          id="req-contact"
          placeholder="Email or postal address"
          class="w-full rounded-md border border-ink-700 bg-ink-850 px-3 py-2 text-sm text-ink-100 placeholder:text-ink-400 focus:border-accent focus:outline-none"
        />
      </div>
    </div>

    <p class="mt-3 text-xs leading-relaxed text-ink-400">
      Nothing you type here leaves your browser. The letter is assembled on your device; this site
      has no server to receive it.
    </p>

    <div class="mt-4 flex flex-wrap gap-2">
      <button
        id="copy-letter"
        type="button"
        class="rounded-md bg-accent px-4 py-2 text-sm font-medium text-ink-950 hover:brightness-110"
      >
        Copy letter
      </button>
      <button
        id="download-letter"
        type="button"
        class="rounded-md border border-ink-700 px-4 py-2 text-sm font-medium text-ink-100 hover:border-accent"
      >
        Download as .txt
      </button>
      <span id="copy-status" role="status" aria-live="polite" class="self-center text-sm text-accent"
      ></span>
    </div>

    <label for="letter" class="mt-4 mb-1.5 block text-sm font-medium text-ink-200">
      Your request
    </label>
    <textarea
      id="letter"
      rows="18"
      class="scroll-slim w-full rounded-md border border-ink-700 bg-ink-950 p-3 font-mono text-xs leading-relaxed text-ink-100 focus:border-accent focus:outline-none"
    ></textarea>
  </section>

  <!-- ------------------------- Researcher tactics ------------------------- -->
  <section class="mt-8">
    <h2 class="text-lg font-semibold text-ink-100">What works, according to people who file a lot</h2>
    <p class="mt-1.5 text-sm leading-relaxed text-ink-300">
      The templates above already build in most of what follows. This section explains why they are
      written the way they are, so you can adapt them. It comes from an independent researcher who
      has spent four years filing these requests — more than three hundred of them — and it is a
      summary of their practice, not a rule of law.
    </p>

    <div class="prose-civic mt-4">
      <h3 class="text-base font-semibold text-ink-100">Ask the office that pays the bill</h3>
      <p>
        A request sent to a police department's public information officer competes with press
        calls and lands with the people most practised at narrowing it. The same purchase appears
        in the procurement, purchasing, finance, or accounts payable records of whoever actually
        buys the equipment — a county board, a city finance office, a joint powers authority — and
        those offices process records requests as routine paperwork. Purchase orders, requisitions,
        and a vendor payment history for a fiscal year will show you what was bought, when, with
        whose money, and often what has been deployed without any public announcement.
      </p>

      <h3 class="text-base font-semibold text-ink-100">Be specific enough to be inconvenient</h3>
      <p>
        Broad requests get delayed, estimated at an implausible fee, or refused as burdensome. Narrow
        ones are harder to wave away. The useful vocabulary is the vendor's own: a system's
        documentation will name its "user access logs", "network audit logs", or audit report
        exports, and asking for a record by the name its own software gives it removes the argument
        that no such record exists. Published audit logs from other jurisdictions are a good place
        to learn those names — the
        <a href="https://haveibeenflocked.com" target="_blank" rel="noopener noreferrer">
          Have I Been Flocked
        </a> project archives Flock audit logs released to other requesters. (It also offers a
        personal plate lookup; this project does not do that, and does not hold data about anybody's
        vehicle.)
      </p>

      <h3 class="text-base font-semibold text-ink-100">Carve out the active investigation</h3>
      <p>
        The most common refusal is that data are part of an active criminal investigation, which
        Minn. Stat. § 13.82, subd. 7 does protect. Policies, contracts, inventories, audit logs, and
        aggregate counts are not investigative data, so say so in the request and exclude that
        category explicitly. It costs you nothing you wanted and takes away the easiest denial. Two
        further provisions are worth quoting when you meet resistance:
      </p>
      <ul>
        <li>
          <strong class="text-ink-100">§ 13.82, subd. 31</strong> makes public "the existence of all
          technology maintained by a law enforcement agency that may be used to electronically
          capture an audio, video, photographic, or other record of the activities of the general
          public." An agency may argue about the data a system collects; whether it owns the system
          is public.
        </li>
        <li>
          <strong class="text-ink-100">§ 13.05, subd. 11</strong> keeps data subject to the Act when
          a private contractor performs a government function. "The vendor has it" and "the vendor
          calls it proprietary" are not exemptions.
        </li>
      </ul>

      <h3 class="text-base font-semibold text-ink-100">Follow the physical installation</h3>
      <p>
        A camera on a pole is construction. Permanent installations generally leave a trail of
        right-of-way, building, or electrical permits, and pole attachment agreements, held by a
        building or public works department that has no stake in the surveillance question. This
        works best as a cross-check: if procurement shows forty cameras bought and permits show
        twelve, the gap is the next question.
      </p>
      <p>
        One caveat specific to Minnesota. Excavation notices go through
        <a href="https://gopherstateonecall.org/" target="_blank" rel="noopener noreferrer">
          Gopher State One Call
        </a>, which is a private non-profit rather than a government entity, so it is not itself
        subject to ch. 13. Request locate and excavation records from the city or county in its role
        as a facility operator, where they are government data.
      </p>

      <h3 class="text-base font-semibold text-ink-100">Check what is already published</h3>
      <p>
        Some of this does not need a request at all. Every Minnesota law enforcement agency
        operating a drone must report its warrantless deployments and total programme cost to the
        Commissioner of Public Safety each January under Minn. Stat. § 626.19, subd. 12, and the
        compiled statewide result is published by June —
        <a
          href="https://dps.mn.gov/divisions/bca/data-and-reports/uav-uav-annual-reports"
          target="_blank"
          rel="noopener noreferrer"
        >
          UAV annual reports, Minnesota BCA
        </a>. Read that first, then request the agency's own submission, which is more granular than
        the compilation.
      </p>

      <h3 class="text-base font-semibold text-ink-100">Watch the commercial pipeline</h3>
      <p>
        Records can leave a public agency by agreement rather than by breach. State driver and
        vehicle record systems disclose data to commercial brokers and to federal systems under
        standing agreements; in Minnesota those disclosures run through Driver and Vehicle Services
        under Minn. Stat. § 171.12, subd. 7 and the federal Driver's Privacy Protection Act, and
        subd. 7b requires a requester to certify the data will not be used for immigration
        enforcement. The agreements, and the record of how that certification is checked, are the
        thing to ask for — not anybody's driver record.
      </p>

      <h3 class="text-base font-semibold text-ink-100">Do not do this alone</h3>
      <p>
        Local journalists can escalate a refusal in a way an individual requester cannot. University
        geography and data science departments will often take on the mapping and analysis as
        coursework. Historical and civic groups hold the context that makes a current map mean
        something — surveillance infrastructure laid over historically redlined neighbourhoods is a
        different argument than a dot map of cameras. This site ships redlining and racial covenant
        layers for exactly that comparison — turn them on alongside the camera layer on the
        <a href={localePath(locale, '/')}>map</a>, and see the
        <a href={localePath(locale, '/explainer')}>explainer</a> for what the redlining grades mean
        and what they do not.
      </p>
    </div>
  </section>

  <!-- ------------------- When it is not your government ------------------- -->
  <section class="mt-8">
    <h2 class="text-lg font-semibold text-ink-100">
      When the cameras belong to a government you did not elect
    </h2>
    <div class="prose-civic mt-2">
      <p>
        This is the ordinary case outside a city with its own police force, and it is the thing
        that most often stalls a local effort. A township has a board, an agenda, and an election
        behind it — and the readers inside its borders were bought by a county sheriff, mounted on
        a county road, on a county contract. Every lever the board can reach is real; none of them
        is the one attached to that camera.
      </p>
      <p>
        Two questions decide what instrument you actually need, and it is worth settling them
        before drafting anything:
      </p>
      <ul>
        <li>
          <strong class="text-ink-100">Whose equipment is it?</strong> The camera layer records an
          operator where somebody mapped one, and leaves it null where nobody did — look your
          location up under <a href={localePath(locale, '/near-me')}>what is around this place</a>,
          which now names the operators of the cameras near a point and flags the ones that are not
          your own government. Where the operator is blank, that gap is itself the first records
          request: § 13.82, subd. 31 makes the <em>existence</em> of the technology public.
        </li>
        <li>
          <strong class="text-ink-100">How far do your town's powers reach?</strong> Minnesota
          towns hold the powers that
          <a href="https://www.revisor.mn.gov/statutes/cite/365" target="_blank" rel="noopener noreferrer">
            ch. 365
          </a> and
          <a href="https://www.revisor.mn.gov/statutes/cite/366.01" target="_blank" rel="noopener noreferrer">
            § 366.01
          </a> give them, and the broader ordinance powers under
          <a href="https://www.revisor.mn.gov/statutes/cite/368.01" target="_blank" rel="noopener noreferrer">
            § 368.01
          </a> are available only to towns meeting a population or proximity threshold. Whether a
          given town's authority extends to equipment another government owns is a question for
          your town attorney and the
          <a href="https://www.mntownships.org/information-library/township-powers" target="_blank" rel="noopener noreferrer">
            Minnesota Association of Townships
          </a>, not one this site can answer for you. Ask it first: the answer decides whether you
          are drafting a town ordinance or asking the county board for a resolution.
        </li>
      </ul>
      <p>
        Whatever the answer, three things are open to a local board immediately and none of them
        depends on owning the equipment. It can file the records request itself — a government
        entity asking another government entity tends to get a faster and more complete answer than
        a resident does. It can put the item on a published agenda, which creates a public record
        and a date. And it can ask the county for the audit that
        <a href="https://www.revisor.mn.gov/statutes/cite/13.824" target="_blank" rel="noopener noreferrer">
          § 13.824, subd. 6
        </a> already requires every ALPR operator to commission every two years, along with the
        public log under subd. 5 and the audit trail under subd. 7. Those documents exist whether or
        not anyone has ever asked for them, and reading them is usually what turns a general worry
        into a specific one.
      </p>
    </div>
  </section>

  <!-- --------------------------- Who to contact --------------------------- -->
  <section class="mt-8">
    <h2 class="text-lg font-semibold text-ink-100">Finding the right official</h2>
    <div class="prose-civic mt-2">
      <p>
        Most of what is on this map is decided locally — by a county board that approves a jail
        contract, a city council that grants a data-center abatement, or a sheriff who signs an
        agreement. These are the offices that can undo those decisions.
      </p>
      <ul>
        <li>
          <a href="https://www.sos.mn.gov/elections-voting/whos-my-legislator/" target="_blank" rel="noopener noreferrer">
            Who represents me — Minnesota Secretary of State
          </a> — your state legislators and districts.
        </li>
        <li>
          <a href="https://www.lmc.org/resources/directory-of-minnesota-city-officials/" target="_blank" rel="noopener noreferrer">
            Directory of Minnesota city officials
          </a> — League of Minnesota Cities.
        </li>
        <li>
          <a href="https://www.mncounties.org/counties/" target="_blank" rel="noopener noreferrer">
            Minnesota county directory
          </a> — county boards and sheriffs, who hold most of the authority on this map.
        </li>
        <li>
          <a href="https://www.ipad.state.mn.us/" target="_blank" rel="noopener noreferrer">
            Information Policy Analysis Division (IPAD)
          </a> — the state office that issues advisory opinions when an agency refuses a data
          request. Free, and their opinions carry weight.
        </li>
      </ul>
    </div>
  </section>

  <!-- ----------------------------- Escalation ----------------------------- -->
  <section class="mt-8">
    <h2 class="text-lg font-semibold text-ink-100">If your request is refused or ignored</h2>
    <div class="prose-civic mt-2">
      <ul>
        <li>
          <strong class="text-ink-100">Ask for the statute.</strong> An agency withholding data has
          to identify the specific provision that classifies it as not public. "It's law
          enforcement data" is not a citation.
        </li>
        <li>
          <strong class="text-ink-100">Ask for a fee estimate in writing</strong> before any work
          begins. Inspection of public data is free under Minnesota law; you only pay for copies.
        </li>
        <li>
          <strong class="text-ink-100">Request an IPAD advisory opinion.</strong> It costs nothing
          and often resolves a refusal without litigation.
        </li>
        <li>
          <strong class="text-ink-100">Narrow, then re-ask.</strong> A request refused as unduly
          burdensome will frequently succeed when scoped to one system, one quarter, or one
          contract.
        </li>
      </ul>
    </div>
  </section>

  <section class="mt-8">
    <h2 class="text-lg font-semibold text-ink-100">Contribute to the map</h2>
    <div class="prose-civic mt-2">
      <p>
        Found a camera that is not here, or a community campaign we have missed? The camera layer
        is built on OpenStreetMap, so adding one there improves this map and every other project
        built on the same data. See <a href={localePath(locale, '/contribute')}>how to contribute</a>.
      </p>
    </div>
  </section>

  <p class="mt-10 rounded-lg border border-ink-800 p-4 text-sm leading-relaxed text-ink-400">
    These templates are informational and are not legal advice. They describe a general process
    under Minnesota law and may not fit your situation. If you are facing enforcement action, talk
    to a lawyer.
  </p>
</div>

<script>
  const typeEl = document.getElementById('req-type') as HTMLSelectElement;
  const agencyEl = document.getElementById('req-agency') as HTMLInputElement;
  const nameEl = document.getElementById('req-name') as HTMLInputElement;
  const contactEl = document.getElementById('req-contact') as HTMLInputElement;
  const letterEl = document.getElementById('letter') as HTMLTextAreaElement;
  const statusEl = document.getElementById('copy-status')!;
  const routeHintEl = document.getElementById('route-hint')!;

  const CITE = 'Minnesota Government Data Practices Act, Minn. Stat. ch. 13';

  interface RequestBody {
    title: string;
    items: string[];
    note?: string;
    /** Where this request actually gets answered — shown under the agency field. */
    sendTo?: string;
    /** Carve out § 13.82 subd. 7 so an open case cannot swallow the whole request. */
    excludeActive?: boolean;
    /** Data a vendor holds on the agency's behalf is still government data (§ 13.05 subd. 11). */
    vendorHeld?: boolean;
  }

  const BODIES: Record<string, RequestBody> = {
    alpr: {
      title: 'automated licence plate reader (ALPR) data practices',
      items: [
        'The current retention schedule for ALPR data, including how long plate reads not linked to an active investigation are retained.',
        'Any policy, general order, or standard operating procedure governing use of ALPR systems, including authorised query reasons.',
        'The total number of ALPR queries run by your agency in the most recent complete twelve-month period.',
        'A list of agencies and third parties with which your agency shares ALPR data, and any agreements governing that sharing.',
        'Any audit logs or audit reports of ALPR queries, including query reason codes, for the most recent complete twelve-month period. This includes the records the vendor’s own documentation calls "user access logs" and "network audit logs".',
        'The current list of user accounts with query access to the system, by agency and role. I am requesting the count and the agency affiliation of those accounts, not the identity of any individual user.',
        'Contracts, purchase orders, and invoices for ALPR hardware, software, or services, including any agreement with Flock Safety or a comparable vendor.',
        'Records of any query run by, or on behalf of, a federal immigration authority against your agency’s ALPR data.',
      ],
      note: 'Minnesota has a specific ALPR statute at Minn. Stat. § 13.824, which sets retention limits and requires a biennial audit. If your agency operates ALPR systems, please also provide the most recent audit conducted under that section.',
      sendTo:
        'The responsible authority, but send a parallel request for the contracts and invoices to the county or city finance office — they answer faster and hold the same purchase records.',
      excludeActive: true,
      vendorHeld: true,
    },

    inventory: {
      title: 'the inventory of surveillance technology maintained by the agency',
      items: [
        'A list of every technology your agency maintains that may be used to electronically capture an audio, video, photographic, or other record of the activities of the general public, whether or not it is currently deployed.',
        'For each system on that list: the vendor and product name, the year it was acquired, the number of units, and whether it is currently in service.',
        'Any policy, general order, or standard operating procedure governing each system, and the date each was last revised.',
        'Any user access log, network audit log, or system audit report generated by each system in the most recent complete twelve-month period.',
        'Any memorandum of understanding, data-sharing agreement, or interagency agreement under which another agency, a federal authority, or a private party may access each system or its data.',
        'Any privacy impact assessment, civil liberties review, staff report, or public hearing record considered before each system was acquired.',
      ],
      note: 'Minn. Stat. § 13.82, subd. 31 classifies as public "the existence of all technology maintained by a law enforcement agency that may be used to electronically capture an audio, video, photographic, or other record of the activities of the general public." The first item above requests exactly that existence data, and it is public whether or not the technology is in active use.',
      sendTo: 'The law enforcement agency’s responsible authority or data practices compliance official.',
      excludeActive: true,
      vendorHeld: true,
    },

    drone: {
      title: 'the agency’s unmanned aerial vehicle (UAV) programme',
      items: [
        'The report your agency submitted to the commissioner of public safety under Minn. Stat. § 626.19, subd. 12 for each of the last three calendar years, as submitted.',
        'The written policy your agency adopted under Minn. Stat. § 626.19, subd. 10 governing UAV use, and the record of its publication.',
        'Any concept of operations, staff report, grant application, or vendor proposal relating to a "drone as first responder" or automated-launch programme, including planned or existing launch sites.',
        'Any record of integration between UAV dispatch and computer-aided dispatch, a real-time crime centre, or a fixed camera or ALPR system.',
        'Any Federal Aviation Administration certificate of waiver or authorization, Part 107 waiver, or beyond visual line of sight (BVLOS) authorization held by the agency, together with the application submitted for it.',
        'Aggregate counts of UAV deployments by call type or dispatch category for the most recent complete twelve-month period. Counts only — I am not requesting records about any individual or any specific incident.',
        'Contracts, purchase orders, and invoices for UAV hardware, software, docking stations, or services.',
        'Any agreement permitting a vendor or another agency to receive a live UAV video feed.',
      ],
      note: 'The report requested in item 1 is required annually, so it should exist without any research on your part. The Department of Public Safety publishes a compiled statewide version; this request seeks your agency’s own submission, which is more detailed.',
      sendTo: 'The agency itself — but check the published statewide compilation first (linked below); the answer may already be public.',
      excludeActive: true,
      vendorHeld: true,
    },

    dvs: {
      title: 'agreements governing bulk disclosure of driver and vehicle records',
      items: [
        'A list of every entity holding a current bulk, batch, or automated access agreement to driver’s licence or motor vehicle record data, and the permissible use under United States Code, title 18, section 2721 asserted by each.',
        'The executed agreement, contract, or memorandum of understanding for each entity on that list.',
        'Any agreement providing access to, or receiving data from, a federal or military information system, including the FBI’s National Data Exchange (N-DEx).',
        'The certification required of requesters under Minn. Stat. § 171.12, subd. 7b that data will not be used for immigration enforcement, and any record describing how compliance with that certification is verified or audited.',
        'Aggregate counts of records disclosed to each entity in the most recent complete twelve-month period. Totals only.',
        'Any audit, review, or investigation of misuse of driver and vehicle record data completed in the past three years, in summary or aggregate form.',
      ],
      note: 'To be explicit: this request seeks the agreements and the volume of disclosure under them. It does not seek any driver record, any motor vehicle record, or any data about an identifiable person — those data are protected by Minn. Stat. § 171.12, subd. 7 and United States Code, title 18, section 2721, and I am not asking you to release them.',
      sendTo:
        'Minnesota Department of Public Safety, Driver and Vehicle Services — a state agency, not your county.',
    },

    procurement: {
      title: 'purchase orders and vendor payment history for law enforcement technology',
      items: [
        'All purchase orders, requisitions, and requisition approvals issued in the two most recent complete fiscal years for goods or services from any vendor of automated licence plate readers, unmanned aerial vehicles, real-time crime centre software, mobile device forensics, or data-broker search services. This includes, without limiting the request, Flock Safety, Axon Enterprise, Motorola Solutions, SoundThinking, Cellebrite, Magnet Forensics, Skydio, BRINC, Verkada, LexisNexis, and Thomson Reuters.',
        'The check register, accounts payable ledger, or vendor payment history covering the same period for each vendor identified, showing payment date, amount, and the fund or account charged.',
        'Any sole-source justification, cooperative purchasing agreement, or state or national contract number relied on to purchase from those vendors without competitive bidding.',
        'Any grant application, award letter, or grant agreement under which such a purchase was funded in whole or in part, including any federal pass-through funding.',
        'Any current quote, proposal, statement of work, or renewal or auto-renewal notice from those vendors, including line-item pricing.',
        'Records sufficient to identify the department or cost centre that requested each purchase.',
      ],
      note: 'These are financial records of the entity. I am directing the request to the finance, purchasing, or accounts payable function rather than to a law enforcement agency for that reason. If another division holds responsive records, I ask that you forward this request rather than closing it.',
      sendTo:
        'Procurement, purchasing, finance, or accounts payable — not the police department’s public information officer. Whoever cuts the cheque holds the record, and that office has no reason to slow-walk it.',
    },

    permits: {
      title: 'permits and right-of-way records for fixed surveillance installations',
      items: [
        'All right-of-way, encroachment, pole attachment, or small cell permits issued in the past three years for installation of a camera, licence plate reader, or associated equipment on public property or in the public right of way.',
        'All building and electrical permits issued in the same period for installation of a pole-mounted camera or licence plate reader, including the applicant, the site address, and any inspection record.',
        'Any master licence, pole attachment agreement, or right-of-way use agreement between this entity and a surveillance vendor or a law enforcement agency.',
        'Any excavation or utility locate records this entity holds in its capacity as a facility operator under Minn. Stat. ch. 216D that relate to those installations.',
        'Any public works or traffic engineering work order for the installation, relocation, or removal of such equipment.',
        'Records of any permit fee waived, reduced, or charged to a vendor or agency for such an installation.',
      ],
      note: 'Permit and right-of-way records are ordinarily held by a building, engineering, or public works department rather than by a law enforcement agency, and they are public regardless of what was installed.',
      sendTo:
        'The building, engineering, or public works department. Anything bolted to a pole or set in the ground left a paper trail with them.',
    },
    '287g': {
      title: 'agreements with U.S. Immigration and Customs Enforcement under section 287(g)',
      items: [
        'The complete executed memorandum of agreement with ICE, including all appendices and any addenda or amendments.',
        'Records showing the number of officers designated under the agreement and their training completion dates.',
        'Any policy or directive governing how officers exercise delegated immigration authority.',
        'Aggregate counts of actions taken under the agreement in the most recent complete twelve-month period. Please provide counts only — I am not requesting records about any individual.',
        'All communications between your agency and ICE regarding the negotiation, renewal, modification, or termination of the agreement.',
        'Any cost, reimbursement, or budget records associated with participation in the programme.',
      ],
      note: 'To be explicit: this request seeks records about the agreement and its administration. It does not seek any record identifying a person encountered, detained, or arrested.',
      sendTo:
        'The sheriff’s office is the signatory, but the cost, reimbursement, and training-travel records also sit with the county finance office.',
      excludeActive: true,
    },
    detention: {
      title: 'agreements to detain individuals on behalf of U.S. Immigration and Customs Enforcement',
      items: [
        'The current intergovernmental service agreement or contract with ICE, including all amendments and the per-diem rate schedule.',
        'Aggregate monthly billing records or invoices submitted to ICE for the most recent complete twelve-month period, showing totals only.',
        'The facility’s average daily population held under ICE contract, by month, for the most recent complete twelve-month period.',
        'Any inspection reports, corrective action plans, or compliance findings relating to ICE-contracted detention at the facility.',
        'Any policy governing detainee access to legal counsel, telephones, and visitation.',
        'Minutes or records of any public body vote authorising or renewing the agreement.',
      ],
      note: 'This request seeks facility-level and contract-level records only. It does not seek any record identifying, describing, or relating to any individual held at the facility.',
      sendTo:
        'The county administrator or finance office holds the billing; the board’s own minutes record the vote that authorised it.',
    },
    datacenter: {
      title: 'permitting, utility, and public-subsidy records for data center development',
      items: [
        'All land use, zoning, conditional use, and building permit applications and approvals for data center projects in the past five years.',
        'Any development agreement, tax abatement, tax increment financing, or sales tax exemption granted to a data center operator.',
        'Projected and actual electricity demand for each facility, and any interconnection or capacity agreement with the utility.',
        'Projected and actual water consumption for cooling, and any water supply agreement.',
        'Any noise study, environmental assessment, or traffic study submitted in support of an application.',
        'Records of public comment received regarding a data center project, and minutes of any hearing at which one was considered.',
      ],
      sendTo:
        'The city or county planning and zoning department. The abatement and financing records are with the finance office or the economic development authority.',
    },
  };

  function buildLetter(): string {
    const key = typeEl.value;
    const body = BODIES[key];
    const agency = agencyEl.value.trim() || '[agency name]';
    const requester = nameEl.value.trim();
    const contact = contactEl.value.trim() || '[your email or postal address]';
    const today = new Date().toLocaleDateString('en-US', {
      year: 'numeric',
      month: 'long',
      day: 'numeric',
    });

    const lines = [
      today,
      '',
      `Responsible Authority / Data Practices Compliance Official`,
      agency,
      '',
      `Re: Data practices request — ${body.title}`,
      '',
      'To the Responsible Authority:',
      '',
      `Under the ${CITE}, I request access to and copies of the following government data held by ${agency}:`,
      '',
      ...body.items.map((item, i) => `${i + 1}. ${item}`),
      '',
    ];

    if (body.note) lines.push(body.note, '');

    if (body.excludeActive) {
      lines.push(
        'This request expressly excludes any data that are confidential or protected nonpublic under Minn. Stat. § 13.82, subd. 7 because they are part of an active criminal investigation. What I have asked for above — policies, contracts, inventories, audit logs, and aggregate counts — is not investigative data. Please do not withhold an entire record on the ground that some part of it touches an investigation; redact that part and release the remainder.',
        '',
      );
    }

    if (body.vendorHeld) {
      lines.push(
        'If any responsive data are held by a private vendor performing this function under contract, those data remain subject to this chapter under Minn. Stat. § 13.05, subd. 11, and I request that you obtain and produce them. That a vendor stores the data on its own systems, or considers them proprietary, does not remove them from the Act.',
        '',
      );
    }

    lines.push(
      'Please provide these data in electronic form where they already exist in that form, as this is generally the least costly method for both of us.',
      '',
      'If you determine that any portion of these data is not public, please identify the specific statutory provision that classifies it as such, and release the remaining portions rather than withholding a record in full.',
      '',
      'If your office is not the responsible authority for these data, I ask that you forward this request to the office that is and tell me where it went, rather than closing it.',
      '',
      'If you anticipate that responding will involve a charge for copies, please provide a written estimate before beginning work. I understand that inspection of public government data is provided at no charge.',
      '',
      'Minnesota law requires that you respond to this request in an appropriate and prompt manner. If you need clarification or wish to discuss narrowing the scope, please contact me and I will work with you.',
      '',
      'Thank you for your time.',
      '',
      'Sincerely,',
      requester || '[your name]',
      contact,
    );

    return lines.join('\n');
  }

  function refresh() {
    letterEl.value = buildLetter();
    routeHintEl.textContent = BODIES[typeEl.value]?.sendTo ?? '';
  }

  [typeEl, agencyEl, nameEl, contactEl].forEach((input) =>
    input.addEventListener('input', refresh),
  );
  typeEl.addEventListener('change', refresh);

  function flash(message: string) {
    statusEl.textContent = message;
    window.setTimeout(() => (statusEl.textContent = ''), 2500);
  }

  document.getElementById('copy-letter')?.addEventListener('click', async () => {
    try {
      await navigator.clipboard.writeText(letterEl.value);
      flash('Copied.');
    } catch {
      letterEl.select();
      flash('Press Ctrl/Cmd+C to copy.');
    }
  });

  document.getElementById('download-letter')?.addEventListener('click', () => {
    const blob = new Blob([letterEl.value], { type: 'text/plain;charset=utf-8' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = `records-request-${typeEl.value}.txt`;
    a.click();
    URL.revokeObjectURL(url);
  });

  refresh();
</script>

<!--
  The locator, kept as its own module rather than folded into the letter
  script above. The two communicate the way any two scripts on a page should:
  this one writes the agency field and fires an `input` event, and the letter
  rebuilds itself from that exactly as it does when a reader types. Nothing
  here reaches into the letter's internals.
-->
<script>
  import { resolveAuthorities, displayName } from '~/lib/authority.mjs';

  type Jurisdiction = {
    geoid: string;
    name: string;
    kind: 'city' | 'township' | 'unorganized';
    governed: boolean;
    county: string;
    countyFips: string;
    lat: number;
    lng: number;
  };

  const S = JSON.parse(
    document.getElementById('locator-strings')!.textContent!,
  ) as Record<string, string>;

  const searchEl = document.getElementById('jurisdiction-search') as HTMLInputElement;
  const resultsEl = document.getElementById('jurisdiction-results')!;
  const panelEl = document.getElementById('jurisdiction-authorities')!;
  const agencyEl = document.getElementById('req-agency') as HTMLInputElement;

  const KIND_LABEL: Record<string, string> = {
    city: 'jurisdictionCity',
    township: 'jurisdictionTownship',
    unorganized: 'jurisdictionUnorganized',
  };

  const fill = (template: string, values: Record<string, string | number>) =>
    template.replace(/\{(\w+)\}/g, (_, key) => String(values[key] ?? ''));

  function el(tag: string, cls?: string, text?: string) {
    const n = document.createElement(tag);
    if (cls) n.className = cls;
    if (text != null) n.textContent = text;
    return n;
  }

  const capitalise = (s: string) => s.charAt(0).toUpperCase() + s.slice(1);

  let jurisdictions: Jurisdiction[] = [];

  const ready = fetch('/data/reference/mn-jurisdictions.json')
    .then((r) => r.json())
    .then((doc) => {
      jurisdictions = doc.jurisdictions ?? [];
    })
    .catch(() => {
      jurisdictions = [];
    });

  /* ----------------------------- Search ----------------------------- */

  function renderResults(query: string) {
    const q = query.trim().toLowerCase();
    resultsEl.textContent = '';
    if (q.length < 2) {
      resultsEl.classList.add('hidden');
      searchEl.setAttribute('aria-expanded', 'false');
      return;
    }

    const hits = jurisdictions
      .filter((j) => j.name.toLowerCase().includes(q))
      .sort((a, b) => {
        const as = a.name.toLowerCase().startsWith(q) ? 0 : 1;
        const bs = b.name.toLowerCase().startsWith(q) ? 0 : 1;
        return as - bs || a.name.localeCompare(b.name);
      })
      .slice(0, 25);

    if (!hits.length) {
      resultsEl.append(el('li', 'px-3 py-2 text-xs text-ink-400', S.noResults));
    } else {
      for (const j of hits) {
        const li = el('li');
        li.setAttribute('role', 'option');
        const button = el(
          'button',
          'flex w-full items-baseline justify-between gap-3 px-3 py-2 text-left text-sm text-ink-200 hover:bg-ink-800 hover:text-ink-100',
        );
        button.setAttribute('type', 'button');
        button.append(el('span', '', displayName(j.name)));
        // Minnesota reuses township names freely; the county disambiguates.
        button.append(el('span', 'shrink-0 text-xs text-ink-400', j.county));
        button.addEventListener('click', () => select(j));
        li.append(button);
        resultsEl.append(li);
      }
    }
    resultsEl.classList.remove('hidden');
    searchEl.setAttribute('aria-expanded', 'true');
  }

  let timer: number;
  searchEl.addEventListener('input', () => {
    window.clearTimeout(timer);
    timer = window.setTimeout(() => renderResults(searchEl.value), 120);
  });
  searchEl.addEventListener('blur', () =>
    window.setTimeout(() => resultsEl.classList.add('hidden'), 180),
  );

  /* --------------------------- The chain --------------------------- */

  function select(j: Jurisdiction) {
    searchEl.value = displayName(j.name);
    resultsEl.classList.add('hidden');
    render(j);
    // Keep the deep link honest: a reader who copies the URL out of the bar
    // after choosing their township should get this page back.
    const url = new URL(window.location.href);
    url.searchParams.set('jurisdiction', j.geoid);
    window.history.replaceState({}, '', url);
  }

  function render(j: Jurisdiction) {
    panelEl.textContent = '';

    const wrap = el('div', 'rounded-lg border border-ink-800 bg-ink-950 p-4');
    wrap.append(el('h3', 'text-sm font-semibold text-ink-100', S.whoAnswersTitle));

    const line = el('p', 'mt-1 text-sm');
    line.append(
      el('span', 'text-ink-400', `${S.youAreIn} `),
      el('span', 'font-medium text-ink-100', displayName(j.name)),
      el(
        'span',
        'text-ink-400',
        ` — ${S[KIND_LABEL[j.kind]]} ${fill(S.inCounty, { county: j.county })}`,
      ),
    );
    wrap.append(line);

    if (!j.governed) {
      wrap.append(
        el(
          'p',
          'mt-3 rounded-md border border-warn/30 bg-warn/5 p-3 text-xs leading-relaxed text-warn',
          S.noLocalGovernment,
        ),
      );
    }

    const status = el('p', 'mt-3 text-sm text-accent');
    status.setAttribute('role', 'status');
    status.setAttribute('aria-live', 'polite');

    const list = el('ol', 'mt-3 space-y-3');
    for (const authority of resolveAuthorities(j, j.county)) {
      const item = el('li', 'border-l-2 border-ink-800 pl-3');
      item.append(el('p', 'text-sm font-medium text-ink-100', authority.entity));
      item.append(
        el('p', 'text-sm text-ink-200', S[`office${capitalise(authority.office.id)}`]),
      );
      item.append(
        el(
          'p',
          'mt-0.5 text-xs leading-relaxed text-ink-400',
          S[`office${capitalise(authority.office.id)}Role`],
        ),
      );

      const cite = `Minn. Stat. § ${authority.office.cite}${
        authority.office.subdivision ? `, ${authority.office.subdivision}` : ''
      }`;
      const a = el(
        'a',
        'mt-1 inline-block text-xs text-accent underline underline-offset-2',
        fill(S.underStatute, { cite }),
      );
      a.setAttribute('href', authority.office.url);
      a.setAttribute('target', '_blank');
      a.setAttribute('rel', 'noopener noreferrer');
      item.append(a);

      // The commissioner is where a refusal goes, not where a request starts,
      // so it gets no "address the letter here" button.
      if (authority.level !== 'state') {
        const use = el(
          'button',
          'mt-2 block rounded-md border border-ink-700 px-3 py-1.5 text-xs font-medium text-ink-100 hover:border-accent hover:text-accent',
          S.useThisBody,
        );
        use.setAttribute('type', 'button');
        use.addEventListener('click', () => {
          agencyEl.value = authority.entity;
          // The letter script rebuilds on `input`, exactly as if typed.
          agencyEl.dispatchEvent(new Event('input', { bubbles: true }));
          status.textContent = fill(S.addressedTo, { entity: authority.entity });
          agencyEl.scrollIntoView({
            behavior: window.matchMedia('(prefers-reduced-motion: reduce)').matches
              ? 'auto'
              : 'smooth',
            block: 'center',
          });
        });
        item.append(use);
      }

      list.append(item);
    }

    wrap.append(list, status);
    panelEl.append(wrap);
  }

  /*
    Arriving from somewhere else on the site with the work already started.

    Two doors lead here. The "who answers to you here" card on the near-me page
    sends `jurisdiction`; the take-action button in the map's detail panel
    sends `type` and `body` — the request template for that kind of record and
    the body to address — plus `at`, the record's position.

    Without this the reader would arrive at a blank form having just been told
    exactly what to ask and who to ask, and would have to enter all of it a
    second time. That is where people give up.
  */
  const params = new URL(window.location.href).searchParams;

  // The template and the addressee need no data, so they apply immediately.
  const type = params.get('type');
  if (type) {
    const select = document.getElementById('req-type') as HTMLSelectElement;
    if ([...select.options].some((o) => o.value === type)) {
      select.value = type;
      select.dispatchEvent(new Event('change', { bubbles: true }));
    }
  }
  const body = params.get('body');
  if (body) {
    agencyEl.value = body;
    agencyEl.dispatchEvent(new Event('input', { bubbles: true }));
  }

  ready.then(async () => {
    const geoid = params.get('jurisdiction');
    if (geoid) {
      const match = jurisdictions.find((j) => j.geoid === geoid);
      if (match) {
        searchEl.value = displayName(match.name);
        render(match);
      }
      return;
    }

    /*
      A record's coordinates, from the map. Resolving them to a jurisdiction
      costs 1.6 MB of boundaries — which is why the map itself passes the point
      rather than resolving it there. A reader who has clicked "take action"
      has committed to this page, and this is the one place the download buys
      something: the offices for the exact ground that camera stands on.
    */
    const at = params.get('at');
    if (!at) return;
    const [lng, lat] = at.split(',').map(Number);
    if (!Number.isFinite(lng) || !Number.isFinite(lat)) return;

    const { findContaining } = await import('~/lib/geo.mjs');
    const shapes = await fetch('/data/reference/mn-jurisdictions.geojson')
      .then((r) => (r.ok ? r.json() : { features: [] }))
      .catch(() => ({ features: [] }));
    const hit = findContaining([lng, lat], shapes.features);
    if (!hit) return;
    const match = jurisdictions.find((j) => j.geoid === hit.properties.geoid);
    if (!match) return;
    searchEl.value = displayName(match.name);
    render(match);
  });
</script>
