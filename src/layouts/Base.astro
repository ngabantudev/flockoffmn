---
import '~/styles/global.css';
import Nav from '~/components/Nav.astro';
import Footer from '~/components/Footer.astro';
import { localeFromUrl, useTranslations } from '~/lib/i18n';

interface Props {
  title: string;
  description?: string;
  /** The map page manages its own scrolling and fills the viewport. */
  fullBleed?: boolean;
}

const { title, description, fullBleed = false } = Astro.props;
const locale = localeFromUrl(Astro.url);
const t = useTranslations(locale);

const pageTitle = title === t('siteName') ? title : `${title} · ${t('siteName')}`;
const pageDescription = description ?? t('tagline');
---

<!doctype html>
<html lang={locale} class={fullBleed ? 'h-full overflow-hidden' : ''}>
  <head>
    <meta charset="utf-8" />
    <!--
      Anti-FOUC: sets the stored theme (if any) on <html> before first paint.
      Must run synchronously, as early as possible, and as an external file —
      the CSP's `script-src 'self'` with no `'unsafe-inline'` means an inline
      <script> block here would never execute. `is:inline` is required too:
      without it Astro defers/bundles this as a module, which reintroduces
      the flash this exists to prevent.
    -->
    <script is:inline src="/theme-init.js"></script>
    {/*
      viewport-fit=cover is what makes env(safe-area-inset-bottom) resolve to
      a real number instead of 0 — needed below `lg` now that primary nav is
      a bar fixed to the true bottom of the screen, past the iPhone home
      indicator, on every page rather than just the map.
    */}
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!--
      No analytics, no tag manager, no third-party fonts, no ad tech.
      Spec §8: we do not become the thing we map. Referrer is suppressed so
      that following a source link does not announce which record was read.
    -->
    <meta name="referrer" content="no-referrer" />
    <meta name="robots" content="index, follow" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:type" content="website" />
  </head>

  <body class={fullBleed ? 'h-full overflow-hidden' : ''}>
    <a href="#main" class="skip-link">{t('skipToContent')}</a>

    {/*
      Below `lg`, primary nav is a bar docked to the bottom of the screen
      (see Nav.astro) rather than the scrolling row at top. On a page that
      scrolls, that bar is `fixed` and stays put regardless of scroll
      position, so nothing else knows it's there — this padding is what
      keeps the last thing on the page, footer included, from ending up
      underneath it. The map page needs none of this: its own page doesn't
      scroll, and Nav reorders into the same flex column that page already
      manages instead (see Nav's own comment).
    */}
    <div
      class={fullBleed
        ? 'flex h-full flex-col'
        : 'flex min-h-dvh flex-col pb-[calc(3.5rem+env(safe-area-inset-bottom))] lg:pb-0'}
    >
      <Nav locale={locale} fullBleed={fullBleed} />
      <main id="main" class={fullBleed ? 'relative min-h-0 flex-1' : 'flex-1'} tabindex="-1">
        <slot />
      </main>
      {!fullBleed && <Footer locale={locale} />}
    </div>
  </body>
</html>
