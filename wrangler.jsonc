{
  "$schema": "./node_modules/wrangler/config-schema.json",

  // Cloudflare Pages project config.
  //
  // `pages_build_output_dir` is what marks this as a Pages project rather than
  // a Worker — there is deliberately no `main` entrypoint, because the site is
  // pure static output with no server-side code. If a `main` key ever appears
  // here, something has gone wrong: this project's Pages project has no
  // backend of its own by design (see docs/DEPLOYMENT.md). That warning stays
  // scoped to THIS file — `workers/flight-sightings-cron/wrangler.jsonc` is a
  // separate, standalone Worker deployable with its own `main`, deployed
  // independently of this Pages project specifically because it needs a Cron
  // Trigger, which Pages Functions cannot have.
  //
  // The narrow exceptions here are `functions/api/` routes: ice-flights.js
  // and trace/[hex].js — Cloudflare Pages Functions (not a Worker `main`, and
  // need none of the config below to run). They exist only because adsb.lol
  // sends no CORS headers, so something server-side has to relay its
  // response; they hold no state, no binding, and nothing written anywhere.
  // See "Live flight proxy" in docs/DEPLOYMENT.md for the full rationale and
  // what they deliberately do not do. `functions/api/flight-log/*` is the
  // second exception — read-only D1 access, see the binding comment below.
  //
  // Deployment is via Pages' Git integration, so Cloudflare runs the build
  // itself. That is chosen over a deploy workflow specifically because it
  // builds a preview URL for every pull request — for a project asking for
  // community contributions, a reviewer clicking a working link beats asking a
  // first-time contributor to set up Node locally.
  //
  // Build settings to set in the dashboard (or accept from framework detection):
  //   Build command:        npm run build
  //   Build output dir:     dist
  //   Node version:         22  (see "engines" in package.json)

  // The Cloudflare Pages project, which is the Minnesota deployment of FlockOff
  // and carries the state in its name. The project is FlockOff; this is where
  // this instance of it is served from, and the two are not the same string.
  "name": "flockoffmn",
  "pages_build_output_dir": "./dist",
  "compatibility_date": "2026-07-30",

  // One binding, narrowly scoped: FLIGHT_SIGHTINGS_DB, a Cloudflare D1
  // database. It is read-only in application code — it backs only
  // functions/api/flight-log/[hex].js and functions/api/flight-log/index.js,
  // both SELECT-only, never INSERT/UPDATE. It holds aircraft-level facts
  // (hex, callsign, ground-arrival/departure timestamps — see
  // migrations/0001_flight_sightings.sql) and nothing about a visitor: no
  // query is logged, no IP or request identifier is stored anywhere.
  //
  // The write path lives entirely in the separate, standalone
  // workers/flight-sightings-cron/ deployable (its own wrangler.jsonc, its
  // own D1 binding, its own Cron Trigger) — NOT in this Pages project. See
  // that Worker's index.mjs header and docs/DEPLOYMENT.md's "Flight
  // sighting log (the second exception)" section for the full rationale.
  //
  // Still no KV, no R2, no queues, no secrets here. Adding another binding
  // means adding another place data could accumulate; do not do it without
  // revisiting the privacy claims on /about and this file's own reasoning.
  "d1_databases": [
    {
      "binding": "FLIGHT_SIGHTINGS_DB",
      "database_name": "flockoffmn-flight-sightings",
      "database_id": "90f43a8b-be4e-437c-ae31-097f1fc88a2b"
    }
  ],

  // Base map tiles. The default in code points at OpenStreetMap's standard
  // tile servers, which is fine for development but NOT for production —
  // they are volunteer-funded and their usage policy asks apps not to lean
  // on them at scale.
  //
  // This file is the source of truth for this Pages project (Cloudflare
  // disables the dashboard's plain-text "Environment variables" editor once
  // a wrangler config exists — it only leaves Secrets manageable there), and
  // PUBLIC_TILE_URL is read via `import.meta.env` at Vite BUILD time, not at
  // Pages Functions runtime. That combination rules out Pages secrets
  // entirely for this value: a secret (dashboard or `wrangler pages secret
  // put`) is invisible to Cloudflare's own Git-integration build, so the
  // build silently re-inlines the tile.openstreetmap.org fallback — this
  // shipped to production twice already before that was understood. It has
  // to be a real committed `vars` value instead, scoped per environment
  // below since `vars`/bindings are non-inheritable in Wrangler config.
  //
  // The MapTiler key ending up in git is a knowing tradeoff, not an
  // oversight: it's already fully exposed in the public JS bundle to every
  // visitor (view-source finds it in seconds), so keeping it out of git
  // bought no real secrecy — only slightly less convenient scraping. The
  // actual control is restricting the key to this project's origins
  // (flockoffmn.org, *.flockoffmn.pages.dev) in the MapTiler dashboard, so a
  // copied key can't be reused elsewhere against the metered free tier.
  //
  // NOTE: if you change the tile host, update the CSP in public/_headers to
  // match, or the map will silently fail to load tiles.
  "vars": {},
  "env": {
    // Same tile config as production: preview deploys are served from
    // *.flockoffmn.pages.dev, which is already in the key's allowed-origins
    // list above, so there's no separate exposure from reusing it here.
    // Without this, every PR preview inherits the OSM-fallback 403s too —
    // see docs/DEPLOYMENT.md § Base map tiles.
    "preview": {
      "vars": {
        "PUBLIC_TILE_URL": "https://api.maptiler.com/maps/basic-v2/256/{z}/{x}/{y}.png?key=At16tqLmre80ovPJ0iNL",
        "PUBLIC_TILE_ATTRIBUTION": "© <a href=\"https://www.maptiler.com/copyright/\">MapTiler</a> © <a href=\"https://www.openstreetmap.org/copyright\">OpenStreetMap</a> contributors"
      }
    },
    "production": {
      // d1_databases is non-inheritable too, so it must be repeated here —
      // see the top-level binding's comment above for what it's for.
      "d1_databases": [
        {
          "binding": "FLIGHT_SIGHTINGS_DB",
          "database_name": "flockoffmn-flight-sightings",
          "database_id": "90f43a8b-be4e-437c-ae31-097f1fc88a2b"
        }
      ],
      "vars": {
        "PUBLIC_TILE_URL": "https://api.maptiler.com/maps/basic-v2/256/{z}/{x}/{y}.png?key=At16tqLmre80ovPJ0iNL",
        "PUBLIC_TILE_ATTRIBUTION": "© <a href=\"https://www.maptiler.com/copyright/\">MapTiler</a> © <a href=\"https://www.openstreetmap.org/copyright\">OpenStreetMap</a> contributors"
      }
    }
  }
}
