{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"compatibility_date": "2026-07-20",
	"compatibility_flags": ["global_fetch_strictly_public"],
	"name": "get-flocked",
	"main": "./src/worker.ts",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS"
	},
	"observability": {
		"enabled": true
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "get-flocked-misuse-reports",
			"database_id": "e840bbc3-f948-46df-a766-e754e0a8cb58",
			"migrations_dir": "./migrations"
		}
	],
	"triggers": {
		"crons": ["0 */6 * * *"]
	}
}