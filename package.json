{
  "name": "flockoff",
  "type": "module",
  "version": "0.1.0",
  "description": "A free, open-source map making systems of surveillance, enforcement, and historical public policy visible — starting in Minnesota.",
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "check": "astro check",
    "data": "node --env-file-if-exists=.env scripts/ingest/build-all.mjs",
    "data:counties": "node scripts/ingest/counties.mjs",
    "data:jurisdictions": "node scripts/ingest/jurisdictions.mjs",
    "data:alpr": "node scripts/ingest/alpr.mjs",
    "data:287g": "node scripts/ingest/agencies-287g.mjs",
    "data:agencies-lpr-bca": "node scripts/ingest/agencies-lpr-bca.mjs",
    "data:agency-jurisdictions": "node scripts/ingest/agency-jurisdictions.mjs",
    "data:agency-buildings": "node scripts/ingest/agency-buildings.mjs",
    "data:alpr-reported": "node scripts/ingest/alpr-reported.mjs",
    "data:detention": "node scripts/ingest/detention.mjs",
    "data:datacenters": "node scripts/ingest/data-centers.mjs",
    "data:redlining": "node scripts/ingest/redlining.mjs",
    "data:holc-detail": "node scripts/ingest/holc-detail.mjs",
    "data:holc-tracts": "node scripts/ingest/holc-tracts.mjs",
    "pages:dev": "wrangler pages dev dist",
    "pages:preview": "npm run build && wrangler pages deploy dist --project-name=flockoffmn --branch=preview",
    "pages:publish": "npm run build && wrangler pages deploy dist --project-name=flockoffmn --branch=main",
    "data:covenants": "node scripts/ingest/covenants.mjs",
    "data:ej": "node scripts/ingest/ej-cumulative.mjs",
    "data:demographics": "node --env-file-if-exists=.env scripts/ingest/demographics.mjs",
    "tiles:build": "node scripts/tiles/build-basemap.mjs",
    "tiles:publish": "node scripts/tiles/build-basemap.mjs --upload",
    "tiles:styles": "node scripts/tiles/mirror-basemap-styles.mjs"
  },
  "dependencies": {
    "astro": "^7.1.6",
    "lucide": "^1.28.0",
    "maplibre-gl": "^5.24.0",
    "pmtiles": "^4.5.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@tailwindcss/vite": "^4.3.3",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^26.1.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "wrangler": "^4.116.0"
  }
}
