{
  "name": "get-flocked",
  "type": "module",
  "version": "0.1.0",
  "description": "A free, open-source map making systems of surveillance, enforcement, and historical public policy visible — starting in Minnesota.",
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "check": "astro check",
    "data": "node scripts/ingest/build-all.mjs",
    "data:counties": "node scripts/ingest/counties.mjs",
    "data:alpr": "node scripts/ingest/alpr.mjs",
    "data:287g": "node scripts/ingest/agencies-287g.mjs",
    "data:detention": "node scripts/ingest/detention.mjs",
    "data:datacenters": "node scripts/ingest/data-centers.mjs",
    "data:redlining": "node scripts/ingest/redlining.mjs",
    "pages:dev": "wrangler pages dev dist",
    "pages:deploy": "npm run build && wrangler pages deploy dist --project-name=get-flocked"
  },
  "dependencies": {
    "astro": "^7.1.2",
    "maplibre-gl": "^5.24.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@tailwindcss/vite": "^4.3.3",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^26.1.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "wrangler": "^4.116.0"
  }
}
