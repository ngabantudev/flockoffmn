{
  "name": "flockoff",
  "type": "module",
  "version": "0.1.0",
  "description": "A free, open-source map making systems of surveillance, enforcement, and historical public policy visible — starting in Minnesota.",
  "license": "AGPL-3.0-or-later",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "check": "astro check",
    "data": "node --env-file-if-exists=.env scripts/ingest/build-all.mjs",
    "data:counties": "node scripts/ingest/national/counties.mjs",
    "data:jurisdictions": "node scripts/ingest/national/jurisdictions.mjs",
    "data:alpr": "node scripts/ingest/national/alpr.mjs",
    "data:287g": "node scripts/ingest/national/agencies-287g.mjs",
    "data:agencies-lpr-bca": "node scripts/ingest/mn/agencies-lpr-bca.mjs",
    "data:agency-jurisdictions": "node scripts/ingest/mn/agency-jurisdictions.mjs",
    "data:agency-buildings": "node scripts/ingest/mn/agency-buildings.mjs",
    "data:alpr-reported": "node scripts/ingest/mn/alpr-reported.mjs",
    "data:alpr-cross-source": "node scripts/ingest/mn/alpr-cross-source.mjs",
    "data:detention": "node scripts/ingest/national/detention.mjs",
    "data:datacenters": "node scripts/ingest/national/data-centers.mjs",
    "data:redlining": "node scripts/ingest/national/redlining.mjs",
    "data:holc-detail": "node scripts/ingest/mn/holc-detail.mjs",
    "data:holc-tracts": "node scripts/ingest/national/holc-tracts.mjs",
    "pages:dev": "wrangler pages dev dist",
    "pages:preview": "npm run build && wrangler pages deploy dist --project-name=flockoffmn --branch=preview",
    "pages:publish": "npm run build && wrangler pages deploy dist --project-name=flockoffmn --branch=main",
    "data:covenants": "node scripts/ingest/mn/covenants.mjs",
    "data:ej": "node scripts/ingest/mn/ej-cumulative.mjs",
    "data:demographics": "node --env-file-if-exists=.env scripts/ingest/national/demographics.mjs",
    "data:vendor-contracts": "node scripts/ingest/mn/vendor-contracts.mjs",
    "data:aadt": "node scripts/ingest/mn/aadt.mjs",
    "data:crime-minneapolis": "node scripts/ingest/mn/crime-minneapolis.mjs",
    "data:news": "node scripts/ingest/mn/news.mjs",
    "tiles:build": "node scripts/tiles/build-basemap.mjs",
    "tiles:publish": "node scripts/tiles/build-basemap.mjs --upload",
    "tiles:styles": "node scripts/tiles/mirror-basemap-styles.mjs",
    "test": "node tests/run.mjs",
    "test:install": "playwright install chromium"
  },
  "dependencies": {
    "astro": "^7.1.6",
    "lucide": "^1.28.0",
    "lucide-astro": "^0.556.0",
    "maplibre-gl": "^5.24.0",
    "pmtiles": "^4.5.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@tailwindcss/vite": "^4.3.3",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^26.1.2",
    "playwright": "^1.62.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "wrangler": "^4.116.0"
  }
}
